// Scoped typecheck for the design-system rollout (module registry, chips,
// PageHeader + QuickActions, StatTile, and the landings built on them).
//
// `next build` ignores type errors (next.config.ts), and a full-project tsc
// runs out of memory on small machines and still fails on older errors. This
// config checks only the files the rollout touched, plus everything they
// import. Run it with:
//   NODE_OPTIONS=--max-old-space-size=4096 ./node_modules/.bin/tsc -p tsconfig.ui-check.json
// CI (.github/workflows/e2e.yml) runs the same command.
//
// src/types/next-auth.d.ts is listed first: without it every
// `session.user.role` is an error. When a later change touches another
// shared UI file, add it to "files".
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "noEmit": true
  },
  "include": [],
  "files": [
    "src/types/next-auth.d.ts",
    "src/app/(dashboard)/bd/contracts/[contractId]/_components/contract-detail.tsx",
    "src/app/(dashboard)/bd/dashboard/page.tsx",
    "src/app/(dashboard)/bd/deals/loading.tsx",
    "src/app/(dashboard)/bd/leads/[leadId]/_components/lead-detail.tsx",
    "src/app/(dashboard)/bd/leads/loading.tsx",
    "src/app/(dashboard)/bd/properties/loading.tsx",
    "src/app/(dashboard)/beo/[id]/_components/beo-detail.tsx",
    "src/app/(dashboard)/beo/_components/beo-dashboard.tsx",
    "src/app/(dashboard)/beo/_components/new-function-sheet-dialog.tsx",
    "src/app/(dashboard)/beo/page.tsx",
    "src/app/(dashboard)/bookings/loading.tsx",
    "src/app/(dashboard)/bookings/page.tsx",
    "src/app/(dashboard)/contacts/_components/contacts-more-menu.tsx",
