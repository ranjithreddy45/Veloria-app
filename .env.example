# ============================================================
# Database
# ============================================================
DATABASE_URL="postgresql://user:password@localhost:5432/veloria?schema=public"

# ============================================================
# NextAuth
# ============================================================
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ============================================================
# Google OAuth
# ============================================================
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Google Drive "upload from Drive" (BD CRM photos/documents). Both are PUBLIC
# (browser) values: a browser API key with the Google Picker API enabled, and an
# OAuth web client ID whose Authorized JavaScript origins include the app URL.
# Enable "Google Picker API" + "Google Drive API" in the same Google Cloud project.
NEXT_PUBLIC_GOOGLE_API_KEY=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
# Optional: the Google Cloud project NUMBER (tightens the picker to this app).
NEXT_PUBLIC_GOOGLE_APP_ID=""

# ============================================================
# Email (Resend)
# ============================================================
RESEND_API_KEY=""
EMAIL_FROM="Veloria Grand <noreply@yourdomain.com>"
EMAIL_DOMAIN="yourdomain.com"

# ============================================================
# Razorpay Payments
# ============================================================
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ============================================================
# OpenAI (AI Features)
# ============================================================
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ============================================================
# WhatsApp Business
# ============================================================
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN="veloria_whatsapp_verify"

# ============================================================
# Cron Jobs
# ============================================================
CRON_SECRET="generate-a-secure-random-string"

# ============================================================
# App Configuration
# ============================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Veloria Grand"
# Reverse proxies in front of the app that APPEND to X-Forwarded-For. The client
# IP used for rate limits, IP hashes, e-sign audit and office-network check-in
# is taken this many entries from the RIGHT of that header; entries further
# left are whatever the client sent (src/lib/hr/geo.ts). Empty or invalid = 1.
#   1: Apache directly in front of the app, as in production.
#   2: another proxy that appends to X-Forwarded-For (e.g. Cloudflare) in front of Apache.
TRUSTED_PROXY_COUNT="1"

# ============================================================
# Company Details (shown on invoices, quotes, emails)
# ============================================================
NEXT_PUBLIC_COMPANY_ADDRESS="123 Celebration Avenue, Event City, Karnataka 560001"
NEXT_PUBLIC_COMPANY_GSTIN=""
NEXT_PUBLIC_COMPANY_PHONE="+91 80 1234 5678"
NEXT_PUBLIC_COMPANY_EMAIL="info@veloriagrand.com"

# ============================================================
# Web Push (VAPID) — browser / device notifications
# Generate the pair ONCE with:  npx tsx scripts/generate-vapid-keys.ts
# Rotating the pair invalidates every existing device subscription.
# All three must be set or push is silently disabled (one server warn).
# ============================================================
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact for push services: "mailto:you@yourdomain.com" or an https:// URL.
VAPID_SUBJECT="mailto:info@veloriagrand.com"

# ============================================================
# Error monitoring (Sentry) — optional. Leave the DSN empty to disable it
# entirely: no SDK init, no build plugin, no network calls, no bundle change.
# On the VPS the DSN must ALSO be a Docker build arg for the browser bundle
# (NEXT_PUBLIC_* values are inlined at build time); the server side reads it
# from .env.production at runtime.
# ============================================================
NEXT_PUBLIC_SENTRY_DSN=""
# Release tag on events — first of SENTRY_RELEASE, GIT_COMMIT_SHA,
# VERCEL_GIT_COMMIT_SHA wins. The browser bundle uses the NEXT_PUBLIC_ variant.
SENTRY_RELEASE=""
NEXT_PUBLIC_SENTRY_RELEASE=""
# Defaults to NODE_ENV. Override to e.g. "beta" for beta.theveloriagrand.com.
SENTRY_ENVIRONMENT=""
NEXT_PUBLIC_SENTRY_ENVIRONMENT=""

# ============================================================
# VPS operations — read ONLY by the host-cron scripts
#   scripts/vps-uptime.sh   (every 5 min)     scripts/vps-uptime-cron.txt
#   scripts/vps-backup.sh   (03:30 IST)       scripts/vps-backup-cron.txt
# They source /opt/veloria/.env.production (KEY=value lines only). The app
# itself ignores all of these except DATABASE_URL_UNPOOLED (deploy DDL).
# ============================================================
# Uptime probe target — set to https://beta.theveloriagrand.com until the DNS
# cutover, otherwise the probe is watching Vercel, not this box.
APP_URL="https://app.theveloriagrand.com"
# Alert recipients. A channel is used only when BOTH its variables are set;
# with neither set, transitions are just logged.
ALERT_WHATSAPP_TO=""      # 10-digit Indian mobile or country-code form, comma-separated
ALERT_EMAIL_TO=""         # comma-separated; needs RESEND_API_KEY (above)
ALERT_EMAIL_FROM=""       # defaults to EMAIL_FROM, then "alerts@EMAIL_DOMAIN"
# WhatsApp alerts use the Weflux public API (Authorization: Bearer wfx_live_…).
# WEFLUX_API_KEY is preferred; WEFLUX_CRM_SECRET (the CRM webhook signing
# secret the app already reads) is accepted as a fallback. Free-text WhatsApp
# only delivers inside a 24h customer-service window — email is the reliable
# channel for alerts.
WEFLUX_API_KEY=""
WEFLUX_API_BASE=""        # defaults to https://app.weflux.in/api/public/v1
# Backups
DATABASE_URL_UNPOOLED=""  # direct (non-pooler) Neon URL; falls back to DATABASE_URL
BACKUP_DIR=""             # defaults to /var/backups/veloria
PG_IMAGE=""               # defaults to postgres:16-alpine — must match Neon's PG major

# ============================================================
# Object storage (uploads: photos, bills, PDFs)
# Default is "db": every upload stays a base64 data-URL inside Postgres, exactly
# as before. Set STORAGE_DRIVER="s3" to write NEW uploads to an S3-compatible
# bucket (AWS S3, MinIO, R2, B2) as `s3://<bucket>/<key>` refs stored in the
# same columns; existing inline files keep working, and
# scripts/migrate-files-to-storage.ts moves them over in batches.
# ============================================================
STORAGE_DRIVER="db"
# Endpoint for S3-compatible servers (leave empty for AWS S3).
# MinIO on the VPS: "http://127.0.0.1:9000"
STORAGE_S3_ENDPOINT=""
STORAGE_S3_REGION="us-east-1"
STORAGE_S3_BUCKET=""
STORAGE_S3_ACCESS_KEY=""
STORAGE_S3_SECRET_KEY=""
# "true" for MinIO (bucket in the path, not the hostname).
STORAGE_S3_FORCE_PATH_STYLE="true"
# Optional public/CDN origin for the bucket. When empty (recommended) files are
# streamed through the authenticated proxy /api/files/<key> and the bucket
# hostname never reaches the browser.
STORAGE_PUBLIC_BASE_URL=""

# ============================================================
# Data privacy (India DPDP Act 2023) — /privacy + /settings/privacy
# ============================================================
# Salt for the one-way SHA-256 of client IPs stored on consent records and
# used for privacy-request rate limiting. Raw IPs are never stored. Falls back
# to AUTH_SECRET when empty; set a dedicated value so rotating one does not
# invalidate the other.
PRIVACY_IP_SALT=""
# Grievance Officer shown on the public privacy policy (DPDP requires a named
# contact). Defaults to "Grievance Officer, Billion Events" and the company
# email when empty.
PRIVACY_OFFICER_NAME=""
PRIVACY_OFFICER_EMAIL=""

# ============================================================
# Two-Factor Authentication (authenticator app / TOTP)
# ============================================================
# 32-byte key, base64 — encrypts staff authenticator secrets at rest (AES-256-GCM).
# Generate with:  openssl rand -base64 32
# If left empty a key is derived from AUTH_SECRET (a warning is logged once);
# rotating AUTH_SECRET would then invalidate every enrolled authenticator, so
# set a dedicated key before relying on 2FA in production.
TOTP_ENCRYPTION_KEY=""

# ------------------------------------------------------------
# Push API — POST /api/v1/push/leads (docs at /api/v1/docs)
# Keys are minted in Settings → Integrations → Lead Capture, never in env.
# Every value below is optional; the defaults are shown.
# ------------------------------------------------------------
PUSH_API_ENABLED=true
PUSH_API_RATE_LIMIT_PER_MINUTE=100
PUSH_API_RATE_LIMIT_PER_HOUR=1000
# Seconds an Idempotency-Key is remembered.
PUSH_API_IDEMPOTENCY_TTL=86400
PUSH_API_MAX_BODY_BYTES=65536
# Hours within which a push for the same phone/email updates the open lead.
PUSH_API_DEDUP_WINDOW_HOURS=24
PUSH_API_LOG_RETENTION_DAYS=90
# Browser origins allowed to call the API. Leave empty for server-to-server only.
PUSH_API_ALLOWED_ORIGINS=
# Random secret used to hash client IPs in the audit log. Without it no IP is stored.
PUSH_API_IP_SALT=
