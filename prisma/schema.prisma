// ============================================================
// Logistics / equipment dispatch
// ============================================================
model DispatchOrder {
  id             String         @id @default(cuid())
  dispatchNumber String         @unique
  bookingId      String?
  status         String         @default("PLANNED") // PLANNED | DISPATCHED | DELIVERED | RETURNED | CANCELLED
  fromLocation   String?
  toLocation     String?
  scheduledAt    DateTime?
  dispatchedAt   DateTime?
  deliveredAt    DateTime?
  returnedAt     DateTime?
  driverName     String?
  vehicleNo      String?
  notes          String?        @db.Text
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  items          DispatchItem[]

  @@index([status])
  @@index([bookingId])
  operationId String?
  operation   EventOperation? @relation("OperationDispatches", fields: [operationId], references: [id])
  @@index([operationId])
}

model DispatchItem {
  id              String        @id @default(cuid())
  dispatchId      String
  dispatch        DispatchOrder @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  name            String
  inventoryItemId String? // optional link to a stock item — drives auto stock movements
  quantity        Int           @default(1)
  returnable      Boolean       @default(true)
  returnedQty     Int           @default(0)

  @@index([dispatchId])
  @@index([inventoryItemId])
}

// ============================================================
// SMS — outbound message log (mirrors WhatsAppMessage). Provider is
// env-configured (graceful no-op when unset); delivery status tracked.
// ============================================================
enum SmsMessageStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

model SmsMessage {
  id            String                 @id @default(cuid())
  direction     CommunicationDirection @default(OUTBOUND)
  content       String                 @db.Text
  status        SmsMessageStatus       @default(SENT)
  providerId    String?
  failureReason String?                @db.Text
  toNumber      String?
  sentAt        DateTime               @default(now())

  contactId String? // plain id (no back-relation), like the Rec*/ops pattern

  @@index([contactId])
  @@index([sentAt])
  @@index([status])
}

// ============================================================
// Quotation Catalog tables — RETAINED (orphaned, unused) only so prod
// `prisma db push` doesn't attempt to DROP the already-created tables on the
// next deploy. The catalog-driven quotation feature was reverted; these models
// have NO application code referencing them and hold no data. Safe to delete
// later with an explicit, data-loss-accepted migration.
// ============================================================
enum QuotePackageCategory {
  HALL
  FOOD
  DECOR
  CAKE
  DRINKS
  ACTIVITY
  ROOM
  PHOTOGRAPHY
}

enum QuotePricingType {
  PER_PLATE
  PER_PERSON
  PER_NIGHT
  PER_KG
  FLAT
}

model QuotePackage {
