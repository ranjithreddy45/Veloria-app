// ============================================================
// SALES CADENCES (Sequences)
// ============================================================

model Cadence {
  id                 String   @id @default(cuid())
  name               String
  description        String?  @db.Text
  status             String   @default("DRAFT") // DRAFT, ACTIVE, PAUSED, ARCHIVED
  entityType         String   @default("LEAD")  // LEAD or CONTACT
  exitCriteria       Json     @default("[]")     // [{type, values}]
  autoEnroll         Boolean  @default(false)
  autoEnrollCriteria Json?                       // [{field, operator, value}]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  createdById String
  createdBy   User @relation("UserCadences", fields: [createdById], references: [id])

  steps       CadenceStep[]
  enrollments CadenceEnrollment[]

  @@index([status])
  @@index([entityType])
  @@index([createdById])
}

model CadenceStep {
  id        String   @id @default(cuid())
  stepType  String   // SEND_EMAIL, CREATE_TASK, SEND_WHATSAPP, WAIT, LOG_NOTE
  order     Int
  config    Json     @default("{}") // Step-specific config
  delayDays Int      @default(0)
  delayHours Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cadenceId String
  cadence   Cadence @relation(fields: [cadenceId], references: [id], onDelete: Cascade)

  enrollmentSteps CadenceEnrollmentStep[]

  @@index([cadenceId])
}

model CadenceEnrollment {
  id               String    @id @default(cuid())
  status           String    @default("ACTIVE") // ACTIVE, PAUSED, COMPLETED, STOPPED, EXITED
  currentStepOrder Int       @default(0)
  nextExecuteAt    DateTime?
  pausedAt         DateTime?
  completedAt      DateTime?
  exitReason       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  cadenceId    String
  cadence      Cadence @relation(fields: [cadenceId], references: [id])
  entityId     String
  enrolledById String

  steps CadenceEnrollmentStep[]

  @@unique([cadenceId, entityId])
  @@index([cadenceId])
  @@index([entityId])
  @@index([status, nextExecuteAt])
}

model CadenceEnrollmentStep {
  id         String    @id @default(cuid())
  status     String    @default("PENDING") // PENDING, EXECUTED, SKIPPED, FAILED
  executedAt DateTime?
  error      String?
  createdAt  DateTime  @default(now())

  enrollmentId String
  enrollment   CadenceEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  stepId       String
  step         CadenceStep @relation(fields: [stepId], references: [id])

  @@index([enrollmentId])
  @@index([stepId])
}

