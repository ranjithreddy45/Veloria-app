model ApprovalChainStep {
  id           String  @id @default(cuid())
  order        Int
  approverType String  @default("USER") // USER or ROLE
  approverId   String  // userId or role name
  isOptional   Boolean @default(false)

  ruleId String
  rule   ApprovalRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
}

model ApprovalRequest {
  id            String    @id @default(cuid())
  status        String    @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, REJECTED, DELEGATED, CANCELLED
