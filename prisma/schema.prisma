  packageId   String
  package     QuotePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  groupName   String?
  name        String
  description String?
  imageUrl    String?
  extraCost   Decimal      @default(0) @db.Decimal(12, 2)
  isActive    Boolean      @default(true)
  order       Int          @default(0)

  @@index([packageId])
}

// ============================================================
// FEATURE PACK: 9 additive subsystems
// public-availability-hold, self-serve-configurator, marketing-attribution,
// reputation-flywheel, esignature, speed-to-lead, yield-pricing,
// franchise-enablement, ota-syndication
// ALL additive. New enums + models below. Optional fields on existing
// models (Lead, Booking, Venue, PricingRule, Review, SalesQuotation, User)
// are listed separately in fieldAdditions.
// ============================================================

// ------------------------------------------------------------
// (1) PUBLIC AVAILABILITY HOLD — public token-paid date hold.
// Reuses Booking + Serializable slot engine; this row is the public-side
// container that links the public hold attempt to the safely-created HOLD Booking.
// ------------------------------------------------------------

enum PublicHoldStatus {
  INITIATED // public created the hold request, slot not yet claimed
  SLOT_CLAIMED // HOLD Booking created safely (no double-book)
  PAID // token payment captured
  CONFIRMED // promoted/handed to sales
  EXPIRED // hold window lapsed
  RELEASED // released / cancelled
}

model PublicHold {
  id            String           @id @default(cuid())
  token         String           @unique // unguessable public access token (/(public) route)
  status        PublicHoldStatus @default(INITIATED)
  // Captured event intent (mirrors Booking but public-supplied, pre-resolution)
  eventType     String?
  date          DateTime         @db.Date
  timeSlot      TimeSlot
  guestCount    Int              @default(0)
  // Lead-style customer fields (no login)
  customerName  String
  customerPhone String
  customerEmail String?
  notes         String?          @db.Text
  // Token-to-hold economics
  tokenAmount   Decimal          @default(0) @db.Decimal(12, 2) // amount paid to hold the date
  currency      String           @default("INR")
  expiresAt     DateTime? // hold window; cron releases past this
  paidAt        DateTime?
  // UTM / attribution carried from the public page (mirrors LeadAttribution fields)
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  // Plain refs to keep Booking/Lead/Invoice models un-widened (SalesQuotation pattern)
  bookingId     String? // the safely-created HOLD Booking
  invoiceId     String? // token-payment invoice for /pay/<id>
  leadId        String? // CRM lead minted for follow-up
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  venueId String
  venue   Venue  @relation("VenuePublicHolds", fields: [venueId], references: [id])

  @@index([status])
  @@index([venueId, date, timeSlot])
  @@index([expiresAt]) // cron release sweep
  @@index([createdAt])
}

// ------------------------------------------------------------
// (2) SELF-SERVE CONFIGURATOR — public quote draft built with
// QUOTE_CATALOG + computeQuotation, then a payment link for the advance.
// inputsJson/outputsJson mirror SalesQuotation snapshot convention.
// ------------------------------------------------------------

enum PublicQuoteStatus {
  DRAFT // being configured
  PRICED // computeQuotation run, totals frozen for the link
  LINK_SENT // advance payment link generated
  PAID // advance captured
  CONVERTED // promoted to SalesQuotation / Lead / HOLD
  ABANDONED
}

model PublicQuoteDraft {
  id               String            @id @default(cuid())
  token            String            @unique // public access token (/(public) configurator + pay)
  status           PublicQuoteStatus @default(DRAFT)
  // Calculator snapshot (same shape as SalesQuotation)
  inputsJson       Json // QuotationInput
  outputsJson      Json? // QuotationResult, frozen when PRICED
  // Denormalised headline figures
  customerName     String?
  customerPhone    String?
  customerEmail    String?
  occasion         String?
  eventDate        DateTime?
  timeSlot         String?
  guestCount       Int               @default(0)
  grandTotal       Decimal           @default(0) @db.Decimal(12, 2)
  advanceAmount    Decimal           @default(0) @db.Decimal(12, 2) // 20% advance for the link
  currency         String            @default("INR")
  // Attribution carried from the public page
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  // Plain refs (un-widened) — generated payment link + downstream records
  invoiceId        String? // invoice backing the /pay/<id> advance link
  paymentLinkUrl   String?           @db.Text
  salesQuotationId String? // SalesQuotation minted on conversion
  leadId           String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  venueId String?
  venue   Venue?  @relation("VenuePublicQuoteDrafts", fields: [venueId], references: [id])

  @@index([status])
  @@index([createdAt])
}

// ------------------------------------------------------------
// (3) MARKETING ATTRIBUTION — closed-loop source/campaign/utm capture
// on leads + per-channel/campaign CAC/ROAS rollups.
// LeadAttribution is 1:1 with Lead (FK + @unique).
// ------------------------------------------------------------

model MarketingCampaign {
  id          String    @id @default(cuid())
  name        String
  channel     String // "FACEBOOK_ADS" | "GOOGLE_ADS" | "WEDMEGOOD" | etc (LeadSource-aligned, free string)
  utmSource   String?
  utmMedium   String?
  utmCampaign String? // canonical utm_campaign this MarketingCampaign owns
  // Spend for CAC / ROAS (period totals; refreshed by import/cron)
  spendToDate Decimal   @default(0) @db.Decimal(12, 2)
  currency    String    @default("INR")
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean   @default(true)
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  attributions LeadAttribution[]

  @@index([channel, isActive])
  @@index([utmCampaign])
}

model LeadAttribution {
  id            String   @id @default(cuid())
  // First-touch UTM / source snapshot captured at lead creation
  source        String? // raw source label (FB/Google/webform/referral/...)
  medium        String?
  campaign      String? // utm_campaign string
  term          String?
  content       String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  referrerUrl   String?  @db.Text
  landingUrl    String?  @db.Text
  gclid         String? // Google click id
  fbclid        String? // Facebook click id
  clientId      String? // GA/analytics client id
  // Closed-loop denormalised outcome (refreshed by cron from Lead→Booking)
  bookedRevenue Decimal? @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  leadId      String             @unique
  lead        Lead               @relation(fields: [leadId], references: [id])
  campaignId  String?
  campaignRef MarketingCampaign? @relation(fields: [campaignId], references: [id])

  @@index([utmCampaign])
  @@index([source])
  @@index([campaignId])
}

// ------------------------------------------------------------
// (4) REPUTATION FLYWHEEL — auto Google-review request engine.
// Reuses Review + WhatsApp send + cron. ReviewRequest is the enqueue/lifecycle
// row; gating routes happy→Google URL, unhappy→private feedback (PublicFeedback).
// ------------------------------------------------------------

enum ReviewRequestStatus {
  PENDING // enqueued by cron on booking COMPLETED
  SENT // WhatsApp review request sent
  RATED // customer gave a gating rating
  ROUTED_PUBLIC // happy → sent to Google Business URL
  ROUTED_PRIVATE // unhappy → private feedback captured
  COMPLETED // public review confirmed / closed
  FAILED
  SKIPPED
}

model ReviewRequest {
  id                String              @id @default(cuid())
  token             String              @unique // public landing page token (/(public) feedback)
  status            ReviewRequestStatus @default(PENDING)
  gateRating        Int? // 1-5 quick gating rating from the landing page
  scheduledFor      DateTime? // when the cron should send
  sentAt            DateTime?
  ratedAt           DateTime?
  googleReviewUrl   String?             @db.Text // Google Business URL the happy path opens
  whatsappMessageId String?
  failReason        String?             @db.Text
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  bookingId String
  booking   Booking         @relation(fields: [bookingId], references: [id])
  contactId String
  contact   Contact         @relation(fields: [contactId], references: [id])
  feedback  PublicFeedback?

  @@unique([bookingId]) // one review request per booking (idempotent enqueue)
  @@index([status])
  @@index([scheduledFor])
}

model PublicFeedback {
  id         String    @id @default(cuid())
  rating     Int // gating rating (1-5)
  comment    String?   @db.Text
  isResolved Boolean   @default(false) // staff worked the unhappy feedback
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  reviewRequestId String        @unique
  reviewRequest   ReviewRequest @relation(fields: [reviewRequestId], references: [id])

  @@index([isResolved])
}

// ------------------------------------------------------------
// (5) E-SIGNATURE — tokenized public sign of booking confirmation + T&C.
// Records signed-at/ip/name and locks the doc.
// ------------------------------------------------------------

enum SignatureRequestStatus {
  DRAFT
  SENT // tokenized link delivered
  VIEWED
  SIGNED // locked
  DECLINED
  EXPIRED
  VOIDED
}

enum SignatureType {
  TYPED
  DRAWN
}

model SignatureRequest {
  id              String                 @id @default(cuid())
  token           String                 @unique // unguessable public sign link (/(public) route)
  status          SignatureRequestStatus @default(DRAFT)
  // Frozen document content the signer reviews (booking confirmation + T&C)
  documentTitle   String
  documentBody    String                 @db.Text // rendered HTML/markdown snapshot, locked at sign time
  // Signer details + audit
  signerName      String?
  signerEmail     String?
  signerPhone     String?
  signatureType   SignatureType?
  signatureData   String?                @db.Text // typed name or base64 drawn-signature image
  signedAt        DateTime?
  signedIp        String?
  signedUserAgent String?                @db.Text
  isLocked        Boolean                @default(false) // doc immutable after signing
  expiresAt       DateTime?
  sentAt          DateTime?
  viewedAt        DateTime?
  declinedReason  String?                @db.Text
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  bookingId   String
  booking     Booking @relation(fields: [bookingId], references: [id])
  createdById String
  createdBy   User    @relation("SignatureRequestCreatedBy", fields: [createdById], references: [id])

  @@index([bookingId])
  @@index([status])
}

// ------------------------------------------------------------
// (6) SPEED-TO-LEAD — instant first-response + drip + round-robin assignment.
// Reuses Lead SLA fields + AssignmentRule round-robin + Cadence + WhatsApp.
// LeadFirstResponse is 1:1 with Lead tracking the <60s automated response;
// SLA timer/breach already on Lead (firstContactDue/firstRespondedAt/slaEscalatedAt).
// ------------------------------------------------------------

enum FirstResponseStatus {
  PENDING // lead created, automated response queued
  SENT // automated WhatsApp first-response sent (<60s target)
  FAILED // send failed
  SKIPPED // no phone / opted out
}

model LeadFirstResponse {
  id                String              @id @default(cuid())
  status            FirstResponseStatus @default(PENDING)
  channel           String              @default("WHATSAPP") // WHATSAPP | SMS | EMAIL
  templateName      String?
  sentAt            DateTime? // actual first-response time
  latencyMs         Int? // capture→send latency for the <60s SLA metric
  whatsappMessageId String?
  failReason        String?             @db.Text
  // Round-robin assignment audit
  assignedViaRuleId String? // AssignmentRule used for round-robin
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  leadId       String  @unique
  lead         Lead    @relation(fields: [leadId], references: [id])
  assignedToId String?
  assignedTo   User?   @relation("LeadFirstResponseAssignee", fields: [assignedToId], references: [id])

  @@index([status])
  @@index([createdAt])
}

// ------------------------------------------------------------
// (7) YIELD / DYNAMIC PRICING — extends PricingRule via new enum values
// (OCCUPANCY, DEMAND, LEAD_TIME — see fieldAdditions/enum note below) plus a
// per-venue/date demand signal table calculatePrice reads for occupancy-based math.
// ------------------------------------------------------------

model VenueDemandSignal {
  id               String    @id @default(cuid())
  date             DateTime  @db.Date
  timeSlot         TimeSlot?
  // Demand inputs the yield rules read
  occupancyPct     Decimal   @default(0) @db.Decimal(5, 2) // 0-100 booked share for the window
  demandScore      Decimal   @default(0) @db.Decimal(5, 2) // 0-100 composite demand index
  inquiryCount     Int       @default(0)
  // Optional manual override multiplier (e.g. event-week surge)
  manualMultiplier Decimal?  @db.Decimal(5, 3)
  source           String    @default("CRON") // CRON | MANUAL
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  venueId String
  venue   Venue  @relation("VenueDemandSignals", fields: [venueId], references: [id])

  @@unique([venueId, date, timeSlot])
  @@index([venueId, date])
}

// ------------------------------------------------------------
// (8) FRANCHISE ENABLEMENT — per-venue P&L rollup, onboarding wizard,
// revenue-share config + accounting, white-label storefront per venue.
// Builds on Venue hierarchy + finance.
// ------------------------------------------------------------

enum FranchiseOnboardingStatus {
  DRAFT
  IN_PROGRESS
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
}

enum RevenueShareBasis {
  GROSS_REVENUE
  NET_REVENUE
  FLAT_FEE
}

enum RevenueSharePayoutStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

model FranchisePartner {
  id             String                    @id @default(cuid())
  name           String
  legalName      String?
  contactEmail   String?
  contactPhone   String?
  status         FranchiseOnboardingStatus @default(DRAFT)
  // Onboarding wizard progress
  onboardingStep Int                       @default(0)
  onboardingData Json                      @default("{}") // wizard answers (KYC, bank, docs refs)
  notes          String?                   @db.Text
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  ownerUserId String?
  ownerUser   User?   @relation("FranchisePartnerOwner", fields: [ownerUserId], references: [id])

  venues              FranchiseVenue[]
  revenueShareConfigs RevenueShareConfig[]
  revenueSharePayouts RevenueSharePayout[]

  @@index([status])
}

// Join between a FranchisePartner and a Venue (a partner can run several venues).
model FranchiseVenue {
  id               String   @id @default(cuid())
  // White-label storefront settings (per venue)
  storefrontSlug   String?  @unique // public white-label storefront slug
  brandName        String?
  logoUrl          String?  @db.Text
  primaryColor     String? // hex
  customDomain     String?
  storefrontConfig Json     @default("{}") // theme/content overrides
  isStorefrontLive Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  partnerId String
  partner   FranchisePartner @relation(fields: [partnerId], references: [id])
  venueId   String
  venue     Venue            @relation("VenueFranchise", fields: [venueId], references: [id])

  @@unique([partnerId, venueId])
  @@index([venueId])
}

model RevenueShareConfig {
  id            String            @id @default(cuid())
  name          String
  basis         RevenueShareBasis @default(GROSS_REVENUE)
  sharePct      Decimal           @default(0) @db.Decimal(5, 2) // partner/HQ share %
  flatFeeAmount Decimal?          @db.Decimal(12, 2) // when basis = FLAT_FEE
  currency      String            @default("INR")
  isActive      Boolean           @default(true)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  partnerId String
  partner   FranchisePartner @relation(fields: [partnerId], references: [id])
  venueId   String?
  venue     Venue?           @relation("VenueRevenueShare", fields: [venueId], references: [id])

  payouts RevenueSharePayout[]

  @@index([partnerId, isActive])
  @@index([venueId])
}

// Periodic revenue-share accrual/accounting per venue (P&L rollup feeds this).
model RevenueSharePayout {
  id           String                   @id @default(cuid())
  period       String // "YYYY-MM"
  grossRevenue Decimal                  @default(0) @db.Decimal(14, 2)
  netRevenue   Decimal                  @default(0) @db.Decimal(14, 2)
  shareAmount  Decimal                  @default(0) @db.Decimal(12, 2)
  currency     String                   @default("INR")
  status       RevenueSharePayoutStatus @default(PENDING)
  paidAt       DateTime?
  paymentRef   String?
  notes        String?                  @db.Text
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  partnerId String
  partner   FranchisePartner    @relation(fields: [partnerId], references: [id])
  venueId   String?
  venue     Venue?              @relation("VenueRevenueSharePayouts", fields: [venueId], references: [id])
  configId  String?
  config    RevenueShareConfig? @relation(fields: [configId], references: [id])

  @@unique([partnerId, venueId, period])
  @@index([status])
  @@index([period])
}

// ------------------------------------------------------------
// (9) OTA SYNDICATION — outbound availability/listing feeds per venue +
// inbound lead ingestion endpoint mapping. Sibling to LeadCaptureConfig.
// ------------------------------------------------------------

enum OtaChannelType {
  WEDMEGOOD
  JUSTDIAL
  GOOGLE_BUSINESS
  INDIAMART
  GENERIC
}

enum OtaFeedFormat {
  JSON
  ICAL
}

enum OtaSyncDirection {
  OUTBOUND // we publish availability/listing
  INBOUND // we ingest leads
}

enum OtaSyncStatus {
  SUCCESS
  PARTIAL
  FAILED
}

model OtaChannel {
  id                 String         @id @default(cuid())
  channelType        OtaChannelType
  name               String
  // Outbound feed
  feedFormat         OtaFeedFormat  @default(JSON)
  feedToken          String?        @unique // unguessable public feed token (/(public) feed url)
  // Inbound ingestion
  inboundToken       String?        @unique // token for the inbound lead endpoint
  fieldMapping       Json           @default("{}") // inbound payload → lead-capture field map
  defaultSource      LeadSource     @default(OTHER) // LeadSource stamped on ingested leads
  credentials        Json           @default("{}")
  isActive           Boolean        @default(true)
  lastOutboundSyncAt DateTime?
  lastInboundSyncAt  DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  venueId String?
  venue   Venue?  @relation("VenueOtaChannels", fields: [venueId], references: [id])

  syncLogs OtaSyncLog[]

  @@index([channelType, isActive])
  @@index([venueId])
}

model OtaSyncLog {
  id          String           @id @default(cuid())
  direction   OtaSyncDirection
  status      OtaSyncStatus
  recordCount Int              @default(0) // listings published or leads ingested
  errorCount  Int              @default(0)
  message     String?          @db.Text
  payloadRef  String?          @db.Text // raw payload / response snapshot ref
  createdAt   DateTime         @default(now())

  channelId String
  channel   OtaChannel @relation(fields: [channelId], references: [id])

  @@index([channelId, createdAt])
  @@index([status])
}

// ------------------------------------------------------------
// Cron run history — one row per orchestrator lane execution. Powers the
// /api/health heartbeat and gives admins a trail when a job fails.
// ------------------------------------------------------------
model CronRunLog {
  id         String   @id @default(cuid())
  lane       String // "daily" | "frequent" | "<single-job>"
  status     String // "SUCCESS" | "PARTIAL" | "FAILURE"
  total      Int      @default(0)
  failed     Int      @default(0)
  durationMs Int      @default(0)
  results    Json? // { "<job>": "ok" | "http_500" | "error: ..." }
  createdAt  DateTime @default(now())

  @@index([lane, createdAt])
  @@index([createdAt])
}

// ============================================================
// SALES GROWTH ENGINE — 22-feature additive delta (Sales Wave)
// Conventions: cuid ids, createdAt/updatedAt, money @db.Decimal,
// plain String refs (no core-model FK widening — SalesQuotation/PublicHold
// pattern), token String @unique for public routes, @db.Date + TimeSlot for
// slot/date matching. ADDITIVE ONLY.
// ============================================================

// ------------------------------------------------------------
// SHARED ENUMS
// ------------------------------------------------------------

enum QuoteShareStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum QuoteTierLabel {
  SILVER
  GOLD
  PLATINUM
  CUSTOM
}

enum QuoteViewDevice {
  MOBILE
  DESKTOP
  TABLET
  UNKNOWN
}

enum MessageIntent {
  READY_TO_BUY
  DATE_CHECK
  PRICE_OBJECTION
  COLD
  GENERAL
}

enum RepAvailabilityStatus {
  ONLINE
  BUSY
  AWAY
  OFFLINE
}

enum SlaEscalationTier {
  NONE
  WARN_REP
  ESCALATE_MANAGER
  ESCALATE_ADMIN
}

enum WinbackKind {
  ABANDONED_QUOTE
  LOST_LEAD_REVIVAL
  EVENT_DATE_PROXIMITY
  COOLING_LEAD
  CORPORATE_FARMING
}

enum WinbackStatus {
  PENDING
  ENROLLED
  CONTACTED
  RECOVERED
  EXHAUSTED
  SUPPRESSED
}

enum SiteVisitKind {
  SITE_VISIT
  MENU_TASTING
}

enum SiteVisitStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum ReferralPartnerType {
  PLANNER
  DECORATOR
  VENDOR
  GUEST
  EMPLOYEE
}

enum BrochureCtaType {
  HOLD_DATE
  BOOK_VISIT
  GET_QUOTE
  WHATSAPP
}

enum CorporateAccountTier {
  PROSPECT
  ACTIVE
  KEY
  DORMANT
  CHURNED
}

// ============================================================
// (1) quote-radar / (2) quote-onetap-pay / (3) quote-tiers /
//     (5) quote-ai-caption — shareable tracked public quote link
// ============================================================

// One shareable public link per quote (or per Good-Better-Best group).
// Reuses the frozen SalesQuotation.outputsJson snapshot via plain refs.
model QuoteShareLink {
  id                 String           @id @default(cuid())
  token              String           @unique // unguessable /q/<token> access token
  status             QuoteShareStatus @default(ACTIVE)
  // What this link renders. quoteGroupId groups parallel tiers (feature 3);
  // primarySalesQuotationId is the default/highlighted tier.
  quoteGroupId       String? // shared across tier variants on one page
  primaryQuotationId String? // plain ref → SalesQuotation.id
  // Plain CRM refs (un-widened)
  leadId             String?
  contactId          String?
  venueId            String?
  // Denormalised headline for fast render + WhatsApp caption
  clientName         String?
  clientPhone        String?
  occasion           String?
  eventDate          DateTime?
  timeSlot           String?
  grandTotal         Decimal          @default(0) @db.Decimal(12, 2)
  currency           String           @default("INR")
  // Social-proof toggle (feature 4) — render approved reviews/gallery inline
  showSocialProof    Boolean          @default(true)
  // AI caption (feature 5) snapshot of last generated WhatsApp message
  aiCaption          String?          @db.Text
  aiCaptionAt        DateTime?
  // One-tap pay (feature 2) — invoice backing the "Pay 20%" button
  payInvoiceId       String? // plain ref → Invoice.id
  paymentLinkUrl     String?          @db.Text
  // View analytics rollup (detail rows in QuoteView)
  viewCount          Int              @default(0)
  firstViewedAt      DateTime?
  lastViewedAt       DateTime?
  // Recovery trigger bookkeeping (feature 1 "opened-but-silent 24h")
  silentNudgeFiredAt DateTime? // dedupe the auto cadence-enroll / rep notify
  expiresAt          DateTime?
  createdById        String? // rep who shared
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  views QuoteView[]
  tiers QuoteTier[]

  @@index([status])
  @@index([quoteGroupId])
  @@index([leadId])
  @@index([contactId])
  @@index([lastViewedAt])
  @@index([silentNudgeFiredAt])
  @@index([createdAt])
}

// Good-Better-Best parallel tier on one shared quote page (feature 3).
// Each row points to a distinct SalesQuotation (its own outputsJson snapshot)
// sharing the same quoteGroupId; customer selects one to pay.
model QuoteTier {
  id            String         @id @default(cuid())
  shareLinkId   String
  shareLink     QuoteShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
  label         QuoteTierLabel @default(CUSTOM)
  displayName   String // "Silver" | "Gold" | "Platinum" | custom
  order         Int            @default(0)
  quotationId   String // plain ref → SalesQuotation.id (priced variant)
  grandTotal    Decimal        @default(0) @db.Decimal(12, 2)
  isRecommended Boolean        @default(false) // anchor highlight
  isSelected    Boolean        @default(false) // customer chose this tier
  selectedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([shareLinkId, quotationId])
  @@index([shareLinkId, order])
}

// VIEW analytics event — one row per open of the public quote page.
model QuoteView {
  id                String          @id @default(cuid())
  shareLinkId       String
  shareLink         QuoteShareLink  @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
  viewedAt          DateTime        @default(now())
  device            QuoteViewDevice @default(UNKNOWN)
  userAgent         String?         @db.Text
  ipHash            String? // hashed ip for unique-visitor dedupe (no raw PII)
  referrer          String?         @db.Text
  // Which tier the viewer focused on (plain ref → SalesQuotation.id)
  viewedQuotationId String?
  durationMs        Int? // dwell time if measured client-side

  @@index([shareLinkId, viewedAt])
}

// ============================================================
// (6) channel-roi-reallocator — prescriptive ad-spend reallocation
// ============================================================

// Snapshot of a computed reallocation recommendation set (per run).
// Reads existing per-channel CAC/ROAS/LTV; persists rupee-precise advice.
model ChannelReallocationRun {
  id                   String   @id @default(cuid())
  periodStart          DateTime
  periodEnd            DateTime
  totalSpend           Decimal  @default(0) @db.Decimal(14, 2)
  currency             String   @default("INR")
  // Headline summary surfaced on the cockpit panel
  projectedBookingLift Int      @default(0) // est. extra bookings from the plan
  projectedRoasLift    Decimal  @default(0) @db.Decimal(6, 2)
  notes                String?  @db.Text
  createdById          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  recommendations ChannelReallocationRec[]

  @@index([periodEnd])
  @@index([createdAt])
}

model ChannelReallocationRec {
  id                   String                 @id @default(cuid())
  runId                String
  run                  ChannelReallocationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  fromChannel          String // e.g. "JUSTDIAL"
  toChannel            String // e.g. "META"
  segment              String? // e.g. "weddings"
  shiftAmount          Decimal                @default(0) @db.Decimal(12, 2) // rupees to move
  currency             String                 @default("INR")
  expectedBookingDelta Int                    @default(0) // "+3 bookings"
  rationale            String?                @db.Text
  createdAt            DateTime               @default(now())

  @@index([runId])
}

// ============================================================
// (7) missed-call-rescue — inbound-call / unknown-number → WA lead rescue
// ============================================================

// Audit row for missed/unknown inbound rings turned into scored leads.
// Idempotent on externalCallId to swallow webhook redeliveries.
model MissedCallRescue {
  id                String   @id @default(cuid())
  provider          String   @default("UNKNOWN") // EXOTEL | KNOWLARITY | MYOPERATOR | IVR
  externalCallId    String?  @unique // dedupe webhook redeliveries
  callerPhone       String
  receivedAt        DateTime @default(now())
  wasKnownNumber    Boolean  @default(false) // matched an existing Contact
  // Outcomes (plain refs — un-widened)
  leadId            String? // lead minted via captureLeadFromExternal
  contactId         String?
  // Instant WhatsApp first-response result
  whatsappSent      Boolean  @default(false)
  whatsappMessageId String?
  failReason        String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([callerPhone])
  @@index([receivedAt])
  @@index([leadId])
}

// ============================================================
// (8) smart-routing / (11) known-contact-ack — rep availability + load
// ============================================================

// Live availability + capacity signal per rep, read by SMART routing.
// 1:1 with User via @unique userId (plain ref to avoid widening User).
model RepAvailability {
  id                  String                @id @default(cuid())
  userId              String                @unique // plain ref → User.id
  status              RepAvailabilityStatus @default(OFFLINE)
  // Capacity / load signal
  openLeadCount       Int                   @default(0) // refreshed by cron / on assignment
  capacityLimit       Int                   @default(50) // soft cap for lightest-loaded routing
  // Skill-match dimensions for best-matched routing
  eventTypeSkills     String[] // e.g. ["WEDDING","CORPORATE"]
  languages           String[] // e.g. ["en","hi","te"]
  lastSeenAt          DateTime?
  autoOfflineAfterMin Int                   @default(15) // mark OFFLINE if idle
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([status])
  @@index([openLeadCount])
}

// Audit row for each SMART routing decision (diagnostics + fairness review).
model LeadRoutingDecision {
  id                String   @id @default(cuid())
  leadId            String // plain ref → Lead.id
  assignedToId      String? // chosen rep (plain ref → User.id)
  method            String   @default("SMART") // SMART | ROUND_ROBIN | DIRECT
  // Why this rep won
  matchedEventType  Boolean  @default(false)
  matchedLanguage   Boolean  @default(false)
  repLoadAtDecision Int      @default(0)
  ruleId            String? // AssignmentRule.id if a rule produced it
  scoreBreakdown    Json     @default("{}") // {availability, load, skill, ...}
  createdAt         DateTime @default(now())

  @@index([leadId])
  @@index([assignedToId])
  @@index([createdAt])
}

// ============================================================
// (9) intent-classifier — inbound-message intent tag + hot re-score
// ============================================================

// Classification stamp for an inbound message (clone of sentiment pattern).
// Plain ref to WhatsAppMessage/Communication so core comms models stay narrow.
model MessageIntentClassification {
  id                String        @id @default(cuid())
  // Source message (one of these set)
  whatsappMessageId String? // plain ref → WhatsAppMessage.id
  communicationId   String? // plain ref → Communication.id
  contactId         String? // plain ref → Contact.id
  leadId            String? // plain ref → Lead.id
  intent            MessageIntent @default(GENERAL)
  confidence        Decimal       @default(0) @db.Decimal(4, 3) // 0.000–1.000
  method            String        @default("KEYWORD") // LLM | KEYWORD
  rawText           String?       @db.Text
  // Action taken (READY_TO_BUY → ping rep + boost score)
  scoreBoostApplied Int           @default(0)
  repNotifiedAt     DateTime?
  createdAt         DateTime      @default(now())

  @@index([intent])
  @@index([leadId])
  @@index([contactId])
  @@index([createdAt])
}

// ============================================================
// (12) sla-warroom — first-response countdown + tiered auto-escalation
// ============================================================

// Per-lead escalation-tier ledger (war-room cockpit + cron escalation).
// Builds on Lead.firstContactDue/slaEscalatedAt; idempotent per (leadId,tier).
model LeadSlaEscalation {
  id                String            @id @default(cuid())
  leadId            String // plain ref → Lead.id
  tier              SlaEscalationTier @default(WARN_REP)
  firedAt           DateTime          @default(now())
  // Who was alerted (plain refs)
  notifiedRepId     String?
  notifiedManagerId String?
  breachMinutes     Int               @default(0) // minutes past firstContactDue when fired
  resolvedAt        DateTime? // first response landed / lead progressed
  createdAt         DateTime          @default(now())

  @@unique([leadId, tier]) // alert each tier once per lead
  @@index([leadId])
  @@index([tier, firedAt])
}

// ============================================================
// (13) whatsapp-console — 2-way reply console + AI co-pilot drafts
// ============================================================

// Ephemeral AI-drafted reply variants for the in-CRM console (1–3 options).
// Stamps which variant the rep actually sent. Plain ref to Contact.
model WhatsAppReplyDraft {
  id               String    @id @default(cuid())
  contactId        String // plain ref → Contact.id
  leadId           String? // plain ref → Lead.id
  // 24h session-window state at draft time (display gate)
  sessionOpen      Boolean   @default(false)
  sessionExpiresAt DateTime?
  // Up to 3 AI variants: [{ tone, text }]
  variants         Json      @default("[]")
  model            String? // AI provider used (openai|groq|gemini|none)
  sentVariantIdx   Int? // which variant the rep sent
  sentMessageId    String? // plain ref → WhatsAppMessage.id
  sentAt           DateTime?
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([contactId])
  @@index([leadId])
  @@index([createdAt])
}

// ============================================================
// (14) winback-crons / (15) cooling-lead-catch / (22) corporate-farming —
// owned-demand win-back marker (one row per recovery attempt)
// ============================================================

// Marks a lead/contact targeted by a win-back cron, the cadence it enrolled
// into, and the outcome — so reruns are idempotent and dashboards can report.
model WinbackTarget {
  id                String        @id @default(cuid())
  kind              WinbackKind
  status            WinbackStatus @default(PENDING)
  // Subject (plain refs)
  leadId            String?
  contactId         String?
  shareLinkId       String? // for ABANDONED_QUOTE (the viewed-but-unpaid link)
  // Why it was selected (taxonomy / proximity)
  lostReason        String? // for LOST_LEAD_REVIVAL
  eventDate         DateTime? // for EVENT_DATE_PROXIMITY
  coolOffUntil      DateTime? // earliest eligible re-engage time
  // Recovery wiring
  cadenceId         String? // plain ref → Cadence.id enrolled into
  enrollmentId      String? // plain ref → CadenceEnrollment.id
  whatsappMessageId String?
  recoveredLeadId   String? // booked / re-warmed result
  recoveredAt       DateTime?
  attempts          Int           @default(0)
  lastAttemptAt     DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([kind, status])
  @@index([leadId])
  @@index([contactId])
  @@index([coolOffUntil])
  @@index([createdAt])
}

// ============================================================
// (16) referral-portal / (17) review-referral-flywheel — partner codes + payouts
// ============================================================

// Self-serve referral partner with a tokenized/QR intake link (/refer/<code>).
// Wires the dormant Referral/ReferralReward engine to a public portal.
model ReferralPartner {
  id                 String              @id @default(cuid())
  code               String              @unique // /refer/<code> + QR
  type               ReferralPartnerType @default(PLANNER)
  name               String
  email              String?
  phone              String?
  // Plain refs to existing identities (no widening)
  contactId          String?
  userId             String?
  vendorId           String?
  // Source of the code (feature 17 review-to-referral)
  issuedFromReviewId String? // plain ref → Review.id (5-star reviewer code)
  // Payout config
  payoutType         String              @default("FLAT") // FLAT | PERCENT | POINTS
  payoutValue        Decimal             @default(0) @db.Decimal(12, 2)
  payoutPercent      Decimal             @default(0) @db.Decimal(5, 2)
  currency           String              @default("INR")
  isActive           Boolean             @default(true)
  // Denormalised partner-dashboard rollups (refreshed by cron)
  submittedCount     Int                 @default(0)
  convertedCount     Int                 @default(0)
  totalEarned        Decimal             @default(0) @db.Decimal(14, 2)
  totalPaid          Decimal             @default(0) @db.Decimal(14, 2)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  submissions ReferralPortalSubmission[]
  payouts     ReferralPayout[]

  @@index([type, isActive])
  @@index([contactId])
  @@index([userId])
  @@index([vendorId])
}

// A referral submitted through the public portal — captures as a lead
// (REFERRAL source, +score) with auto-attribution back to the partner.
model ReferralPortalSubmission {
  id                 String          @id @default(cuid())
  partnerId          String
  partner            ReferralPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  // Prospect details supplied in the form
  prospectName       String
  prospectPhone      String?
  prospectEmail      String?
  eventType          String?
  eventDate          DateTime?
  guestCount         Int?
  message            String?         @db.Text
  // Outcomes (plain refs)
  leadId             String? // captured lead
  referralId         String? // plain ref → Referral.id created
  convertedBookingId String?
  bookingValue       Decimal?        @db.Decimal(12, 2)
  // Attribution carried from the portal page
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([partnerId])
  @@index([leadId])
  @@index([createdAt])
}

// Reliably-paid payout for a converted referral. Complements ReferralReward
// (which is keyed to Referral); this is the partner-portal payable ledger.
model ReferralPayout {
  id                   String          @id @default(cuid())
  partnerId            String
  partner              ReferralPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  // Source (plain refs)
  submissionId         String?
  referralId           String? // plain ref → Referral.id
  referralRewardId     String? // plain ref → ReferralReward.id (if engine produced one)
  loyaltyTransactionId String? // plain ref → LoyaltyTransaction.id (flywheel credit)
  amount               Decimal         @default(0) @db.Decimal(12, 2)
  currency             String          @default("INR")
  status               String          @default("PENDING") // PENDING | APPROVED | PAID | CANCELLED
  approvedAt           DateTime?
  paidAt               DateTime?
  paymentRef           String?
  notes                String?         @db.Text
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([partnerId, status])
  @@index([referralId])
  @@index([createdAt])
}

// ============================================================
// (18) empty-date-selldown — capacity-aware sell-down board snapshot
// ============================================================

// Persisted board snapshot of low-occupancy venue/date/slots to target.
// Reads getAvailabilityGrid + bookings; matched open leads stored as refs.
model SellDownTarget {
  id               String   @id @default(cuid())
  venueId          String // plain ref → Venue.id
  date             DateTime @db.Date
  timeSlot         TimeSlot
  occupancyPct     Decimal  @default(0) @db.Decimal(5, 2)
  isPeakDate       Boolean  @default(false) // perishable peak-date inventory
  // Matched open leads to chase (plain ref id array)
  matchedLeadIds   String[]
  matchedLeadCount Int      @default(0)
  // Action bookkeeping
  status           String   @default("OPEN") // OPEN | WORKING | FILLED | EXPIRED
  filledBookingId  String?
  computedAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([venueId, date, timeSlot])
  @@index([status, date])
  @@index([isPeakDate, date])
}

// ============================================================
// (19) site-visit-booking — self-serve site-visit / menu-tasting scheduler
// ============================================================

// Public scheduler (/visit) booking → high-score lead + internal calendar
// entry + reminders. Generalizes the BD AcqSiteVisit + availability pattern.
model SiteVisitBooking {
  id             String          @id @default(cuid())
  token          String          @unique // /visit/<token> manage/confirm link
  kind           SiteVisitKind   @default(SITE_VISIT)
  status         SiteVisitStatus @default(REQUESTED)
  // Prospect (no login)
  customerName   String
  customerPhone  String
  customerEmail  String?
  eventType      String?
  guestCount     Int?
  // Scheduling
  venueId        String? // plain ref → Venue.id
  scheduledAt    DateTime
  durationMin    Int             @default(60)
  notes          String?         @db.Text
  // Outcomes (plain refs)
  leadId         String? // high-score lead minted
  contactId      String?
  assignedToId   String? // host rep
  // Reminders
  reminderSentAt DateTime?
  confirmedAt    DateTime?
  completedAt    DateTime?
  // Attribution carried from the public page
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status])
  @@index([scheduledAt])
  @@index([venueId, scheduledAt])
  @@index([leadId])
  venue   Venue?   @relation("VenueSiteVisits", fields: [venueId], references: [id])
}

// ============================================================
// (20) digital-brochure — immersive single-link venue/event microsite
// ============================================================

// Per-venue / event-type brochure config rendered at /v/<slug>.
// Reuses storefront shell + Gallery/Review via plain refs.
model DigitalBrochure {
  id                 String            @id @default(cuid())
  slug               String            @unique // /v/<slug>
  venueId            String? // plain ref → Venue.id
  eventType          String? // event-type-scoped variant
  title              String
  subtitle           String?
  heroImageUrl       String?           @db.Text
  // Immersive media
  videoEmbedUrl      String?           @db.Text
  tour360Url         String?           @db.Text
  // Curated proof (plain ref id arrays into GalleryItem / Review)
  galleryItemIds     String[]
  reviewIds          String[]
  // Pricing teaser
  startingFromAmount Decimal?          @db.Decimal(12, 2)
  currency           String            @default("INR")
  // CTAs surfaced ("Hold this date" / "Book a visit")
  enabledCtas        BrochureCtaType[]
  whatsappNumber     String?
  // Analytics rollup
  isPublished        Boolean           @default(false)
  viewCount          Int               @default(0)
  lastViewedAt       DateTime?
  seoDescription     String?           @db.Text
  createdById        String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([venueId])
  @@index([eventType])
  @@index([isPublished])
}

// ============================================================
// (21) whatsapp-catalog — auto-brochure / quick-reply session on first inbound
// ============================================================

// Tracks the interactive WhatsApp catalog session shown to a new number:
// event-type quick-reply buttons → tailored package cards → brochure/quote CTA.
model WhatsAppCatalogSession {
  id                String    @id @default(cuid())
  phone             String
  contactId         String? // plain ref → Contact.id (once resolved/created)
  leadId            String? // plain ref → Lead.id
  // Flow state
  stage             String    @default("PROMPTED") // PROMPTED | EVENT_SELECTED | CARDS_SENT | CTA_CLICKED | CLOSED
  selectedEventType String? // event-type the user tapped
  // What we sent back (plain refs / ids)
  brochureSlug      String? // DigitalBrochure.slug returned
  shareLinkToken    String? // QuoteShareLink.token if a quote was offered
  lastMessageId     String? // plain ref → WhatsAppMessage.id
  promptedAt        DateTime  @default(now())
  respondedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([phone])
  @@index([contactId])
  @@index([stage])
}

// ============================================================
// (22) corporate-farming — corporate account command center
// ============================================================

// Treats a corporate Contact as an ACCOUNT with quarterly re-engagement +
// multi-event commitment offers. Builds on Contact (customerType CORPORATE).
model CorporateAccount {
  id                     String               @id @default(cuid())
  contactId              String               @unique // plain ref → Contact.id (the account)
  accountName            String
  tier                   CorporateAccountTier @default(PROSPECT)
  // Recency-driven re-engagement cadence
  lastEventDate          DateTime?
  nextReengageAt         DateTime? // quarterly cadence anchor
  reengageCadenceId      String? // plain ref → Cadence.id
  // Multi-event commitment offer ("book 3/year → locked pricing")
  committedEventsPerYear Int                  @default(0)
  lockedPricePerPlate    Decimal?             @db.Decimal(10, 2)
  commitmentStart        DateTime?
  commitmentEnd          DateTime?
  // Denormalised account rollups (refreshed by cron from bookings history)
  pastEventCount         Int                  @default(0)
  upcomingEventCount     Int                  @default(0)
  lifetimeRevenue        Decimal              @default(0) @db.Decimal(14, 2)
  ownerUserId            String? // account manager (plain ref → User.id)
  notes                  String?              @db.Text
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@index([tier])
  @@index([nextReengageAt])
  @@index([ownerUserId])
  contact   Contact   @relation("ContactCorporateAccount", fields: [contactId], references: [id])
}

// ============================================================
// Date-demand (yield) pricing — Muhurtham / festival / weekend premiums.
// ------------------------------------------------------------
// Tells the team how much to charge on scarce, high-demand dates so peak
// inventory isn't under-priced. PeakDate marks specific auspicious/festival
// dates; weekends + scarcity are derived. Premiums are advisory (% uplift on
// the whole quote) and surfaced in the quote builder.
// ============================================================
model PeakDate {
  id          String   @id @default(cuid())
  date        DateTime  @db.Date
  type        String    // MUHURTHAM | FESTIVAL | CUSTOM
  label       String
  premiumPct  Int? // per-date override; null → DemandPricingConfig default for the type
  venueId     String? // null = applies to all venues
  isActive    Boolean  @default(true)
  note        String?  @db.Text
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([isActive])
}

// Singleton config (one row) — the demand-pricing knobs the admin tunes.
model DemandPricingConfig {
  id              String   @id @default(cuid())
  enabled         Boolean  @default(true)
  muhurthamPct    Int      @default(20)
  festivalPct     Int      @default(15)
  saturdayPct     Int      @default(12)
  sundayPct       Int      @default(8)
  scarcityStepPct Int      @default(5) // +this per already-booked slot on the date
  scarcityCapPct  Int      @default(30) // cap on the scarcity bump
  updatedAt       DateTime @updatedAt
}

// ============================================================
// HR Compensation & Payroll (Wave 1) — employee-facing salary
// structures, monthly payslips with real Indian statutory
// (PF/ESI/PT/TDS/gratuity) and full-&-final settlement.
// All Employee references are denormalized String ids (no back
// relation on the large Employee model) — the additive-safe pattern
// used across HR. Additive only; never drops existing tables.
// ============================================================

enum HrPayComponentKind {
  EARNING
  DEDUCTION
}

enum HrPayCalcType {
  FLAT // fixed monthly amount
  PCT_OF_BASIC // rate% of basic
  PCT_OF_CTC // rate% of monthly CTC
  BALANCE // special allowance — balances the CTC after other heads
}

enum HrStatutoryType {
  NONE
  PF
  ESI
  PT
  TDS
  GRATUITY
}

// Configurable pay heads (earnings & deductions). Statutory heads are
// flagged so the engine computes them from law rather than a flat value.
model HrPayComponent {
  id        String             @id @default(cuid())
  entityId  String             @default("BILLION")
  code      String
  name      String
  kind      HrPayComponentKind @default(EARNING)
  calcType  HrPayCalcType      @default(FLAT)
  rate      Decimal            @default(0) @db.Decimal(9, 4) // % when calcType is PCT_*
  taxable   Boolean            @default(true)
  partOfCtc Boolean            @default(true)
  statutory HrStatutoryType    @default(NONE)
  order     Int                @default(0)
  active    Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([entityId, code])
  @@index([entityId, active])
}

// Per-employee CTC + component breakdown. Revisions are new rows; the
// latest current row (isCurrent) is the one payroll reads.
model HrSalaryStructure {
  id            String   @id @default(cuid())
  employeeId    String
  effectiveFrom DateTime @db.Date
  annualCtc     Decimal  @db.Decimal(18, 2)
  monthlyCtc    Decimal  @db.Decimal(18, 2)
  basicPct      Int      @default(50)
  note          String?
  // Snapshot of the resolved monthly breakdown at save time:
  // [{ code, name, kind, monthly, taxable, statutory }]
  lines         Json
  isCurrent     Boolean  @default(true)
  createdById   String?
  createdAt     DateTime @default(now())

  @@index([employeeId, isCurrent])
  @@index([employeeId, effectiveFrom])
}

model HrPayrollRun {
  id              String      @id @default(cuid())
  entityId        String      @default("BILLION")
  fy              String // e.g. "2026-27"
  month           Int // calendar month 1..12
  label           String // "Jul 2026"
  status          String      @default("DRAFT") // DRAFT | LOCKED | PAID
  totalGross      Decimal     @default(0) @db.Decimal(18, 2)
  totalDeductions Decimal     @default(0) @db.Decimal(18, 2)
  totalNet        Decimal     @default(0) @db.Decimal(18, 2)
  headcount       Int         @default(0)
  createdById     String?
  createdAt       DateTime    @default(now())
  lockedAt        DateTime?
  payslips        HrPayslip[]

  @@unique([entityId, fy, month])
  @@index([status])
}

model HrPayslip {
  id              String       @id @default(cuid())
  runId           String
  run             HrPayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId      String
  empCodeSnap     String
  nameSnap        String
  paidDays        Decimal      @default(30) @db.Decimal(6, 2)
  lopDays         Decimal      @default(0) @db.Decimal(6, 2)
  gross           Decimal      @db.Decimal(18, 2)
  earnings        Json // [{ code, name, amount }]
  deductions      Json // [{ code, name, amount }]
  pf              Decimal      @default(0) @db.Decimal(18, 2)
  esi             Decimal      @default(0) @db.Decimal(18, 2)
  pt              Decimal      @default(0) @db.Decimal(18, 2)
  tds             Decimal      @default(0) @db.Decimal(18, 2)
  gratuityAccrued Decimal      @default(0) @db.Decimal(18, 2)
  net             Decimal      @db.Decimal(18, 2)
  createdAt       DateTime     @default(now())

  @@unique([runId, employeeId])
  @@index([employeeId])
}

// Monthly attendance sheet — the "attendance report → salary sheet" bridge.
// Auto-computed from AttendanceRecords + approved leaves, HR-editable from the
// backend, then FINALised so payroll reads LOP days from the truthful sheet.
model MonthlyAttendanceSheet {
  id          String   @id @default(cuid())
  entityId    String   @default("BILLION")
  fy          String // "2026-27"
  month       Int // calendar 1..12
  employeeId  String
  empCodeSnap String
  nameSnap    String
  workingDays Int      @default(0) // calendar working days in the month
  presentDays Decimal  @default(0) @db.Decimal(6, 2)
  leaveDays   Decimal  @default(0) @db.Decimal(6, 2) // approved (paid) leave
  lopDays     Decimal  @default(0) @db.Decimal(6, 2) // loss-of-pay → payroll
  status      String   @default("DRAFT") // DRAFT | FINAL
  edited      Boolean  @default(false) // HR corrected from the auto figures
  note        String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([entityId, fy, month, employeeId])
  @@index([fy, month])
  @@index([employeeId])
}

// Full-&-Final settlement on separation.
model HrFnfSettlement {
  id               String    @id @default(cuid())
  employeeId       String
  empCodeSnap      String
  nameSnap         String
  lastWorkingDay   DateTime  @db.Date
  status           String    @default("DRAFT") // DRAFT | APPROVED | PAID
  leaveEncashDays  Decimal   @default(0) @db.Decimal(6, 2)
  leaveEncashAmt   Decimal   @default(0) @db.Decimal(18, 2)
  gratuityAmt      Decimal   @default(0) @db.Decimal(18, 2)
  pendingSalaryAmt Decimal   @default(0) @db.Decimal(18, 2)
  noticeRecovery   Decimal   @default(0) @db.Decimal(18, 2)
  otherAdditions   Decimal   @default(0) @db.Decimal(18, 2)
  otherDeductions  Decimal   @default(0) @db.Decimal(18, 2)
  netPayable       Decimal   @default(0) @db.Decimal(18, 2)
  note             String?
  breakdown        Json?
  createdById      String?
  createdAt        DateTime  @default(now())
  approvedAt       DateTime?

  @@index([employeeId])
  @@index([status])
}
