  @@index([pixelId])
  @@index([type])
  @@index([occurredAt])
}

// ============================================================
// AI: ANOMALY DETECTION
// ============================================================

model AnomalyAlert {
  id               String    @id @default(cuid())
  type             String // REVENUE_DROP, REVENUE_SPIKE, LEAD_VOLUME_CHANGE, BOOKING_CANCELLATION_CLUSTER, PAYMENT_DELAY, CONVERSION_RATE_DROP
  severity         String // LOW, MEDIUM, HIGH, CRITICAL
  title            String
  description      String    @db.Text
  entityType       String? // Lead, Deal, Booking, Payment, etc.
  entityId         String?
  metric           String?
  expectedValue    Float?
  actualValue      Float?
  deviationPercent Float?
  detectedAt       DateTime  @default(now())
  acknowledgedAt   DateTime?
  acknowledgedById String?
  acknowledgedBy   User?     @relation("AnomalyAcknowledger", fields: [acknowledgedById], references: [id])
  resolvedAt       DateTime?
  isActive         Boolean   @default(true)

  @@index([type])
  @@index([severity])
  @@index([isActive])
  @@index([detectedAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
}

// ============================================================
// MOBILE APP: Device Tokens for Push Notifications
// ============================================================

model DeviceToken {
  id        String   @id @default(cuid())
  token     String   @unique
  platform  String // "ios" | "android"
  userId    String
  user      User     @relation("UserDeviceTokens", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ============================================================
// TELECALLING: Call Log for detailed call tracking
// ============================================================

model CallLog {
  id              String          @id @default(cuid())
  disposition     CallDisposition
  durationSeconds Int             @default(0)
  recordingUrl    String?
  externalCallId  String?
  notes           String?         @db.Text
  tags            String[]
  followUpDate    DateTime?
  followUpNotes   String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  communicationId String        @unique
  communication   Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  contactId       String
  contact         Contact       @relation(fields: [contactId], references: [id])
  agentId         String
  agent           User          @relation("AgentCallLogs", fields: [agentId], references: [id])

  @@index([contactId])
  @@index([agentId])
  @@index([disposition])
  @@index([createdAt])
  @@index([followUpDate])
}

// ============================================================
// API KEY: For external lead capture integrations
// ============================================================

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  keyHash    String
  prefix     String // First 8 chars for display
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  createdById String
  createdBy   User   @relation("UserApiKeys", fields: [createdById], references: [id])

  @@index([keyHash])
  @@index([isActive])
}

// ============================================================
// AUTO WELCOME: Per-source welcome message configuration
// ============================================================

model AutoWelcomeConfig {
  id           String     @id @default(cuid())
  leadSource   LeadSource @unique
  isEnabled    Boolean    @default(true)
  templateName String
  delayMinutes Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// ============================================================
// TELEPHONY: Cloud telephony provider configuration
// ============================================================

model TelephonyConfig {
  id            String            @id @default(cuid())
  provider      TelephonyProvider
  apiKey        String
  apiSecret     String?
  callerId      String
  accountSid    String?
  subdomain     String?
  webhookSecret String?
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  createdById String
  createdBy   User   @relation("UserTelephonyConfigs", fields: [createdById], references: [id])

  @@index([isActive])
}

// ============================================================
// LEAD CAPTURE CONFIG: Platform credentials for lead webhooks
// ============================================================

model LeadCaptureConfig {
  id          String              @id @default(cuid())
  platform    LeadCapturePlatform @unique
  credentials Json
  isActive    Boolean             @default(true)
  lastSyncAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([platform, isActive])
}

// ============================================================
// WHATSAPP CONFIG: Meta WhatsApp Cloud API credentials
// ============================================================

model WhatsAppConfig {
  id                String   @id @default(cuid())
  accessToken       String   @db.Text
  phoneNumberId     String
  businessAccountId String
  appSecret         String?
  verifyToken       String   @default("veloria_whatsapp_verify")
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  createdById String
  createdBy   User   @relation("UserWhatsAppConfigs", fields: [createdById], references: [id])

  @@index([isActive])
}

// ============================================================
// OWNER-SIDE B2B CRM — Hall Owner acquisition funnel (spec §13)
// ============================================================

enum HallOwnerStatus {
  PROSPECT
  CONTACT_MADE
  SITE_INSPECTION
  NEGOTIATION
  CONTRACT_DRAFTED
  SIGNED
  ONBOARDED
  RENEWAL
  CHURNED
}

enum CommercialModel {
  REVENUE_SHARE
  FIXED_LEASE
  HYBRID
  MANAGEMENT_FEE
}

enum PropertyType {
  BANQUET_HALL
  CONVENTION_CENTER
  MARRIAGE_GARDEN
  MIXED
}

enum OwnershipStatus {
  SELF_OWNED
  LEASED
  FAMILY_PROPERTY
}

// ============================================================
// People P2 — Timesheets, OKRs, Engagement pulse surveys.
// Plain userId refs (denormalized, no User back-relation) to stay additive.
// ============================================================
model Timesheet {
  id           String            @id @default(cuid())
  userId       String
  weekStart    DateTime          @db.Date // Monday of the week
  status       String            @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | REJECTED
  submittedAt  DateTime?
  approvedById String?
  approvedAt   DateTime?
  note         String?           @db.Text
  entries      TimesheetEntry[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([userId, weekStart])
  @@index([userId])
  @@index([status])
}

model TimesheetEntry {
  id          String    @id @default(cuid())
  timesheetId String
  timesheet   Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  date        DateTime  @db.Date
  hours       Decimal   @db.Decimal(5, 2)
  project     String?
  notes       String?

  @@index([timesheetId])
}

model Objective {
  id          String      @id @default(cuid())
  ownerId     String // whose objective (userId)
  title       String
  description String?     @db.Text
  period      String // e.g. 'Q3-2026' or 'YYYY-MM'
  status      String      @default("ACTIVE") // ACTIVE | DONE | ARCHIVED
  progress    Int         @default(0) // 0-100, derived from key results
  keyResults  KeyResult[]
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([ownerId])
  @@index([period])
}

model KeyResult {
  id          String    @id @default(cuid())
  objectiveId String
  objective   Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  title       String
  target      Decimal?  @db.Decimal(12, 2)
  current     Decimal?  @db.Decimal(12, 2)
  unit        String? // e.g. '₹', '%', 'bookings'
  progress    Int       @default(0) // 0-100

  @@index([objectiveId])
}

model PulseSurvey {
  id          String          @id @default(cuid())
  title       String
  question    String          @db.Text
  isActive    Boolean         @default(true)
  createdById String?
  responses   PulseResponse[]
  createdAt   DateTime        @default(now())

  @@index([isActive])
}

model PulseResponse {
  id        String      @id @default(cuid())
  surveyId  String
  survey    PulseSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  userId    String
  score     Int // 1-5
  comment   String?     @db.Text
  createdAt DateTime    @default(now())

  @@unique([surveyId, userId])
  @@index([surveyId])
}

// ============================================================
// Performance — 1:1 Coaching / check-in log (A-player operating rhythm).
// The manager↔report conversation that turns KRA/Velos/dashboard numbers into
// action: a win, the one focus area, an agreed next step, and a follow-up.
// ============================================================
model CoachingNote {
  id         String    @id @default(cuid())
  subjectId  String // the team member this check-in is about
  subject    User      @relation("CoachingSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  managerId  String // who logged it
  manager    User      @relation("CoachingManager", fields: [managerId], references: [id])
  period     String // 'YYYY-MM'
  win        String?   @db.Text // what went well
  focus      String?   @db.Text // the one thing to improve
  actionItem String?   @db.Text // agreed next step
  rating     Int? // optional 1-5 pulse
  followUpAt DateTime?
  status     String    @default("OPEN") // OPEN | DONE
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([subjectId])
  @@index([managerId])
  @@index([status, followUpAt])
}

model HallOwner {
  id                      String           @id @default(cuid())
  ownerName               String
  // Hard links back to the BD deal/property that created this owner (set on
  // deal-won auto-provision; nullable for owners created directly).
  dealId                  String?
  propertyId              String?
  companyName             String?
  email                   String?
  phone                   String?
  whatsapp                String?
  gstin                   String?
  numberOfHalls           Int?
  totalCapacity           Int?
  propertyCity            String?
  propertyType            PropertyType?
  ownershipStatus         OwnershipStatus?
  commercialModel         CommercialModel?
  revenueSharePercent     Decimal?         @db.Decimal(5, 2)
  minimumMonthlyGuarantee Decimal?         @db.Decimal(14, 2)
  contractStatus          HallOwnerStatus  @default(PROSPECT)
  contractStartDate       DateTime?
  contractEndDate         DateTime?
  notes                   String?          @db.Text
  deletedAt               DateTime?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  bdOwnerId String?
  bdOwner   User?   @relation("HallOwnerBD", fields: [bdOwnerId], references: [id])

  @@index([contractStatus])
  @@index([bdOwnerId])
  @@index([deletedAt])
}

// ============================================================
// BD / Property Acquisition CRM (VELORIA_ACQUISITION_CRM_SPEC)
// Lead → Deal → Property lifecycle. Namespaced with `Acq` to stay
// fully separate from the Sales CRM's Lead/Deal/Booking models.
// ============================================================

enum AcqLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DISQUALIFIED
}

enum AcqOwnerType {
  SOLE_OWNER
  PARTNER
  GPA_HOLDER
  MANAGER
}

enum AcqPropertyType {
  BANQUET
  MARRIAGE_HALL
  CONVENTION_CENTRE
  RESORT
  LAWN
}

enum AcqLeadSource {
  WEBSITE
  REFERRAL
  BROKER
  COLD_CALL
  SOCIAL_MEDIA
  WALK_IN
  OTHER
}

// Development/operational stage of the property a lead is about.
enum AcqPropertyStage {
  OPERATIONAL // already a running venue
  CONVERSION // existing building being converted to a venue
  BROWNFIELD // redeveloping an existing site
  GREENFIELD // new build on undeveloped land
}

// Seating-capacity bucket for quick filtering/qualification.
enum AcqSeatingRange {
  R_50_100
  R_100_150
  R_150_200
  R_200_300
  R_300_500
  R_500_PLUS
}

enum AcqDealStage {
  QUALIFIED
  EVALUATION
  EVALUATION_COMPLETED
  PROPOSAL_SENT
  NEGOTIATION
  CONTRACT_SENT
  SIGNED
  WON
  LOST
  ON_HOLD
}

enum AcqDealModel {
  MANAGEMENT
  FRANCHISE
}

enum AcqContractStatus {
  NOT_SENT
  SENT
  SIGNED
}

enum AcqPropertyStatus {
  ONBOARDING
  AVAILABLE
  ACTIVE
  PAUSED
  OFF_BOARDED
}

enum AcqDisqualifyReason {
  WANTS_OUTRIGHT_RENT_ONLY
  COMPETITOR_EXCLUSIVE
  VENUE_NOT_OPERATIONAL
  NOT_DECISION_MAKER
  UNREALISTIC_EXPECTATIONS
  NO_RESPONSE_5_DAYS
  OUT_OF_GEOGRAPHY
  OTHER
}

enum AcqLostReason {
  HIGH_COMMISSION
  COMPETITOR_SELECTED
  WANTED_OUTRIGHT_RENT
  LOCKIN_TOO_LONG
  BUDGET_PRICING
  NO_RESPONSE
  VENUE_QUALITY_BELOW_STANDARD
  OTHER
}

model AcqLead {
  id                  String               @id @default(cuid())
  ownerName           String
  mobilePrimary       String // E.164 normalized
  mobileAlternate     String?
  email               String?
  propertyName        String
  propertyType        AcqPropertyType
  city                String
  locality            String
  seatingTheatre      Int?
  seatingFloating     Int?
  seatingRange        AcqSeatingRange? // bucketed capacity (50-100, 100-150, …)
  propertyStage       AcqPropertyStage? // operational / conversion / brownfield / greenfield
  notes               String?              @db.Text
  parkingAvailable    Boolean? // is on-site parking available at the property
  // Referral / broker source capture (when leadSource indicates a referral/broker).
  referrerName        String?
  referrerPhone       String?
  referrerEmail       String?
  brokerageDemand     String? // e.g. "2% of deal value" or "₹50,000 flat"
  // Qualification checklist (§ qualify gate) — persisted so the lead dashboard
  // can show progress toward qualification.
  qualSeating100      Boolean?
  qualOwnerInterested Boolean?
  qualAgreeRenovate   Boolean?
  qualPhotosReady     Boolean?
  leadSource          AcqLeadSource
  ownerType           AcqOwnerType
  bdExecutiveId       String
  bdExecutive         User                 @relation("AcqLeadBdExec", fields: [bdExecutiveId], references: [id])
  status              AcqLeadStatus        @default(NEW)
  disqualifyReason    AcqDisqualifyReason?
  contactAttempts     Int                  @default(0)
  nextFollowupAt      DateTime?
  firstContactDue     DateTime
  firstContactAt      DateTime? // when the lead was first actually contacted — clears the SLA
  slaEscalatedAt      DateTime? // set when an overdue first-contact SLA was escalated (idempotency)
  convertedDealId     String? // set on qualify (denormalized; deal.leadId is authoritative)
  deal                AcqDeal?             @relation("AcqDealOrigin")
  activities          AcqLeadActivity[]
  siteVisits          AcqSiteVisit[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?

  @@index([status])
  @@index([city])
  @@index([bdExecutiveId])
  @@index([mobilePrimary])
  @@index([deletedAt])
}

// Contact-log / activity timeline for a BD lead (channel + outcome + note per touch).
model AcqLeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      AcqLead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel   String // CALL | WHATSAPP | EMAIL | VISIT | NOTE
  outcome   String? // CONNECTED | NO_ANSWER | INTERESTED | NOT_INTERESTED | CALLBACK | ...
  note      String?  @db.Text
  actorId   String?
  actorName String?
  createdAt DateTime @default(now())

  @@index([leadId])
}

// Scheduled site visits / meetings for a BD lead. Created with a future
// scheduledAt; the BD/BA team later updates status + outcome notes once done.
model AcqSiteVisit {
  id             String    @id @default(cuid())
  leadId         String
  lead           AcqLead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type           String    @default("SITE_VISIT") // SITE_VISIT | MEETING
  scheduledAt    DateTime
  location       String?
  agenda         String?   @db.Text
  assignedToId   String? // BD/BA executive (denormalized — no FK, mirrors AcqLeadActivity)
  assignedToName String?
  status         String    @default("SCHEDULED") // SCHEDULED | COMPLETED | CANCELLED | NO_SHOW | RESCHEDULED
  outcomeNotes   String?   @db.Text
  completedAt    DateTime?
  createdById    String?
  createdByName  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([leadId])
  @@index([scheduledAt])
  @@index([status])
}

model AcqDeal {
  id     String       @id @default(cuid())
  name   String
  images String[] // property photos captured on the deal, shown on the property
  leadId String       @unique
  lead   AcqLead      @relation("AcqDealOrigin", fields: [leadId], references: [id])
  stage  AcqDealStage @default(QUALIFIED)

  // Owner + venue snapshot (copied from lead at creation)
  ownerName       String
  ownerType       AcqOwnerType
  propertyName    String
  propertyType    AcqPropertyType
  city            String
  locality        String
  seatingTheatre  Int?
  seatingFloating Int?

  // Venue economics
  ownerCurrentMonthlyRevenue Decimal? @db.Decimal(12, 2)
  avgEventsPerMonth          Decimal? @db.Decimal(6, 2)
  peakRateCard               Decimal? @db.Decimal(12, 2)

  banquetSizeSft Int? // venue size (sqft) — shown on the board card

  // Commercials
  model                 AcqDealModel?
  baseFeePct            Decimal?      @db.Decimal(5, 2)
  incentivePct          Decimal?      @db.Decimal(5, 2)
  royaltyPct            Decimal?      @db.Decimal(5, 2)
  termYears             Int?
  lockinYears           Int?
  isExclusive           Boolean?
  expectedMonthlyEvents Decimal?      @db.Decimal(6, 2)
  projectedFeeValue     Decimal?      @db.Decimal(12, 2)
  // Once frozen, base fee / incentive / term are locked (post-agreement).
  economicsFrozenAt     DateTime?

  // Scoring
  evalScore  Int?
  evalPassed Boolean?

  // Contract
  contractStatus             AcqContractStatus @default(NOT_SENT)
  signatoryAuthorityVerified Boolean           @default(false)
  gpaDocumentUrl             String?

  // Approvals
  bdHeadApprovedById   String?
  bdHeadApprovedBy     User?     @relation("AcqDealBdHeadApprover", fields: [bdHeadApprovedById], references: [id])
  bdHeadApprovedAt     DateTime?
  // Distinct large-deal (≥ threshold) sign-off, separate from below-floor approval.
  largeDealSignoffById String?
  largeDealSignoffAt   DateTime?

  // Outcome
  lostReason AcqLostReason?
  reengageAt DateTime?
  wonAt      DateTime?
  propertyId String? // denormalized; property.dealId is authoritative
  property   AcqProperty?   @relation("AcqDealProperty")

  expectedCloseDate      DateTime?
  // Deal-preview commercial dates/fees (BD CRM)
  expectedSigningDate    DateTime?
  taFees                 Decimal?  @db.Decimal(12, 2) // transaction-advisory / brokerage fees
  expectedCollectionDate DateTime?
  bdExecutiveId          String
  bdExecutive            User      @relation("AcqDealBdExec", fields: [bdExecutiveId], references: [id])
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  evaluations AcqEvaluation[]
  attachments AcqAttachment[]
  notes       AcqDealNote[]
  projections AcqProjection[]

  @@index([stage])
  @@index([bdExecutiveId])
  @@index([deletedAt])
}

model AcqProperty {
  id                String            @id @default(cuid())
  dealId            String            @unique
  deal              AcqDeal           @relation("AcqDealProperty", fields: [dealId], references: [id])
  propertyName      String
  propertyType      AcqPropertyType
  ownerName         String
  address           String?
  city              String
  locality          String
  // The bookable Venue created when this property is published (BD → Bookings bridge).
  venueId           String?
  seatingTheatre    Int?
  seatingFloating   Int?
  parkingAvailable  Boolean?
  status            AcqPropertyStatus @default(ONBOARDING)
  acquisitionDate   DateTime
  propertyManagerId String?
  propertyManager   User?             @relation("AcqPropertyManager", fields: [propertyManagerId], references: [id])
  availableAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  onboardingProject AcqOnboardingProject?

  @@index([status])
  @@index([deletedAt])
}

model AcqEvaluation {
  id               String   @id @default(cuid())
  dealId           String
  deal             AcqDeal  @relation(fields: [dealId], references: [id])
  capacityScore    Int
  parkingScore     Int
  kitchenScore     Int
  roomsScore       Int
  conditionScore   Int
  locationScore    Int
  avAmenitiesScore Int
  totalScore       Int
  passed           Boolean
  notes            String?
  evaluatedById    String
  evaluatedBy      User     @relation("AcqEvaluationBy", fields: [evaluatedById], references: [id])
  createdAt        DateTime @default(now())

  @@index([dealId])
}

model AcqAttachment {
  id           String   @id @default(cuid())
  dealId       String
  deal         AcqDeal  @relation(fields: [dealId], references: [id])
  kind         String // PHOTO | DOCUMENT | AGREEMENT | GPA
  label        String?
  url          String
  uploadedById String
  uploadedBy   User     @relation("AcqAttachmentBy", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([dealId])
  @@index([dealId, kind])
}

// ============================================================
// BD CONTRACTS — standalone contract-lifecycle module (CLM)
// User/deal references are plain ids (no FK) to keep this self-contained.
// ============================================================
enum AcqContractPhase {
  AUTHORING
  APPROVAL
  NEGOTIATION
  EXECUTION
  POST_EXECUTION
}

enum AcqContractLifecycle {
  DRAFT
  APPROVED
  NEGOTIATED
  SIGNED
  ACTIVE
  TERMINATED
}

model AcqContract {
  id             String   @id @default(cuid())
  contractNumber String? // VG-CON-YYYY-NNN (generated server-side)
  title          String
  dealId         String? // source deal (create-from-deal)
  ownerName      String
  ownerEmail     String?
  ownerPhone     String?
  propertyName   String
  model          String? // MANAGEMENT | FRANCHISE
  baseFeePct     Decimal? @db.Decimal(5, 2)
  incentivePct   Decimal? @db.Decimal(5, 2)
  termYears      Int?
  contractValue  Decimal? @db.Decimal(14, 2)
  body           String?  @db.Text

  phase  AcqContractPhase     @default(AUTHORING)
  status AcqContractLifecycle @default(DRAFT)

  signByDate          DateTime? // target signing date (calendar)
  signedAt            DateTime?
  startDate           DateTime?
  endDate             DateTime?
  terminatedAt        DateTime?
  terminationGainLoss Decimal?  @db.Decimal(14, 2) // +gain / -loss

  approvedById   String?
  approvedAt     DateTime?
  esignProvider  String?
  esignRequestId String?
  esignStatus    String? // SENT | SIGNED | DECLINED

  bdExecutiveId String
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  documents  AcqContractDocument[]
  activities AcqContractActivity[]
  versions   AcqContractVersion[]

  @@index([status])
  @@index([phase])
  @@index([signByDate])
  @@index([deletedAt])
}

model AcqContractDocument {
  id           String      @id @default(cuid())
  contractId   String
  contract     AcqContract @relation(fields: [contractId], references: [id])
  label        String?
  url          String      @db.Text // uploaded file as data-URL or external https link
  fileName     String?
  mimeType     String?
  uploadedById String
  createdAt    DateTime    @default(now())

  @@index([contractId])
}

// Cross-team introduction meeting scheduled after a BD contract is signed,
// to align Design / Projects / Sales / Operations on a newly acquired property.
// Refs stored as plain scalars (no FK relations) to stay fully additive.
model IntroductionMeeting {
  id             String   @id @default(cuid())
  dealId         String?
  projectId      String?
  propertyName   String
  scheduledAt    DateTime
  location       String?
  agenda         String?  @db.Text
  status         String   @default("SCHEDULED") // SCHEDULED | COMPLETED | CANCELLED | RESCHEDULED
  teamDesign     Boolean  @default(true)
  teamProjects   Boolean  @default(true)
  teamSales      Boolean  @default(true)
  teamOperations Boolean  @default(true)
  attendeeIds    String[] // invited user ids (notified)
  scheduledById  String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([dealId])
  @@index([projectId])
  @@index([scheduledAt])
  @@index([status])
}

model AcqContractActivity {
  id         String      @id @default(cuid())
  contractId String
  contract   AcqContract @relation(fields: [contractId], references: [id])
  type       String // AUTHORED | APPROVED | NEGOTIATION | SENT_FOR_SIGN | SIGNED | ACTIVATED | TERMINATED | NOTE
  detail     String?
  actorId    String
  createdAt  DateTime    @default(now())

  @@index([contractId])
  @@index([type])
}

// Version history of the contract body (each saved draft is snapshotted).
model AcqContractVersion {
  id          String      @id @default(cuid())
  contractId  String
  contract    AcqContract @relation(fields: [contractId], references: [id])
  version     Int
  body        String      @db.Text
  createdById String
  createdAt   DateTime    @default(now())

  @@index([contractId])
}

model AcqDealNote {
  id        String   @id @default(cuid())
  dealId    String
  deal      AcqDeal  @relation(fields: [dealId], references: [id])
  noteType  String // NEGOTIATION | INTERNAL | GENERAL
  body      String
  authorId  String
  author    User     @relation("AcqDealNoteAuthor", fields: [authorId], references: [id])
  createdAt DateTime @default(now())

  @@index([dealId])
}

model AcqOnboardingProject {
  id               String      @id @default(cuid())
  propertyId       String      @unique
  property         AcqProperty @relation(fields: [propertyId], references: [id])
  status           String      @default("OPEN") // OPEN | ON_HOLD | COMPLETED | CANCELLED
  // 9-stage Projects pipeline (stored as strings; legacy values normalised in app):
  // HANDOFF → ASSESSMENT → CAPEX → EXECUTION → INTERNAL_QC → OPS_AUDIT → FINAL_GO_AHEAD → HANDOVER → LIVE
  phase            String      @default("HANDOFF")
  projectManagerId String?
  projectManager   User?       @relation("ProjectManager", fields: [projectManagerId], references: [id])

  // Venue master data (drives the CapEx calculator + spec sheet)
  ownerContact   String?
  fundingModel   String? // OWNER | VELORIA | SPLIT
  splitRatio     Decimal?  @db.Decimal(5, 2) // owner's % when SPLIT
  hallCount      Int?
  totalCapacity  Int?
  totalSqft      Int?
  dealClosedDate DateTime?
  bdOwnerId      String?
  bdOwner        User?     @relation("ProjectBdOwner", fields: [bdOwnerId], references: [id])

  targetReadyDate       DateTime? // target launch date
  startedAt             DateTime? // execution started
  handoffAcceptedAt     DateTime?
  assessmentDoneAt      DateTime?
  ownerApproved         Boolean   @default(false)
  ownerApprovedAt       DateTime?
  ownerApprovalProofUrl String?
  qcReadyAt             DateTime? // PM marked ready for ops audit (internal QC done)
  opsAuditRequestedAt   DateTime?
  opsAuditPassedAt      DateTime?
  opsAuditById          String?
  opsAuditBy            User?     @relation("ProjectOpsAuditor", fields: [opsAuditById], references: [id])
  finalGoAheadAt        DateTime?
  finalGoAheadById      String?
  finalGoAheadBy        User?     @relation("ProjectFinalGoAhead", fields: [finalGoAheadById], references: [id])
  handoverReportAt      DateTime?
  handoverById          String?
  handoverBy            User?     @relation("ProjectHandover", fields: [handoverById], references: [id])
  opsAcknowledgedAt     DateTime?
  mgmtAcknowledgedAt    DateTime?
  launchedAt            DateTime? // LIVE
  notes                 String?   @db.Text
  createdAt             DateTime  @default(now())
  completedAt           DateTime?
  updatedAt             DateTime  @default(now()) @updatedAt

  tasks            AcqOnboardingTask[]
  readinessItems   VenueReadinessItem[]
  opsAuditItems    OpsAuditItem[]
  capexProjections AcqCapexProjection[]
  signOffs         ProjectSignOff[]
  auditLogs        ProjectAuditLog[]
  snags            ProjectSnag[]
  photos           ProjectPhoto[]
  workPackages     ProjectWorkPackage[]
  purchaseOrders   ProjectPurchaseOrder[]

  @@index([status])
  @@index([phase])
}

// The defect register — the heart of QC + the Ops deep audit.
// open → in_progress → fixed_pending_verification → verified_closed (Ops-only) ; reopened.
model ProjectSnag {
  id               String               @id @default(cuid())
  projectId        String
  project          AcqOnboardingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title            String
  description      String?              @db.Text
  category         String
  location         String? // e.g. "Hall A — east wall"
  severity         String               @default("MAJOR") // CRITICAL | MAJOR | MINOR
  raisedInStage    String               @default("INTERNAL_QC") // INTERNAL_QC | OPS_AUDIT
  raisedById       String?
  raisedByName     String?
  assignedVendorId String? // populated in Wave D
  dueDate          DateTime?
  status           String               @default("OPEN") // OPEN | IN_PROGRESS | FIXED_PENDING_VERIFICATION | VERIFIED_CLOSED | REOPENED
  fixedPendingAt   DateTime? // when the current fix cycle was marked fixed — scopes the after-photo gate
  verifiedById     String?
  verifiedByName   String?
  verifiedAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @default(now()) @updatedAt
  photos           ProjectPhoto[]

  @@index([projectId])
  @@index([status])
}

// Photos / attachments (snag before/after, readiness evidence, general gallery).
model ProjectPhoto {
  id             String               @id @default(cuid())
  projectId      String
  project        AcqOnboardingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  snagId         String?
  snag           ProjectSnag?         @relation(fields: [snagId], references: [id], onDelete: Cascade)
  entityType     String               @default("snag") // snag | readiness | general
  entityId       String?
  kind           String               @default("DURING") // BEFORE | DURING | AFTER
  url            String               @db.Text // image/PDF data-URL or https link
  caption        String?
  uploadedById   String?
  uploadedByName String?
  createdAt      DateTime             @default(now())

  @@index([projectId])
  @@index([snagId])
}

// Generic gate sign-off record — one per stage transition that needs approval.
model ProjectSignOff {
  id         String               @id @default(cuid())
  projectId  String
  project    AcqOnboardingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage      String // the stage being signed off / gate cleared
  decision   String // APPROVED | REJECTED | REOPENED
  approverId String
  approver   User                 @relation("SignOffApprover", fields: [approverId], references: [id])
  comment    String?              @db.Text
  createdAt  DateTime             @default(now())

  @@index([projectId])
}

// Append-only audit trail (who / what / when / before→after). Never updated or deleted.
// projectId is nullable + SetNull so the trail survives a soft-deleted project.
model ProjectAuditLog {
  id         String                @id @default(cuid())
  projectId  String?
  project    AcqOnboardingProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  actorId    String?
  actorName  String? // denormalised snapshot, survives user changes
  action     String // e.g. "phase.advance", "snag.verify_closed"
  entityType String
  entityId   String
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime              @default(now())

  @@index([projectId])
  @@index([entityType, entityId])
}

// A venue-readiness checklist line (interiors, bathrooms, fire-safety, lift…)
// against a Veloria Grand standard. Seeded per project from config.
model VenueReadinessItem {
  id        String               @id @default(cuid())
  projectId String
  project   AcqOnboardingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category  String
  title     String
  standard  String               @db.Text
  severity  String               @default("MAJOR") // CRITICAL | MAJOR | MINOR — severity if this standard fails
  status    String               @default("PENDING") // PENDING | IN_PROGRESS | DONE | NA
  notes     String?              @db.Text
  order     Int                  @default(0)
  updatedAt DateTime             @default(now()) @updatedAt

  @@index([projectId])
}

// Operations deep-audit line, run before launch sign-off.
model OpsAuditItem {
  id        String               @id @default(cuid())
  projectId String
  project   AcqOnboardingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category  String
  title     String
  critical  Boolean              @default(false)
  status    String               @default("PENDING") // PENDING | PASS | FAIL | NA
  notes     String?              @db.Text
  order     Int                  @default(0)
  updatedAt DateTime             @default(now()) @updatedAt

  @@index([projectId])
}

// CapEx budget + timeline projection for readying a venue (mirrors AcqProjection).
enum CapexStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  REJECTED
}

model AcqCapexProjection {
  id             String               @id @default(cuid())
  projectId      String
  project        AcqOnboardingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version        Int                  @default(1)
  status         CapexStatus          @default(DRAFT)
  inputsJson     Json // CapexInput
  outputsJson    Json? // CapexResult, frozen at approval
  totalCapex     Decimal              @default(0) @db.Decimal(14, 2)
  estimatedWeeks Int                  @default(0)
  notes          String?              @db.Text
  pdfUrl         String?

  submittedById  String?
  submittedBy    User?     @relation("CapexSubmittedBy", fields: [submittedById], references: [id])
  submittedAt    DateTime?
  approvedById   String?
  approvedBy     User?     @relation("CapexApprovedBy", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  rejectedReason String?
  shareToken     String? // opaque token for the owner's no-login PDF link, set at approval
  sentChannel    String?
  sentTo         String?
  sentById       String?
  sentBy         User?     @relation("CapexSentBy", fields: [sentById], references: [id])
  sentAt         DateTime?

  createdById String
  createdBy   User     @relation("CapexCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([status])
}

model AcqOnboardingTask {
  id         String               @id @default(cuid())
  projectId  String
  project    AcqOnboardingProject @relation(fields: [projectId], references: [id])
  title      String
  done       Boolean              @default(false)
  assigneeId String?
  assignee   User?                @relation("AcqOnboardingAssignee", fields: [assigneeId], references: [id])
  createdAt  DateTime             @default(now())

  @@index([projectId])
}

model AcqStageTransition {
  id        String   @id @default(cuid())
  entity    String // DEAL | LEAD | PROPERTY
  entityId  String
  fromState String?
  toState   String
  actorId   String
  actor     User     @relation("AcqStageTransitionActor", fields: [actorId], references: [id])
  reason    String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

model AcqConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// ============================================================
// BD CRM — Owner Projection Calculator (5-year revenue projection)
// ============================================================

enum AcqProjectionModel {
  WITH_FOOD
  WITHOUT_FOOD
}

enum AcqProjectionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  REJECTED
}

enum AcqProjectionSendMethod {
  EMAIL_APP
  MANUAL_DOWNLOAD
}

model AcqProjection {
  id          String              @id @default(cuid())
  dealId      String
  deal        AcqDeal             @relation(fields: [dealId], references: [id])
  version     Int                 @default(1)
  modelType   AcqProjectionModel
  status      AcqProjectionStatus @default(DRAFT)
  inputsJson  Json // raw BD-entered inputs
  outputsJson Json? // full 5yr base+best grid; frozen at APPROVED
  pdfUrl      String?

  // approval
  submittedById  String?
  submittedBy    User?     @relation("AcqProjectionSubmittedBy", fields: [submittedById], references: [id])
  submittedAt    DateTime?
  approvedById   String?
  approvedBy     User?     @relation("AcqProjectionApprovedBy", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  rejectedReason String?

  // send
  sendMethod  AcqProjectionSendMethod?
  sentChannel String?
  sentTo      String?
  sentById    String?
  sentBy      User?                    @relation("AcqProjectionSentBy", fields: [sentById], references: [id])
  sentAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transitions AcqProjectionTransition[]

  @@index([dealId])
  @@index([status])
}

model AcqProjectionTransition {
  id           String        @id @default(cuid())
  projectionId String
  projection   AcqProjection @relation(fields: [projectionId], references: [id])
  fromStatus   String?
  toStatus     String
  actorId      String
  actor        User          @relation("AcqProjectionTransitionActor", fields: [actorId], references: [id])
  note         String?
  createdAt    DateTime      @default(now())

  @@index([projectionId])
}

// ============================================================
// SALES CRM — Quotation Calculator (mirrors AcqProjection)
// Sales rep builds a quote with the calculator → submits → a sales
// manager/head approves → it can be viewed/downloaded/emailed/whatsapped.
// inputsJson holds the raw calculator input; outputsJson is the frozen
// computed result (lines + totals + payment schedule) snapshotted at
// approval so the customer-facing PDF can never drift from the engine.
// ============================================================

enum SalesQuotationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  REJECTED
}

enum SalesQuotationSendMethod {
  EMAIL
  WHATSAPP
  MANUAL_DOWNLOAD
}

model SalesQuotation {
  id          String               @id @default(cuid())
  quoteNumber String // monotonic VG-Q-NNNNN allocated inside a Serializable txn (no @unique → db push stays non-destructive)
  version     Int                  @default(1)
  status      SalesQuotationStatus @default(DRAFT)

  // Calculator snapshot
  inputsJson  Json // QuotationInput
  outputsJson Json? // QuotationResult, frozen at APPROVED

  // Denormalised headline figures for list views / sorting
  clientName  String?
  clientPhone String?
  clientEmail String?
  occasion    String?
  eventDate   DateTime?
  timeSlot    String?
  guestCount  Int       @default(0)
  subtotal    Decimal   @default(0) @db.Decimal(12, 2)
  discountPct Decimal   @default(0) @db.Decimal(5, 2)
  taxAmount   Decimal   @default(0) @db.Decimal(12, 2)
  grandTotal  Decimal   @default(0) @db.Decimal(12, 2)
  notes       String?   @db.Text

  pdfUrl String?

  // Slot booking (BookMyShow-style): when the customer commits, we create a
  // HOLD Booking for the venue+date+slot. bookingId references that Booking
  // (plain ref, not a relation, to avoid widening the Booking model).
  bookingId     String?
  slotBlockedAt DateTime?
  invoiceId     String? // booking-advance invoice generated from this quote

  // Approval
  submittedById  String?
  submittedBy    User?     @relation("SalesQuotationSubmittedBy", fields: [submittedById], references: [id])
  submittedAt    DateTime?
  approvedById   String?
  approvedBy     User?     @relation("SalesQuotationApprovedBy", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  rejectedReason String?

  // Send
  sendMethod  SalesQuotationSendMethod?
  sentChannel String?
  sentTo      String?
  sentById    String?
  sentBy      User?                     @relation("SalesQuotationSentBy", fields: [sentById], references: [id])
  sentAt      DateTime?

  // Relations
  leadId      String?
  lead        Lead?    @relation(fields: [leadId], references: [id])
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id])
  venueId     String?
  venue       Venue?   @relation("SalesQuotationVenue", fields: [venueId], references: [id])
  createdById String
  createdBy   User     @relation("SalesQuotationCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transitions    SalesQuotationTransition[]
  quoteGroupId   String?
  tierLabel      String?
  shareLinkToken String?

  @@index([status])
  @@index([leadId])
  @@index([contactId])
  @@index([createdAt])
}

model SalesQuotationTransition {
  id          String         @id @default(cuid())
  quotationId String
  quotation   SalesQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  fromStatus  String?
  toStatus    String
  actorId     String
  actor       User           @relation("SalesQuotationTransitionActor", fields: [actorId], references: [id])
  note        String?
  createdAt   DateTime       @default(now())

  @@index([quotationId])
}

// ============================================================
// HR / People module — shared Identity & Org core (HR_MODULE_SPEC).
// Employee is the master record; it LINKS to User (does not fork it).
// All additive; multi-entity (LegalEntity) + BusinessVertical are separate dims.
// ============================================================

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum EmployeeStatus {
  ACTIVE
  ONBOARDING
  ON_LEAVE
  EXITED
  SUSPENDED
}

model LegalEntity {
  id             String     @id @default(cuid())
  name           String
  shortCode      String?
  isIncorporated Boolean    @default(true) // Nextura Ventures = partnership firm → false
  isActive       Boolean    @default(true)
  order          Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @default(now()) @updatedAt
  employees      Employee[]

  @@index([isActive])
}

model BusinessVertical {
  id        String     @id @default(cuid())
  name      String
  isActive  Boolean    @default(true)
  order     Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
  employees Employee[]

  @@index([isActive])
}

model Department {
  id        String     @id @default(cuid())
  name      String
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
  employees Employee[]

  @@index([isActive])
}

model HrDesignation {
  id        String     @id @default(cuid())
  name      String
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
  employees Employee[]

  @@index([isActive])
}

model Employee {
  id            String    @id @default(cuid())
  empCode       String    @unique
  firstName     String
  lastName      String
  personalEmail String?
  workEmail     String?
  phone         String?
  dob           DateTime?
  gender        String?
  photoUrl      String?

  // Identity link — the SAME user that other modules (Projects etc.) reference.
  userId String? @unique
  user   User?   @relation("EmployeeUser", fields: [userId], references: [id])

  // Two independent org dimensions.
  legalEntityId      String
  legalEntity        LegalEntity       @relation(fields: [legalEntityId], references: [id])
  businessVerticalId String?
  businessVertical   BusinessVertical? @relation(fields: [businessVerticalId], references: [id])
  departmentId       String?
  department         Department?       @relation(fields: [departmentId], references: [id])
  designationId      String?
  designation        HrDesignation?    @relation(fields: [designationId], references: [id])

  employmentType EmploymentType @default(FULL_TIME)
  dateOfJoining  DateTime?
  dateOfExit     DateTime?
  workLocation   String?
  status         EmployeeStatus @default(ONBOARDING)

  // Org chart / approval routing — self relation.
  reportingManagerId String?
  reportingManager   Employee?  @relation("EmployeeReports", fields: [reportingManagerId], references: [id])
  reports            Employee[] @relation("EmployeeReports")

  customFields Json? // admin-configurable extra fields
  notes        String?   @db.Text
  deletedAt    DateTime? // soft-delete only
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  statutory         EmployeeStatutory?
  emergencyContacts EmergencyContact[]
  education         EmployeeEducation[]
  workHistory       EmployeeWorkHistory[]
  leaveBalances     LeaveBalance[]
  leaveRequests     LeaveRequest[]            @relation("LeaveEmployee")
  leaveApprovals    LeaveRequest[]            @relation("LeaveApprover")
  compOffs          CompOff[]
  attendance        AttendanceRecord[]
  regularizations   Regularization[]          @relation("RegnEmployee")
  documents         HrDocument[]
  docAcks           DocumentAcknowledgement[]
  journeys          EmployeeJourney[]
  goals             Goal[]
  reviewsAbout      AppraisalReview[]         @relation("ReviewSubject")
  reviewsGiven      AppraisalReview[]         @relation("ReviewAuthor")
  shiftAssignments  ShiftAssignment[]
  swapRequests      ShiftSwapRequest[]        @relation("SwapRequester")
  swapTargets       ShiftSwapRequest[]        @relation("SwapTarget")

  @@index([legalEntityId])
  @@index([businessVerticalId])
  @@index([departmentId])
  @@index([reportingManagerId])
  @@index([status])
  @@index([deletedAt])
}

// Statutory PII — restricted access. Values are stored ENCRYPTED at rest (AES-GCM
// via the hr-crypto lib); never store plaintext PAN/Aadhaar/bank here.
model EmployeeStatutory {
  id             String   @id @default(cuid())
  employeeId     String   @unique
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  panEnc         String?
  aadhaarEnc     String?
  uan            String? // PF UAN (less sensitive — stored plain)
  esi            String?
  pf             String?
  pt             String?
  bankAccountEnc String?
  bankIfsc       String?
  updatedAt      DateTime @default(now()) @updatedAt
}

model EmergencyContact {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name       String
  relation   String?
  phone      String?
  createdAt  DateTime @default(now())

  @@index([employeeId])
}

model EmployeeEducation {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  institution String
  degree      String?
  year        Int?
  createdAt   DateTime @default(now())

  @@index([employeeId])
}

model EmployeeWorkHistory {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company    String
  title      String?
  fromDate   DateTime?
  toDate     DateTime?
  createdAt  DateTime  @default(now())

  @@index([employeeId])
}

// Admin-configurable custom fields for employees (no code needed to add a field).
// Definitions live here; values live in Employee.customFields JSON keyed by `key`.
enum HrFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  BOOLEAN
}

model HrCustomFieldDef {
  id        String      @id @default(cuid())
  key       String      @unique // stable machine key used in Employee.customFields
  label     String
  type      HrFieldType @default(TEXT)
  options   String? // comma-separated choices for SELECT
  required  Boolean     @default(false)
  isActive  Boolean     @default(true)
  order     Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt

  @@index([isActive])
}

// Employee-initiated profile change requests → HR approves (edit-approval flow).
enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model EmployeeChangeRequest {
  id          String              @id @default(cuid())
  employeeId  String
  requestedBy String // userId of requester
  changes     Json // { field: { from, to } }
  note        String?
  status      ChangeRequestStatus @default(PENDING)
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNote  String?
  createdAt   DateTime            @default(now())

  @@index([employeeId])
  @@index([status])
}

// ============================================================
// Leave / Time-off
// ============================================================
enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// FULL = whole day(s); halves only meaningful on the boundary days of a request.
enum HalfDayPart {
  FULL
  FIRST_HALF
  SECOND_HALF
}

model LeaveType {
  id               String   @id @default(cuid())
  name             String
  code             String   @unique // CL, SL, EL, COMP, LOP ...
  paid             Boolean  @default(true)
  accrualPerYear   Float    @default(0) // days credited per year (annual entitlement)
  carryForwardMax  Float    @default(0) // max days carried into next year
  allowHalfDay     Boolean  @default(true)
  allowNegative    Boolean  @default(false) // allow balance to go negative (→ LOP territory)
  requiresApproval Boolean  @default(true)
  color            String   @default("blue") // StatusPill hue
  isActive         Boolean  @default(true)
  order            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  balances LeaveBalance[]
  requests LeaveRequest[]

  @@index([isActive])
}

model Holiday {
  id            String   @id @default(cuid())
  date          DateTime
  name          String
  legalEntityId String? // null = applies to all entities
  location      String? // null = all locations
  year          Int
  createdAt     DateTime @default(now())

  @@index([year])
  @@index([legalEntityId])
}

model LeaveBalance {
  id             String    @id @default(cuid())
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId    String
  leaveType      LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  year           Int
  entitled       Float     @default(0)
  carriedForward Float     @default(0)
  used           Float     @default(0)
  pending        Float     @default(0)
  updatedAt      DateTime  @default(now()) @updatedAt

  @@unique([employeeId, leaveTypeId, year])
  @@index([employeeId, year])
}

model LeaveRequest {
  id           String             @id @default(cuid())
  employeeId   String
  employee     Employee           @relation("LeaveEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId  String
  leaveType    LeaveType          @relation(fields: [leaveTypeId], references: [id])
  startDate    DateTime
  endDate      DateTime
  startPart    HalfDayPart        @default(FULL)
  endPart      HalfDayPart        @default(FULL)
  days         Float // computed working days (excludes weekends + holidays)
  reason       String?
  status       LeaveRequestStatus @default(PENDING)
  approverId   String? // Employee id of the approver (org-chart manager or HR)
  approver     Employee?          @relation("LeaveApprover", fields: [approverId], references: [id])
  decidedAt    DateTime?
  decisionNote String?
  escalatedAt  DateTime? // set when auto-escalated past a stale approver
  // HRMS flowchart cutoff rule: applications on/before the 25th are "on time"
  // (green); after the 25th are auto-flagged late (red).
  appliedOnTime Boolean? // null = legacy/unknown
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @default(now()) @updatedAt

  @@index([employeeId])
  @@index([approverId])
  @@index([status])
  @@index([startDate])
}

enum CompOffStatus {
  AVAILABLE
  USED
  EXPIRED
}

model CompOff {
  id         String        @id @default(cuid())
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workedDate DateTime
  days       Float         @default(1)
  reason     String?
  expiryDate DateTime?
  status     CompOffStatus @default(AVAILABLE)
  createdAt  DateTime      @default(now())

  @@index([employeeId])
  @@index([status])
}

// ============================================================
// Attendance
// ============================================================
enum AttendanceSource {
  WEB
  MOBILE
  BIOMETRIC
  MANUAL
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  WFH
  ON_LEAVE
  HOLIDAY
  WEEKEND
}

// Allowed check-in locations: geo radius + optional IP allow-list.
model AttendanceSite {
  id            String   @id @default(cuid())
  name          String
  legalEntityId String? // null = any entity
  lat           Float?
  lng           Float?
  radiusMeters  Int      @default(200)
  allowedIps    String? // comma-separated CIDR-less IPs; null = no IP restriction
  allowWfh      Boolean  @default(true) // if true, check-in allowed off-site (marked WFH)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([isActive])
}

model AttendanceRecord {
  id            String           @id @default(cuid())
  employeeId    String
  employee      Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date          DateTime // UTC midnight of the attendance day
  checkInAt     DateTime?
  checkOutAt    DateTime?
  checkInLat    Float?
  checkInLng    Float?
  checkInIp     String?
  siteId        String?
  source        AttendanceSource @default(WEB)
  status        AttendanceStatus @default(PRESENT)
  workedMinutes Int              @default(0)
  selfieUrl     String?
  isRegularized Boolean          @default(false)
  note          String?
  // Geo-tagging flow (HRMS flowchart): OFFICE/FIELD punches are geo-verified
  // (within site radius); CLIENT visits need no geo-tag.
  visitType        String?  // OFFICE | FIELD | CLIENT
  locationVerified Boolean? // true = GPS matched a site within radius
  flagged          Boolean  @default(false) // needs manager/HR review
  flagReason       String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @default(now()) @updatedAt

  regularizations Regularization[]

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([status])
}

enum RegularizationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Regularization {
  id                 String               @id @default(cuid())
  employeeId         String
  employee           Employee             @relation("RegnEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  attendanceRecordId String?
  attendanceRecord   AttendanceRecord?    @relation(fields: [attendanceRecordId], references: [id], onDelete: SetNull)
  date               DateTime
  requestedStatus    AttendanceStatus
  requestedCheckIn   DateTime?
  requestedCheckOut  DateTime?
  reason             String
  status             RegularizationStatus @default(PENDING)
  approverId         String?
  decidedAt          DateTime?
  decisionNote       String?
  createdAt          DateTime             @default(now())

  @@index([employeeId])
  @@index([status])
}

// ============================================================
// Document Management
// ============================================================
enum DocumentScope {
  ORG // policies, handbooks — everyone
  EMPLOYEE // offer letters, ID proofs — one employee
}

model HrDocumentCategory {
  id        String        @id @default(cuid())
  name      String
  scope     DocumentScope @default(ORG)
  isActive  Boolean       @default(true)
  order     Int           @default(0)
  createdAt DateTime      @default(now())

  documents HrDocument[]

  @@index([scope])
}

model HrDocument {
  id          String              @id @default(cuid())
  title       String
  categoryId  String?
  category    HrDocumentCategory? @relation(fields: [categoryId], references: [id])
  scope       DocumentScope       @default(ORG)
  fileUrl     String? // link to the stored file (Drive/S3/etc.)
  version     Int                 @default(1)
  employeeId  String? // set when scope = EMPLOYEE
  employee    Employee?           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  requiresAck Boolean             @default(false)
  expiryDate  DateTime?
  uploadedBy  String
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @default(now()) @updatedAt

  acknowledgements DocumentAcknowledgement[]
  esignRequests    ESignRequest[]

  @@index([scope])
  @@index([employeeId])
  @@index([expiryDate])
}

model DocumentAcknowledgement {
  id             String     @id @default(cuid())
  documentId     String
  document       HrDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  acknowledgedAt DateTime   @default(now())

  @@unique([documentId, employeeId])
  @@index([documentId])
}

// Mail-merge templates (offer/confirmation letters) — body has {{placeholders}}.
model HrDocumentTemplate {
  id        String   @id @default(cuid())
  name      String
  body      String   @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

enum ESignStatus {
  PENDING
  SIGNED
  DECLINED
  CANCELLED
}

// E-signature requests — provider abstracted behind the hr/esign lib adapter.
model ESignRequest {
  id          String      @id @default(cuid())
  documentId  String
  document    HrDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  signerName  String
  signerEmail String
  provider    String      @default("noop")
  externalId  String?
  status      ESignStatus @default(PENDING)
  requestedBy String
  signedAt    DateTime?
  createdAt   DateTime    @default(now())

  @@index([documentId])
  @@index([status])
}

// ============================================================
// Onboarding / Offboarding (employee lifecycle journeys)
// ============================================================
enum JourneyType {
  ONBOARDING
  OFFBOARDING
}

enum JourneyStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum JourneyTaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  NA
  BLOCKED
}

model OnboardingTemplate {
  id            String      @id @default(cuid())
  name          String
  type          JourneyType @default(ONBOARDING)
  legalEntityId String? // null = applies to all entities
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())

  tasks OnboardingTaskTemplate[]

  @@index([type])
}

model OnboardingTaskTemplate {
  id         String             @id @default(cuid())
  templateId String
  template   OnboardingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title      String
  category   String             @default("General") // IT, HR, Manager, Finance, …
  ownerRole  String? // role responsible
  blocksDay1 Boolean            @default(false) // must be DONE before Day-1 / completion
  order      Int                @default(0)

  @@index([templateId])
}

model EmployeeJourney {
  id          String        @id @default(cuid())
  employeeId  String
  employee    Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        JourneyType
  status      JourneyStatus @default(IN_PROGRESS)
  templateId  String?
  startDate   DateTime?
  targetDate  DateTime? // joining date or last working day
  reason      String? // resignation/termination reason (offboarding)
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt

  tasks         JourneyTask[]
  exitInterview ExitInterview?

  @@index([employeeId])
  @@index([type])
  @@index([status])
}

model JourneyTask {
  id          String            @id @default(cuid())
  journeyId   String
  journey     EmployeeJourney   @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  title       String
  category    String            @default("General")
  ownerRole   String?
  assigneeId  String? // Employee id
  status      JourneyTaskStatus @default(PENDING)
  blocksDay1  Boolean           @default(false)
  dueDate     DateTime?
  order       Int               @default(0)
  completedAt DateTime?

  @@index([journeyId])
  @@index([status])
}

model ExitInterview {
  id          String          @id @default(cuid())
  journeyId   String          @unique
  journey     EmployeeJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  reason      String?
  feedback    String?         @db.Text
  rating      Int? // 1-5 overall experience
  conductedBy String?
  conductedAt DateTime        @default(now())
}

model CandidatePortalInvite {
  id         String    @id @default(cuid())
  employeeId String
  token      String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([employeeId])
}

// ============================================================
// Performance Management (KRA / Goals / Appraisals)
// ============================================================
enum AppraisalCycleStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum ReviewKind {
  SELF
  MANAGER
  PEER
}

enum ReviewStatus {
  PENDING
  SUBMITTED
}

model AppraisalCycle {
  id        String               @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  status    AppraisalCycleStatus @default(DRAFT)
  ratingMax Int                  @default(5)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @default(now()) @updatedAt

  goals   Goal[]
  reviews AppraisalReview[]

  @@index([status])
}

model Goal {
  id            String         @id @default(cuid())
  employeeId    String
  employee      Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cycleId       String
  cycle         AppraisalCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  weight        Int            @default(0) // percentage weight of the KRA
  status        GoalStatus     @default(NOT_STARTED)
  selfRating    Int?
  managerRating Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt

  @@index([employeeId, cycleId])
  @@index([cycleId])
}

model AppraisalReview {
  id           String         @id @default(cuid())
  cycleId      String
  cycle        AppraisalCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employeeId   String // subject of the review
  employee     Employee       @relation("ReviewSubject", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewerId   String // author of the review
  reviewer     Employee       @relation("ReviewAuthor", fields: [reviewerId], references: [id], onDelete: Cascade)
  kind         ReviewKind
  status       ReviewStatus   @default(PENDING)
  rating       Int?
  strengths    String?        @db.Text
  improvements String?        @db.Text
  comments     String?        @db.Text
  submittedAt  DateTime?
  createdAt    DateTime       @default(now())

  @@unique([cycleId, employeeId, reviewerId, kind])
  @@index([cycleId, employeeId])
  @@index([reviewerId, status])
}

// ============================================================
// Shift Management (HR workforce shifts — distinct from event-staff Shift)
// ============================================================
model HrShift {
  id        String   @id @default(cuid())
  name      String
  startTime String // "09:00"
  endTime   String // "18:00"
  color     String   @default("blue")
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  assignments ShiftAssignment[]

  @@index([isActive])
}

model ShiftAssignment {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftId    String
  shift      HrShift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  date       DateTime // UTC midnight of the rostered day
  createdAt  DateTime @default(now())

  swapRequests ShiftSwapRequest[]

  @@unique([employeeId, date])
  @@index([date])
  @@index([shiftId])
}

enum ShiftSwapStatus {
  PENDING
  APPROVED
  REJECTED
}

model ShiftSwapRequest {
  id               String          @id @default(cuid())
  assignmentId     String
  assignment       ShiftAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  requestedById    String
  requestedBy      Employee        @relation("SwapRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  targetEmployeeId String
  targetEmployee   Employee        @relation("SwapTarget", fields: [targetEmployeeId], references: [id], onDelete: Cascade)
  reason           String?
  status           ShiftSwapStatus @default(PENDING)
  decidedAt        DateTime?
  createdAt        DateTime        @default(now())

  @@index([status])
  @@index([requestedById])
  @@index([targetEmployeeId])
}

// ============================================================
// Velos motivation / gamification system
// ============================================================
// Append-only points ledger — every award auditable & reversible.
// idempotencyKey (unique per entity_id + event_type) makes awards idempotent:
// re-firing the same pipeline-stage event inserts nothing extra.
model VelosLedger {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType      String // see VelosConfig.eventType
  entityType     String // 'deal' | 'lead' | 'task' | 'payment' | 'kudos' | 'assist' | 'quest' | 'clawback'
  entityId       String
  points         Int // signed — can be negative (clawbacks)
  awardedAt      DateTime @default(now())
  period         String // 'YYYY-MM' for monthly leaderboard scoping
  idempotencyKey String   @unique
  note           String?
  createdAt      DateTime @default(now())

  @@index([userId, period])
  @@index([period])
  @@index([entityType, entityId])
}

// Config-driven point values — retune without a redeploy. Seeded from defaults.
model VelosConfig {
  id               String   @id @default(cuid())
  eventType        String   @unique
  points           Int
  label            String
  category         String   @default("general") // pipeline | lead_sla | ops | finance | peer | recovery
  clawbackEligible Boolean  @default(false) // sale-side points reversed on cancel/refund
  isEffort         Boolean  @default(false) // effort metric — never clawed back
  updatedAt        DateTime @default(now()) @updatedAt
}

// Peer recognition (B6) — kudos write a +kudos_received ledger row to the receiver.
model Kudos {
  id         String   @id @default(cuid())
  fromUserId String
  fromUser   User     @relation("KudosFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User     @relation("KudosTo", fields: [toUserId], references: [id], onDelete: Cascade)
  note       String
  createdAt  DateTime @default(now())

  @@index([toUserId])
  @@index([fromUserId, createdAt])
}

// Quests & team goals (B8) — self-selectable challenges. Trigger events that
// write to VelosLedger also increment matching QuestProgress rows.
enum QuestScope {
  INDIVIDUAL
  TEAM
}

enum QuestStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

model Quest {
  id             String      @id @default(cuid())
  title          String
  scope          QuestScope  @default(INDIVIDUAL)
  metric         String // matches a VelosConfig.eventType
  targetCount    Int
  startsAt       DateTime    @default(now())
  endsAt         DateTime?
  rewardPoints   Int         @default(0)
  rewardNote     String?
  selfSelectable Boolean     @default(false) // Silver+ can opt in (autonomy)
  isRecovery     Boolean     @default(false) // auto-created slump-catch quest (A3/B7)
  ownerUserId    String? // set for personal/recovery quests targeted at one user
  status         QuestStatus @default(ACTIVE)
  createdAt      DateTime    @default(now())

  progress QuestProgress[]

  @@index([status])
  @@index([scope])
  @@index([ownerUserId])
}

model QuestProgress {
  id           String    @id @default(cuid())
  questId      String
  quest        Quest     @relation(fields: [questId], references: [id], onDelete: Cascade)
  userId       String? // null = team aggregate row
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentCount Int       @default(0)
  completedAt  DateTime?
  updatedAt    DateTime  @default(now()) @updatedAt

  @@unique([questId, userId])
  @@index([userId])
}

// ============================================================
// HR Help Desk (P1) — tickets, SLA, agent routing, knowledge base.
// Actor ids are User ids (any staff); resolved via manual lookups.
// ============================================================
enum HelpdeskStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum HelpdeskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model HelpdeskCategory {
  id        String   @id @default(cuid())
  name      String
  slaHours  Int      @default(24)
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  tickets  HelpdeskTicket[]
  articles HelpdeskArticle[]

  @@index([isActive])
}

model HelpdeskTicket {
  id               String            @id @default(cuid())
  number           Int               @unique @default(autoincrement())
  subject          String
  description      String            @db.Text
  categoryId       String?
  category         HelpdeskCategory? @relation(fields: [categoryId], references: [id])
  requesterId      String // User id of the raiser
  assigneeId       String? // User id of the agent
  status           HelpdeskStatus    @default(OPEN)
  priority         HelpdeskPriority  @default(MEDIUM)
  slaDueAt         DateTime?
  firstRespondedAt DateTime?
  resolvedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt

  comments HelpdeskComment[]

  @@index([requesterId])
  @@index([assigneeId])
  @@index([status])
}

model HelpdeskComment {
  id         String         @id @default(cuid())
  ticketId   String
  ticket     HelpdeskTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String // User id
  body       String         @db.Text
  isInternal Boolean        @default(false) // agent-only note
  createdAt  DateTime       @default(now())

  @@index([ticketId])
}

model HelpdeskArticle {
  id          String            @id @default(cuid())
  title       String
  body        String            @db.Text
  categoryId  String?
  category    HelpdeskCategory? @relation(fields: [categoryId], references: [id])
  isPublished Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @default(now()) @updatedAt

  @@index([isPublished])
}

// ============================================================
// Projects Wave C — DB-backed CapEx rate card (admin-editable global
// defaults that the calculator seeds from). Gantt durations + luxury
// floors live alongside each line. Seeded from capex-calc constants.
// ============================================================
model ProjectRateCard {
  id               String   @id @default(cuid())
  categoryKey      String   @unique // matches CAPEX_CATEGORIES key
  label            String
  basis            String // AREA | UNIT | LUMPSUM
  rate             Decimal  @db.Decimal(14, 2)
  unitLabel        String
  durationWeeks    Int      @default(0) // drives the Gantt timeline
  luxuryMinPerSqft Decimal? @db.Decimal(10, 2) // amber floor for AREA categories
  isActive         Boolean  @default(true)
  order            Int      @default(0)
  updatedAt        DateTime @default(now()) @updatedAt
}

// ============================================================
// Projects Wave D — procurement: vendors, work packages, purchase
// orders, budget variance (vs the CapEx estimate).
// ============================================================
model ProjectVendor {
  id        String   @id @default(cuid())
  name      String
  trade     String? // Civil, Electrical, HVAC, Furniture, …
  phone     String?
  email     String?
  gstin     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  purchaseOrders ProjectPurchaseOrder[]

  @@index([isActive])
}

enum WorkPackageStatus {
  PLANNED
  IN_PROGRESS
  DONE
  ON_HOLD
}

model ProjectWorkPackage {
  id           String               @id @default(cuid())
  projectId    String
  project      AcqOnboardingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String
  categoryKey  String? // optional link to a rate-card category
  budgetAmount Decimal              @default(0) @db.Decimal(14, 2)
  status       WorkPackageStatus    @default(PLANNED)
  order        Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @default(now()) @updatedAt

  purchaseOrders ProjectPurchaseOrder[]

  @@index([projectId])
}

enum PurchaseOrderStatus {
  DRAFT
  ISSUED
  RECEIVED
  PAID
  CANCELLED
}

model ProjectPurchaseOrder {
  id            String               @id @default(cuid())
  number        Int                  @unique @default(autoincrement())
  projectId     String
  project       AcqOnboardingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workPackageId String?
  workPackage   ProjectWorkPackage?  @relation(fields: [workPackageId], references: [id], onDelete: SetNull)
  vendorId      String?
  vendor        ProjectVendor?       @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  description   String
  amount        Decimal              @default(0) @db.Decimal(14, 2)
  status        PurchaseOrderStatus  @default(DRAFT)
  issuedAt      DateTime?
  note          String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @default(now()) @updatedAt

  @@index([projectId])
  @@index([status])
}

// ============================================================
// FINANCE MODULE (standalone, double-entry GL). All Fin*-prefixed to
// avoid colliding with the event-side Invoice/Payment/Vendor/Budget.
// entityId is a FIELD (default BILLION) — never hardcoded; no multi-entity.
// Money = Decimal(18,2), never float. Balance invariant enforced at the
// DB layer (deferred constraint trigger, POSTED entries only) + app layer.
// ============================================================
enum FinAccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

model FinAccount {
  id         String         @id @default(cuid())
  entityId   String         @default("BILLION")
  code       String         @unique
  name       String
  type       FinAccountType
  subtype    String?
  parentId   String?
  parent     FinAccount?    @relation("FinAccountTree", fields: [parentId], references: [id])
  children   FinAccount[]   @relation("FinAccountTree")
  isActive   Boolean        @default(true)
  isControl  Boolean        @default(false)
  taxDefault String?
  order      Int            @default(0)
  createdAt  DateTime       @default(now())

  lines        FinJournalLine[]
  bankAccounts FinBankAccount[] @relation("FinBankGl")
  reconRules   FinReconRule[]   @relation("FinReconRuleAcct")

  @@index([type])
  @@index([entityId])
}

enum FinPeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

model FinPeriod {
  id         String          @id @default(cuid())
  fy         String // e.g. "2026-27"
  period     Int // 1-12 (Apr=1 for Indian FY)
  status     FinPeriodStatus @default(OPEN)
  closedById String?
  closedAt   DateTime?
  createdAt  DateTime        @default(now())

  entries FinJournalEntry[]

  @@unique([fy, period])
}

enum FinJournalStatus {
  DRAFT
  POSTED
  REVERSED
}

enum FinSourceModule {
  MANUAL
  RECEIVABLE
  PAYABLE
  BANK
  PAYROLL
  REVENUE
  TAX
}

model FinJournalEntry {
  id           String           @id @default(cuid())
  entityId     String           @default("BILLION")
  entryNo      String // gapless per FY, allocated transactionally
  fy           String
  date         DateTime
  narration    String?
  sourceModule FinSourceModule  @default(MANUAL)
  sourceRefId  String?
  status       FinJournalStatus @default(DRAFT)
  reversalOfId String? // this entry reverses that one
  reversedById String? // this entry was reversed by that one
  periodId     String?
  period       FinPeriod?       @relation(fields: [periodId], references: [id])
  postedById   String?
  postedAt     DateTime?
  createdById  String?
  createdAt    DateTime         @default(now())

  lines FinJournalLine[]

  @@unique([fy, entryNo])
  @@index([status])
  @@index([date])
  @@index([sourceModule, sourceRefId])
}

model FinJournalLine {
  id         String          @id @default(cuid())
  entryId    String
  entry      FinJournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId  String
  account    FinAccount      @relation(fields: [accountId], references: [id])
  debit      Decimal         @default(0) @db.Decimal(18, 2)
  credit     Decimal         @default(0) @db.Decimal(18, 2)
  venueId    String?
  eventId    String?
  costCenter String?
  taxCode    String?
  narration  String?
  lineOrder  Int             @default(0)

  @@index([entryId])
  @@index([accountId])
  @@index([venueId])
  @@index([eventId])
}

// Document-number counter — gapless per (entity, fy, series), bumped transactionally.
model FinSequence {
  id       String @id @default(cuid())
  entityId String @default("BILLION")
  series   String // "JE" | "INV" | "BILL" | "PO" | "RCT" ...
  fy       String
  nextNum  Int    @default(1)

  @@unique([entityId, series, fy])
}

// ============================================================
// Bank import + reconciliation (Finance W4)
// ============================================================

// A real-world bank account, mapped to its GL cash/bank account (1020 etc.).
model FinBankAccount {
  id             String       @id @default(cuid())
  entityId       String       @default("BILLION")
  name           String
  bankName       String?
  accountNo      String? // last 4 / masked
  glAccountId    String
  glAccount      FinAccount   @relation("FinBankGl", fields: [glAccountId], references: [id])
  openingBalance Decimal      @default(0) @db.Decimal(18, 2)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  txns           FinBankTxn[]

  @@index([entityId])
}

enum FinBankTxnStatus {
  UNMATCHED
  MATCHED
  RECONCILED
  IGNORED
}

// One imported bank-statement line. credit = money INTO the bank, debit = money
// OUT. dedupeHash makes re-importing the same statement idempotent.
model FinBankTxn {
  id             String           @id @default(cuid())
  bankAccountId  String
  bankAccount    FinBankAccount   @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  date           DateTime
  description    String
  reference      String?
  debit          Decimal          @default(0) @db.Decimal(18, 2)
  credit         Decimal          @default(0) @db.Decimal(18, 2)
  runningBalance Decimal?         @db.Decimal(18, 2)
  status         FinBankTxnStatus @default(UNMATCHED)
  matchedEntryId String? // FinJournalEntry this reconciles to
  importBatch    String?
  dedupeHash     String
  createdAt      DateTime         @default(now())

  @@unique([bankAccountId, dedupeHash])
  @@index([bankAccountId, status])
  @@index([date])
}

// Learned categorization rule: when a bank line description contains `match`,
// suggest posting it against `accountId`. `hits` ranks competing rules.
model FinReconRule {
  id           String     @id @default(cuid())
  entityId     String     @default("BILLION")
  match        String // lowercase substring matched against the description
  accountId    String
  account      FinAccount @relation("FinReconRuleAcct", fields: [accountId], references: [id])
  direction    String? // "CREDIT" | "DEBIT" | null (any)
  counterparty String?
  hits         Int        @default(1)
  createdById  String?
  createdAt    DateTime   @default(now())

  @@index([entityId])
}

// ============================================================
// Recruitment / ATS module (Rec*-prefixed to avoid collisions).
// Job openings → candidates → applications (candidate × opening, staged).
// User links are stored as plain IDs and resolved in the action layer, so the
// large User model needs no back-relations.
// ============================================================

enum RecJobStatus {
  IN_PROGRESS
  ON_HOLD
  INACTIVE
  FILLED
  CANCELLED
}

enum RecCandidateStage {
  NEW
  IN_REVIEW
  AVAILABLE
  ENGAGED
  OFFERED
  HIRED
  REJECTED
}

// Application pipeline stages (the Hiring Pipeline columns).
enum RecAppStage {
  SCREENING
  SUBMISSIONS
  INTERVIEW
  OFFERED
  HIRED
  REJECTED
  ARCHIVED
}

model RecJobOpening {
  id                  String       @id @default(cuid())
  entityId            String       @default("BILLION")
  postingTitle        String
  department          String?
  city                String?
  hiringManagerId     String? // User id (resolved in action layer)
  assignedRecruiterId String? // User id
  targetDate          DateTime?
  status              RecJobStatus @default(IN_PROGRESS)
  numberOfPositions   Int          @default(1)
  description         String?      @db.Text
  filledAt            DateTime?
  createdById         String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  applications RecApplication[]

  @@index([status])
  @@index([department])
}

model RecCandidate {
  id          String            @id @default(cuid())
  entityId    String            @default("BILLION")
  firstName   String
  lastName    String
  email       String?
  phone       String?
  city        String?
  source      String? // Imported, Referral, Career site, LinkedIn…
  rating      Int               @default(0) // 0–5
  stage       RecCandidateStage @default(NEW)
  ownerId     String? // User id
  resumeUrl   String?           @db.Text
  notes       String?           @db.Text
  createdById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  applications RecApplication[]

  @@index([stage])
  @@index([ownerId])
}

model RecApplication {
  id           String        @id @default(cuid())
  candidateId  String
  candidate    RecCandidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobOpeningId String
  jobOpening   RecJobOpening @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)
  stage        RecAppStage   @default(SCREENING)
  rating       Int           @default(0)
  createdById  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([candidateId, jobOpeningId])
  @@index([stage])
  @@index([jobOpeningId])
  @@index([candidateId])
}

// ============================================================
// Finance W6–W13 — budgets, fixed assets, payroll, anomalies.
// All Fin*-prefixed. GL-posting flows go through postJournalEntry (ledger.ts);
// the deferred balance trigger rejects any unbalanced entry at the DB layer.
// ============================================================

model FinBudget {
  id          String          @id @default(cuid())
  entityId    String          @default("BILLION")
  fy          String
  name        String
  status      String          @default("ACTIVE") // ACTIVE | ARCHIVED
  createdById String?
  createdAt   DateTime        @default(now())
  lines       FinBudgetLine[]

  @@index([fy])
}

model FinBudgetLine {
  id          String    @id @default(cuid())
  budgetId    String
  budget      FinBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  accountCode String // FinAccount.code
  period      Int       @default(0) // 0 = annual, 1–12 = month (Apr=1)
  amount      Decimal   @db.Decimal(18, 2)

  @@index([budgetId])
}

model FinAsset {
  id               String                 @id @default(cuid())
  entityId         String                 @default("BILLION")
  name             String
  category         String? // Fit-out, Equipment, Furniture…
  cost             Decimal                @db.Decimal(18, 2)
  salvageValue     Decimal                @default(0) @db.Decimal(18, 2)
  purchaseDate     DateTime
  usefulLifeMonths Int                    @default(60)
  method           String                 @default("STRAIGHT_LINE")
  accumulatedDep   Decimal                @default(0) @db.Decimal(18, 2)
  status           String                 @default("ACTIVE") // ACTIVE | DISPOSED | FULLY_DEPRECIATED
  venueId          String?
  createdById      String?
  createdAt        DateTime               @default(now())
  depreciation     FinDepreciationEntry[]

  @@index([status])
}

model FinDepreciationEntry {
  id             String   @id @default(cuid())
  assetId        String
  asset          FinAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  date           DateTime
  amount         Decimal  @db.Decimal(18, 2)
  journalEntryId String?
  createdAt      DateTime @default(now())

  @@index([assetId])
}

model FinEmployee {
  id          String       @id @default(cuid())
  entityId    String       @default("BILLION")
  name        String
  designation String?
  department  String?
  ctcMonthly  Decimal      @db.Decimal(18, 2)
  basicPct    Int          @default(50) // % of gross treated as basic (for PF)
  pan         String?
  bankLast4   String?
  isActive    Boolean      @default(true)
  createdById String?
  createdAt   DateTime     @default(now())
  payslips    FinPayslip[]

  @@index([isActive])
}

model FinPayrollRun {
  id              String       @id @default(cuid())
  entityId        String       @default("BILLION")
  fy              String
  period          Int // month, Apr=1
  label           String // e.g. "Apr 2026"
  status          String       @default("DRAFT") // DRAFT | POSTED
  totalGross      Decimal      @default(0) @db.Decimal(18, 2)
  totalDeductions Decimal      @default(0) @db.Decimal(18, 2)
  totalNet        Decimal      @default(0) @db.Decimal(18, 2)
  journalEntryId  String?
  createdById     String?
  createdAt       DateTime     @default(now())
  payslips        FinPayslip[]

  @@unique([fy, period])
}

model FinPayslip {
  id         String        @id @default(cuid())
  runId      String
  run        FinPayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId String
  employee   FinEmployee   @relation(fields: [employeeId], references: [id])
  gross      Decimal       @db.Decimal(18, 2)
  tds        Decimal       @default(0) @db.Decimal(18, 2)
  pf         Decimal       @default(0) @db.Decimal(18, 2)
  esi        Decimal       @default(0) @db.Decimal(18, 2)
  pt         Decimal       @default(0) @db.Decimal(18, 2)
  net        Decimal       @db.Decimal(18, 2)
  createdAt  DateTime      @default(now())

  @@index([runId])
}

model FinAnomaly {
  id           String   @id @default(cuid())
  entityId     String   @default("BILLION")
  type         String // DUPLICATE_PAYMENT | ROUND_AMOUNT | WEEKEND_LARGE | UNBALANCED | OUTLIER
  severity     String   @default("MEDIUM") // LOW | MEDIUM | HIGH
  message      String
  refType      String? // PAYMENT | JOURNAL | INVOICE…
  refId        String?
  amount       Decimal? @db.Decimal(18, 2)
  status       String   @default("OPEN") // OPEN | RESOLVED | IGNORED
  detectedAt   DateTime @default(now())
  resolvedById String?

  @@index([status])
  @@index([type])
}

// ============================================================
// Finishing wave — e-invoice (mock adapter), recruitment interviews/offers.
// Relationless FK strings (indexed) so no back-relations on big/Rec* models.
// ============================================================

enum FinEInvoiceStatus {
  PENDING
  GENERATED
  CANCELLED
  FAILED
}

model FinEInvoice {
  id          String            @id @default(cuid())
  invoiceId   String            @unique
  irn         String? // Invoice Reference Number (IRP)
  ackNo       String?
  qrData      String?           @db.Text
  status      FinEInvoiceStatus @default(PENDING)
  errorMsg    String?
  generatedAt DateTime?
  createdById String?
  createdAt   DateTime          @default(now())

  @@index([status])
}

enum RecInterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model RecInterview {
  id            String             @id @default(cuid())
  candidateId   String
  applicationId String?
  round         String // Phone | Technical | HR | Final
  mode          String             @default("VIDEO") // IN_PERSON | VIDEO | PHONE
  scheduledAt   DateTime
  interviewerId String? // User id
  status        RecInterviewStatus @default(SCHEDULED)
  rating        Int                @default(0)
  feedback      String?            @db.Text
  createdById   String?
  createdAt     DateTime           @default(now())

  @@index([candidateId])
  @@index([scheduledAt])
}

enum RecOfferStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  WITHDRAWN
}

model RecOffer {
  id           String         @id @default(cuid())
  candidateId  String
  jobOpeningId String?
  ctc          Decimal        @db.Decimal(18, 2)
  joiningDate  DateTime?
  status       RecOfferStatus @default(DRAFT)
  notes        String?        @db.Text
  createdById  String?
  createdAt    DateTime       @default(now())

  @@index([candidateId])
}

// ============================================================
// KRA monthly performance scorecards (sales roles).
// Plain string user IDs (no back-relations on User), like Rec*/Fin*.
// Computed snapshot stored as JSON + denormalized columns for querying.
// ============================================================
model KraScorecard {
  id         String @id @default(cuid())
  employeeId String // User being evaluated
  role       String // KraRole: BDM | CORPORATE_SALES | INSIDE_SALES
  period     String // "YYYY-MM"
  rampMonth  Int    @default(3)
  status     String @default("DRAFT") // DRAFT | SUBMITTED | ACKNOWLEDGED

  autoMetrics   Json // { autoKey: value }  (snapshot at generation/recompute)
  manualEntries Json // { kpiRef: value }
  lineItems     Json // computed per-KPI breakdown
  gateDetail    Json // gate requirements snapshot

  totalScore       Int     @default(0)
  totalMax         Int     @default(100)
  gatePassed       Boolean @default(false)
  band             String? // grade A+/A/B/C/D
  basePct          Int     @default(0)
  multiplierFactor Float?
  finalPayoutPct   Float   @default(0)

  managerNote    String?
  createdById    String
  submittedAt    DateTime?
  acknowledgedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([employeeId, period])
  @@index([role, period])
  @@index([employeeId])
  @@index([period, status])
}

// ============================================================
// Event Operations — BEO / Function Sheet + day-of execution
// (new tables, additive; plain string FKs to Booking/User)
// ============================================================
model Beo {
  id                  String        @id @default(cuid())
  beoNumber           String        @unique
  bookingId           String
  status              String        @default("DRAFT") // DRAFT | PUBLISHED | LOCKED
  covers              Int?
  runOfShow           Json? // [{ time, activity, owner, notes }]
  menuNotes           String?       @db.Text
  floorPlanNotes      String?       @db.Text
  avNotes             String?       @db.Text
  decorNotes          String?       @db.Text
  staffingNotes       String?       @db.Text
  specialInstructions String?       @db.Text
  publishedAt         DateTime?
  createdById         String
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  incidents           BeoIncident[]

  @@index([bookingId])
  @@index([status])
  operationId String?
  operation   EventOperation? @relation("OperationBeo", fields: [operationId], references: [id])
}

model BeoIncident {
  id           String   @id @default(cuid())
  beoId        String
  beo          Beo      @relation(fields: [beoId], references: [id], onDelete: Cascade)
  title        String
  description  String?  @db.Text
  severity     String   @default("LOW") // LOW | MEDIUM | HIGH
  status       String   @default("OPEN") // OPEN | RESOLVED
  photoUrl     String?
  reportedById String
  createdAt    DateTime @default(now())

  @@index([beoId])
}

// ============================================================
// Kitchen / F&B production planning + food-costing
// ============================================================
model KitchenPlan {
  id             String            @id @default(cuid())
  bookingId      String
  beoId          String?
  covers         Int               @default(0)
  status         String            @default("PLANNED") // PLANNED | IN_PROGRESS | COMPLETED
  estFoodCost    Decimal           @default(0) @db.Decimal(12, 2)
  actualFoodCost Decimal           @default(0) @db.Decimal(12, 2)
  notes          String?           @db.Text
  createdById    String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  items          KitchenPlanItem[]

  @@index([bookingId])
  @@index([status])
  operationId String?
  operation   EventOperation? @relation("OperationKitchenPlan", fields: [operationId], references: [id])
}

model KitchenPlanItem {
  id             String      @id @default(cuid())
  planId         String
  plan           KitchenPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  name           String
  category       String?
  quantity       Decimal     @default(0) @db.Decimal(12, 2)
  unit           String?
  estUnitCost    Decimal     @default(0) @db.Decimal(12, 2)
  actualUnitCost Decimal?    @db.Decimal(12, 2)

  @@index([planId])
}

// ============================================================
// Procurement — purchase requisitions (RFQ→approve→order→receive)
// ============================================================
model PurchaseRequisition {
  id            String                    @id @default(cuid())
  prNumber      String                    @unique
  title         String
  status        String                    @default("PENDING") // PENDING | APPROVED | ORDERED | RECEIVED | REJECTED
  bookingId     String? // optional event link (procurement raised for a specific booking)
  vendorId      String?
  department    String?
  neededBy      DateTime?
  notes         String?                   @db.Text
  totalAmount   Decimal                   @default(0) @db.Decimal(12, 2)
  requestedById String
  approvedById  String?
  approvedAt    DateTime?
  orderedAt     DateTime?
  receivedAt    DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  items         PurchaseRequisitionItem[]

  @@index([status])
  @@index([bookingId])
  operationId String?
  operation   EventOperation? @relation("OperationPurchaseReqs", fields: [operationId], references: [id])
  @@index([operationId])
}

model PurchaseRequisitionItem {
  id        String              @id @default(cuid())
  prId      String
  pr        PurchaseRequisition @relation(fields: [prId], references: [id], onDelete: Cascade)
  name      String
  quantity  Decimal             @default(0) @db.Decimal(12, 2)
  unit      String?
  unitPrice Decimal             @default(0) @db.Decimal(12, 2)
  received  Boolean             @default(false)

  @@index([prId])
}

// ============================================================
// Customer Support / Ticketing
// ============================================================
model SupportTicket {
  id             String                 @id @default(cuid())
  ticketNumber   String                 @unique
  subject        String
  description    String?                @db.Text
  status         String                 @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | CLOSED
  priority       String                 @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  category       String?
  contactId      String?
  bookingId      String?
  assignedToId   String?
  createdById    String
  resolvedAt     DateTime?
  slaEscalatedAt DateTime? // SLA breach escalated (dedupe so we alert once)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  messages       SupportTicketMessage[]

  @@index([status])
  @@index([assignedToId])
  operationId String?
  operation   EventOperation? @relation("OperationSupportTickets", fields: [operationId], references: [id])
  @@index([operationId])
}

model SupportTicketMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  body      String        @db.Text
  internal  Boolean       @default(false)
  authorId  String
  createdAt DateTime      @default(now())

  @@index([ticketId])
