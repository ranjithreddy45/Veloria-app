// ============================================================
// BD / Property Acquisition CRM (VELORIA_ACQUISITION_CRM_SPEC)
// Lead → Deal → Property lifecycle. Namespaced with `Acq` to stay
// fully separate from the Sales CRM's Lead/Deal/Booking models.
// ============================================================

enum AcqLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DISQUALIFIED
}

enum AcqOwnerType {
  SOLE_OWNER
  PARTNER
  GPA_HOLDER
  MANAGER
}

enum AcqPropertyType {
  BANQUET
  MARRIAGE_HALL
  CONVENTION_CENTRE
  RESORT
  LAWN
}

enum AcqLeadSource {
  WEBSITE
  REFERRAL
  BROKER
  COLD_CALL
  SOCIAL_MEDIA
  WALK_IN
  OTHER
}

// Development/operational stage of the property a lead is about.
enum AcqPropertyStage {
  OPERATIONAL // already a running venue
  CONVERSION  // existing building being converted to a venue
  BROWNFIELD  // redeveloping an existing site
  GREENFIELD  // new build on undeveloped land
}

// Seating-capacity bucket for quick filtering/qualification.
enum AcqSeatingRange {
  R_50_100
  R_100_150
  R_150_200
  R_200_300
  R_300_500
  R_500_PLUS
}

enum AcqDealStage {
  QUALIFIED
  EVALUATION
  EVALUATION_COMPLETED
  PROPOSAL_SENT
  NEGOTIATION
  CONTRACT_SENT
  SIGNED
  WON
  LOST
  ON_HOLD
}

enum AcqDealModel {
  MANAGEMENT
  FRANCHISE
}

enum AcqContractStatus {
  NOT_SENT
  SENT
  SIGNED
}

enum AcqPropertyStatus {
  ONBOARDING
  AVAILABLE
  ACTIVE
  PAUSED
  OFF_BOARDED
}

enum AcqDisqualifyReason {
  WANTS_OUTRIGHT_RENT_ONLY
  COMPETITOR_EXCLUSIVE
  VENUE_NOT_OPERATIONAL
  NOT_DECISION_MAKER
  UNREALISTIC_EXPECTATIONS
  NO_RESPONSE_5_DAYS
  OUT_OF_GEOGRAPHY
  OTHER
}

enum AcqLostReason {
  HIGH_COMMISSION
  COMPETITOR_SELECTED
  WANTED_OUTRIGHT_RENT
  LOCKIN_TOO_LONG
  BUDGET_PRICING
  NO_RESPONSE
  VENUE_QUALITY_BELOW_STANDARD
  OTHER
}

model AcqLead {
  id               String        @id @default(cuid())
  ownerName        String
  mobilePrimary    String // E.164 normalized
  mobileAlternate  String?
  email            String?
  propertyName     String
  propertyType     AcqPropertyType
  city             String
  locality         String
  seatingTheatre   Int?
  seatingFloating  Int?
  seatingRange     AcqSeatingRange?  // bucketed capacity (50-100, 100-150, …)
  propertyStage    AcqPropertyStage? // operational / conversion / brownfield / greenfield
  notes            String?           @db.Text
  // Qualification checklist (§ qualify gate) — persisted so the lead dashboard
  // can show progress toward qualification.
  qualSeating100      Boolean?
  qualOwnerInterested Boolean?
  qualAgreeRenovate   Boolean?
  qualPhotosReady     Boolean?
  leadSource       AcqLeadSource
  ownerType        AcqOwnerType
  bdExecutiveId    String
  bdExecutive      User          @relation("AcqLeadBdExec", fields: [bdExecutiveId], references: [id])
  status           AcqLeadStatus @default(NEW)
  disqualifyReason AcqDisqualifyReason?
  contactAttempts  Int           @default(0)
  nextFollowupAt   DateTime?
  firstContactDue  DateTime
  convertedDealId  String? // set on qualify (denormalized; deal.leadId is authoritative)
  deal             AcqDeal?      @relation("AcqDealOrigin")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  @@index([status])
  @@index([city])
  @@index([bdExecutiveId])
  @@index([mobilePrimary])
  @@index([deletedAt])
}

model AcqDeal {
  id          String       @id @default(cuid())
  name        String
  leadId      String       @unique
  lead        AcqLead      @relation("AcqDealOrigin", fields: [leadId], references: [id])
  stage       AcqDealStage @default(QUALIFIED)

  // Owner + venue snapshot (copied from lead at creation)
  ownerName       String
  ownerType       AcqOwnerType
  propertyName    String
  propertyType    AcqPropertyType
  city            String
  locality        String
  seatingTheatre  Int?
  seatingFloating Int?

  // Venue economics
  ownerCurrentMonthlyRevenue Decimal? @db.Decimal(12, 2)
  avgEventsPerMonth          Decimal? @db.Decimal(6, 2)
  peakRateCard               Decimal? @db.Decimal(12, 2)

  banquetSizeSft  Int? // venue size (sqft) — shown on the board card

  // Commercials
  model               AcqDealModel?
  baseFeePct          Decimal? @db.Decimal(5, 2)
  incentivePct        Decimal? @db.Decimal(5, 2)
  royaltyPct          Decimal? @db.Decimal(5, 2)
  termYears           Int?
  lockinYears         Int?
  isExclusive         Boolean?
  expectedMonthlyEvents Decimal? @db.Decimal(6, 2)
  projectedFeeValue   Decimal? @db.Decimal(12, 2)
  // Once frozen, base fee / incentive / term are locked (post-agreement).
  economicsFrozenAt   DateTime?

  // Scoring
  evalScore  Int?
  evalPassed Boolean?

  // Contract
  contractStatus              AcqContractStatus @default(NOT_SENT)
  signatoryAuthorityVerified  Boolean           @default(false)
  gpaDocumentUrl              String?

  // Approvals
  bdHeadApprovedById String?
  bdHeadApprovedBy   User?    @relation("AcqDealBdHeadApprover", fields: [bdHeadApprovedById], references: [id])
  bdHeadApprovedAt   DateTime?

  // Outcome
  lostReason  AcqLostReason?
  reengageAt  DateTime?
  wonAt       DateTime?
  propertyId  String? // denormalized; property.dealId is authoritative
  property    AcqProperty? @relation("AcqDealProperty")

  expectedCloseDate DateTime?
  bdExecutiveId     String
  bdExecutive       User     @relation("AcqDealBdExec", fields: [bdExecutiveId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  evaluations AcqEvaluation[]
  attachments AcqAttachment[]
  notes       AcqDealNote[]
  projections AcqProjection[]

  @@index([stage])
  @@index([bdExecutiveId])
  @@index([deletedAt])
}

model AcqProperty {
  id                String            @id @default(cuid())
  dealId            String            @unique
  deal              AcqDeal           @relation("AcqDealProperty", fields: [dealId], references: [id])
  propertyName      String
  propertyType      AcqPropertyType
  ownerName         String
  address           String?
  city              String
  locality          String
  seatingTheatre    Int?
  seatingFloating   Int?
  status            AcqPropertyStatus @default(ONBOARDING)
  acquisitionDate   DateTime
  propertyManagerId String?
  propertyManager   User?             @relation("AcqPropertyManager", fields: [propertyManagerId], references: [id])
  availableAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  onboardingProject AcqOnboardingProject?

  @@index([status])
  @@index([deletedAt])
}

model AcqEvaluation {
  id               String   @id @default(cuid())
  dealId           String
  deal             AcqDeal  @relation(fields: [dealId], references: [id])
  capacityScore    Int
  parkingScore     Int
  kitchenScore     Int
  roomsScore       Int
  conditionScore   Int
  locationScore    Int
  avAmenitiesScore Int
  totalScore       Int
  passed           Boolean
  notes            String?
  evaluatedById    String
  evaluatedBy      User     @relation("AcqEvaluationBy", fields: [evaluatedById], references: [id])
  createdAt        DateTime @default(now())

  @@index([dealId])
}

model AcqAttachment {
  id           String   @id @default(cuid())
  dealId       String
  deal         AcqDeal  @relation(fields: [dealId], references: [id])
  kind         String // PHOTO | DOCUMENT | AGREEMENT | GPA
  label        String?
  url          String
  uploadedById String
  uploadedBy   User     @relation("AcqAttachmentBy", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([dealId])
  @@index([dealId, kind])
}

// ============================================================
// BD CONTRACTS — standalone contract-lifecycle module (CLM)
// User/deal references are plain ids (no FK) to keep this self-contained.
// ============================================================
enum AcqContractPhase {
  AUTHORING
  APPROVAL
  NEGOTIATION
  EXECUTION
  POST_EXECUTION
}

enum AcqContractLifecycle {
  DRAFT
  APPROVED
  NEGOTIATED
  SIGNED
  ACTIVE
  TERMINATED
}

model AcqContract {
  id             String  @id @default(cuid())
  contractNumber String? // VG-CON-YYYY-NNN (generated server-side)
  title          String
  dealId        String? // source deal (create-from-deal)
  ownerName     String
  ownerEmail    String?
  ownerPhone    String?
  propertyName  String
  model         String? // MANAGEMENT | FRANCHISE
  baseFeePct    Decimal? @db.Decimal(5, 2)
  incentivePct  Decimal? @db.Decimal(5, 2)
  termYears     Int?
  contractValue Decimal? @db.Decimal(14, 2)
  body          String?  @db.Text

  phase  AcqContractPhase     @default(AUTHORING)
  status AcqContractLifecycle @default(DRAFT)

  signByDate          DateTime? // target signing date (calendar)
  signedAt            DateTime?
  startDate           DateTime?
  endDate             DateTime?
  terminatedAt        DateTime?
  terminationGainLoss Decimal?  @db.Decimal(14, 2) // +gain / -loss

  approvedById   String?
  approvedAt     DateTime?
  esignProvider  String?
  esignRequestId String?
  esignStatus    String? // SENT | SIGNED | DECLINED

  bdExecutiveId String
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  documents  AcqContractDocument[]
  activities AcqContractActivity[]
  versions   AcqContractVersion[]

  @@index([status])
  @@index([phase])
  @@index([signByDate])
  @@index([deletedAt])
}

model AcqContractDocument {
  id           String      @id @default(cuid())
  contractId   String
  contract     AcqContract @relation(fields: [contractId], references: [id])
  label        String?
  url          String
  uploadedById String
  createdAt    DateTime    @default(now())

  @@index([contractId])
}

model AcqContractActivity {
  id         String      @id @default(cuid())
  contractId String
  contract   AcqContract @relation(fields: [contractId], references: [id])
  type       String // AUTHORED | APPROVED | NEGOTIATION | SENT_FOR_SIGN | SIGNED | ACTIVATED | TERMINATED | NOTE
  detail     String?
  actorId    String
  createdAt  DateTime    @default(now())

  @@index([contractId])
  @@index([type])
}

// Version history of the contract body (each saved draft is snapshotted).
model AcqContractVersion {
  id          String      @id @default(cuid())
  contractId  String
  contract    AcqContract @relation(fields: [contractId], references: [id])
  version     Int
  body        String      @db.Text
  createdById String
  createdAt   DateTime    @default(now())

  @@index([contractId])
}

model AcqDealNote {
  id        String   @id @default(cuid())
  dealId    String
  deal      AcqDeal  @relation(fields: [dealId], references: [id])
  noteType  String // NEGOTIATION | INTERNAL | GENERAL
  body      String
  authorId  String
  author    User     @relation("AcqDealNoteAuthor", fields: [authorId], references: [id])
  createdAt DateTime @default(now())

  @@index([dealId])
}

model AcqOnboardingProject {
  id          String              @id @default(cuid())
  propertyId  String              @unique
  property    AcqProperty         @relation(fields: [propertyId], references: [id])
  status      String              @default("OPEN") // OPEN | COMPLETED
  createdAt   DateTime            @default(now())
  completedAt DateTime?
  tasks       AcqOnboardingTask[]

  @@index([status])
}

model AcqOnboardingTask {
  id         String               @id @default(cuid())
  projectId  String
  project    AcqOnboardingProject @relation(fields: [projectId], references: [id])
  title      String
  done       Boolean              @default(false)
  assigneeId String?
  assignee   User?                @relation("AcqOnboardingAssignee", fields: [assigneeId], references: [id])
  createdAt  DateTime             @default(now())

  @@index([projectId])
}

model AcqStageTransition {
  id        String   @id @default(cuid())
  entity    String // DEAL | LEAD | PROPERTY
  entityId  String
  fromState String?
  toState   String
  actorId   String
  actor     User     @relation("AcqStageTransitionActor", fields: [actorId], references: [id])
  reason    String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

model AcqConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// ============================================================
// BD CRM — Owner Projection Calculator (5-year revenue projection)
// ============================================================

enum AcqProjectionModel {
  WITH_FOOD
  WITHOUT_FOOD
}

enum AcqProjectionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  REJECTED
}

enum AcqProjectionSendMethod {
  EMAIL_APP
  MANUAL_DOWNLOAD
}

model AcqProjection {
  id         String              @id @default(cuid())
  dealId     String
  deal       AcqDeal             @relation(fields: [dealId], references: [id])
  version    Int                 @default(1)
  modelType  AcqProjectionModel
  status     AcqProjectionStatus @default(DRAFT)
  inputsJson Json // raw BD-entered inputs
  outputsJson Json? // full 5yr base+best grid; frozen at APPROVED
  pdfUrl     String?

  // approval
  submittedById String?
  submittedBy   User?     @relation("AcqProjectionSubmittedBy", fields: [submittedById], references: [id])
  submittedAt   DateTime?
  approvedById  String?
  approvedBy    User?     @relation("AcqProjectionApprovedBy", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  rejectedReason String?

  // send
  sendMethod  AcqProjectionSendMethod?
  sentChannel String?
  sentTo      String?
  sentById    String?
  sentBy      User?     @relation("AcqProjectionSentBy", fields: [sentById], references: [id])
  sentAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transitions AcqProjectionTransition[]

  @@index([dealId])
  @@index([status])
}

model AcqProjectionTransition {
  id           String        @id @default(cuid())
  projectionId String
  projection   AcqProjection @relation(fields: [projectionId], references: [id])
  fromStatus   String?
  toStatus     String
  actorId      String
  actor        User          @relation("AcqProjectionTransitionActor", fields: [actorId], references: [id])
  note         String?
  createdAt    DateTime      @default(now())

  @@index([projectionId])
}

// ============================================================
// SALES CRM — Quotation Calculator (mirrors AcqProjection)
// Sales rep builds a quote with the calculator → submits → a sales
// manager/head approves → it can be viewed/downloaded/emailed/whatsapped.
// inputsJson holds the raw calculator input; outputsJson is the frozen
// computed result (lines + totals + payment schedule) snapshotted at
// approval so the customer-facing PDF can never drift from the engine.
// ============================================================

enum SalesQuotationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  REJECTED
}

enum SalesQuotationSendMethod {
  EMAIL
  WHATSAPP
  MANUAL_DOWNLOAD
}

model SalesQuotation {
  id          String               @id @default(cuid())
  quoteNumber String // monotonic VG-Q-NNNNN allocated inside a Serializable txn (no @unique → db push stays non-destructive)
  version     Int                  @default(1)
  status      SalesQuotationStatus @default(DRAFT)

  // Calculator snapshot
  inputsJson  Json // QuotationInput
  outputsJson Json? // QuotationResult, frozen at APPROVED

  // Denormalised headline figures for list views / sorting
  clientName  String?
  clientPhone String?
  clientEmail String?
  occasion    String?
  eventDate   DateTime?
  timeSlot    String?
  guestCount  Int       @default(0)
  subtotal    Decimal   @default(0) @db.Decimal(12, 2)
  discountPct Decimal   @default(0) @db.Decimal(5, 2)
  taxAmount   Decimal   @default(0) @db.Decimal(12, 2)
  grandTotal  Decimal   @default(0) @db.Decimal(12, 2)
  notes       String?   @db.Text

  pdfUrl String?

  // Slot booking (BookMyShow-style): when the customer commits, we create a
  // HOLD Booking for the venue+date+slot. bookingId references that Booking
  // (plain ref, not a relation, to avoid widening the Booking model).
  bookingId     String?
  slotBlockedAt DateTime?
  invoiceId     String? // booking-advance invoice generated from this quote

  // Approval
  submittedById  String?
  submittedBy    User?     @relation("SalesQuotationSubmittedBy", fields: [submittedById], references: [id])
  submittedAt    DateTime?
  approvedById   String?
  approvedBy     User?     @relation("SalesQuotationApprovedBy", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  rejectedReason String?

  // Send
  sendMethod  SalesQuotationSendMethod?
  sentChannel String?
  sentTo      String?
  sentById    String?
  sentBy      User?                     @relation("SalesQuotationSentBy", fields: [sentById], references: [id])
  sentAt      DateTime?

  // Relations
  leadId      String?
  lead        Lead?    @relation(fields: [leadId], references: [id])
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id])
  venueId     String?
  venue       Venue?   @relation("SalesQuotationVenue", fields: [venueId], references: [id])
  createdById String
  createdBy   User     @relation("SalesQuotationCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transitions SalesQuotationTransition[]

  @@index([status])
  @@index([leadId])
  @@index([contactId])
  @@index([createdAt])
}

model SalesQuotationTransition {
  id          String         @id @default(cuid())
  quotationId String
  quotation   SalesQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  fromStatus  String?
  toStatus    String
  actorId     String
  actor       User           @relation("SalesQuotationTransitionActor", fields: [actorId], references: [id])
  note        String?
  createdAt   DateTime       @default(now())

  @@index([quotationId])
}
