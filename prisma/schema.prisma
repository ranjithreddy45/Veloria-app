// ============================================================
// PHASE 8: FINANCE & ACCOUNTING
// ============================================================

enum PayoutStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

enum PayoutType {
  VENDOR_PAYMENT
  OWNER_PAYOUT
  COMMISSION
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
}

enum AccountingSyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum InsuranceType {
  EVENT_LIABILITY
  PROPERTY
  CANCELLATION
  WEATHER
}

enum InsurancePolicyStatus {
  ACTIVE
  EXPIRED
  CLAIMED
}

// 8.1 Owner Payout Calculations

model Payout {
  id              String       @id @default(cuid())
  amount          Decimal      @db.Decimal(12, 2)
  status          PayoutStatus @default(PENDING)
  type            PayoutType
  description     String?
  referenceNumber String?
  paidAt          DateTime?
  notes           String?      @db.Text
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  vendorId    String?
  vendor      Vendor?  @relation(fields: [vendorId], references: [id])
  bookingId   String?
  booking     Booking? @relation(fields: [bookingId], references: [id])
  approvedById String?

  @@index([status])
  @@index([vendorId])
  @@index([bookingId])
}

// 8.2 Commission Tracking

model CommissionRule {
  id          String  @id @default(cuid())
  name        String
  role        String?
  userId      String?
  bookingType String?
  percentage  Decimal @db.Decimal(5, 2)
  flatAmount  Decimal? @db.Decimal(12, 2)
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entries CommissionEntry[]
}

model CommissionEntry {
  id               String           @id @default(cuid())
  invoiceAmount    Decimal          @db.Decimal(12, 2)
  commissionAmount Decimal          @db.Decimal(12, 2)
  status           CommissionStatus @default(PENDING)
  paidAt           DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  ruleId    String
  rule      CommissionRule @relation(fields: [ruleId], references: [id])
  userId    String
  bookingId String

  @@index([ruleId])
  @@index([userId])
  @@index([bookingId])
}

// 8.3 Financial Forecasting & Budgeting

model Budget {
  id       String   @id @default(cuid())
  name     String
  venueId  String?
  month    String
  year     Int
  revenue  Decimal  @db.Decimal(12, 2)
  expenses Decimal  @db.Decimal(12, 2)
  profit   Decimal  @db.Decimal(12, 2)
  category String?
  notes    String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([year, month])
}

model ForecastEntry {
  id                String   @id @default(cuid())
  month             String
  year              Int
  predictedRevenue  Decimal  @db.Decimal(12, 2)
  predictedBookings Int
  confidence        Decimal  @db.Decimal(5, 2)
  generatedAt       DateTime @default(now())

  @@index([year, month])
}

// 8.4 Tally/Accounting Sync

model AccountingSyncLog {
  id          String               @id @default(cuid())
  type        String
  entityId    String
  status      AccountingSyncStatus @default(PENDING)
  externalRef String?
  error       String?
  syncedAt    DateTime?
  createdAt   DateTime             @default(now())

  @@index([type, entityId])
  @@index([status])
}

// 8.5 Insurance Tracking

model InsurancePolicy {
  id             String                @id @default(cuid())
  provider       String
  policyNumber   String
  type           InsuranceType
  coverageAmount Decimal               @db.Decimal(12, 2)
  premium        Decimal               @db.Decimal(12, 2)
  startDate      DateTime
  endDate        DateTime
  status         InsurancePolicyStatus @default(ACTIVE)
  documents      Json?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id])
  venueId   String?
  venue     Venue?   @relation(fields: [venueId], references: [id])

  @@index([status])
  @@index([bookingId])
  @@index([venueId])
}

// ============================================================
// PHASE 9: CRM, MARKETING & COMMUNICATIONS
// ============================================================

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

enum CommunicationType {
  NOTE
  CALL
  EMAIL
  SMS
  MEETING
  WHATSAPP
}

enum CommunicationDirection {
  INBOUND
  OUTBOUND
}

enum WhatsAppMessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum ReferralStatus {
  PENDING
  CONTACTED
  LEAD_CREATED
  BOOKING_CONFIRMED
  CONVERTED
  EXPIRED
  CANCELLED
}

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  TWITTER
  LINKEDIN
}

enum SocialPostStatus {
  DRAFT
  SCHEDULED
  POSTED
}

// 9.1 AI Lead Scoring (extends Lead model - aiScore/aiScoreReason/aiScoredAt added later via field additions)

// 9.2 Automated Marketing Campaigns

model Campaign {
  id              String         @id @default(cuid())
  name            String
  subject         String
  htmlContent     String         @db.Text
  status          CampaignStatus @default(DRAFT)
  scheduledAt     DateTime?
  sentAt          DateTime?
  recipientFilter Json?
  totalSent       Int            @default(0)
  totalOpened     Int            @default(0)
  totalClicked    Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  createdById String

  @@index([status])
  @@index([createdAt])
}

model EmailTemplate {
  id          String   @id @default(cuid())
  name        String
  subject     String
  htmlContent String   @db.Text
  category    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 9.3 Client Communication Hub

model Communication {
  id        String                 @id @default(cuid())
  type      CommunicationType
  subject   String?
  content   String                 @db.Text
  direction CommunicationDirection @default(OUTBOUND)
  metadata  Json?
  createdAt DateTime               @default(now())

  // Sentiment Analysis fields
  sentiment      String?   // POSITIVE, NEUTRAL, NEGATIVE
  sentimentScore Float?    // -1.0 to 1.0
  sentimentAt    DateTime?

  contactId   String
  contact     Contact @relation(fields: [contactId], references: [id])
  bookingId   String?
  createdById String

  trackingPixel EmailTrackingPixel?
  callLog       CallLog?

  @@index([contactId])
  @@index([bookingId])
  @@index([createdAt])
}

// 9.4 WhatsApp Business (Placeholder)

model WhatsAppMessage {
  id           String                @id @default(cuid())
  direction    CommunicationDirection @default(OUTBOUND)
  content      String                @db.Text
  templateName String?
  status       WhatsAppMessageStatus @default(SENT)
  whatsappId   String?
  sentAt       DateTime              @default(now())

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id])

  @@index([contactId])
  @@index([sentAt])
}

// 9.5 Client Referral Program

model Referral {
  id                 String         @id @default(cuid())
  referralCode       String?        @unique
  referralLink       String?
  referredName       String
  referredEmail      String?
  referredPhone      String?
  source             ReferralSource @default(GUEST)
  status             ReferralStatus @default(PENDING)
  rewardPoints       Int?
  convertedLeadId    String?
  convertedBookingId String?
  bookingValue       Decimal?       @db.Decimal(12, 2)
  notes              String?        @db.Text
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  referrerContactId String
  referrerContact   Contact  @relation(fields: [referrerContactId], references: [id])
  referrerUserId    String?
  referrerUser      User?    @relation("UserReferrals", fields: [referrerUserId], references: [id])
  referrerVendorId  String?
  referrerVendor    Vendor?  @relation("VendorReferrals", fields: [referrerVendorId], references: [id])

  rewards ReferralReward[]

  @@index([referrerContactId])
  @@index([referrerUserId])
  @@index([referrerVendorId])
  @@index([referralCode])
  @@index([status])
  @@index([source])
}

// 9.6 Social Media Integration (Placeholder)

model SocialPost {
  id          String           @id @default(cuid())
  platform    SocialPlatform
  content     String           @db.Text
  imageUrl    String?
  status      SocialPostStatus @default(DRAFT)
  scheduledAt DateTime?
  postedAt    DateTime?
  engagement  Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([platform])
  @@index([status])
}

// ============================================================
// PHASE 10: Customer Experience
// ============================================================

// 10.1 Loyalty & Rewards

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum LoyaltyTransactionType {
  EARNED
  REDEEMED
  EXPIRED
  ADJUSTED
}

model LoyaltyAccount {
  id            String      @id @default(cuid())
  points        Int         @default(0)
  tier          LoyaltyTier @default(BRONZE)
  totalEarned   Int         @default(0)
  totalRedeemed Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  contactId    String                @unique
  contact      Contact               @relation(fields: [contactId], references: [id])
  transactions LoyaltyTransaction[]
}

model LoyaltyTransaction {
  id          String                 @id @default(cuid())
  type        LoyaltyTransactionType
  points      Int
  description String
  referenceId String?
  createdAt   DateTime               @default(now())

  accountId String
  account   LoyaltyAccount @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([createdAt])
}

// 10.2 Surveys & Feedback

enum SurveyQuestionType {
  RATING
  TEXT
  MULTIPLE_CHOICE
  NPS
}

model Survey {
  id          String           @id @default(cuid())
  title       String
  description String?          @db.Text
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  questions SurveyQuestion[]
  responses SurveyResponse[]
}

model SurveyQuestion {
  id         String             @id @default(cuid())
  question   String
  type       SurveyQuestionType
  options    Json?
  isRequired Boolean            @default(true)
  order      Int                @default(0)

  surveyId String
  survey   Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers  SurveyAnswer[]

  @@index([surveyId])
}

model SurveyResponse {
  id            String   @id @default(cuid())
  overallRating Int?
  npsScore      Int?
  createdAt     DateTime @default(now())

  surveyId  String
  survey    Survey  @relation(fields: [surveyId], references: [id])
  bookingId String?
  contactId String?

  answers SurveyAnswer[]

  @@index([surveyId])
  @@index([bookingId])
}

model SurveyAnswer {
  id    String @id @default(cuid())
  value String @db.Text

  responseId String
  response   SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId String
  question   SurveyQuestion @relation(fields: [questionId], references: [id])

  @@index([responseId])
  @@index([questionId])
}

// 10.3 Reviews & Ratings

model Review {
  id          String   @id @default(cuid())
  rating      Int
  title       String?
  content     String   @db.Text
  isPublic    Boolean  @default(false)
  isApproved  Boolean  @default(false)
  response    String?  @db.Text
  respondedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id])
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])

  @@index([contactId])
  @@index([bookingId])
  @@index([rating])
}

// 10.4 Booking Widget (Embeddable)

model WidgetInquiry {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  eventType   String?
  eventDate   DateTime?
  guestCount  Int?
  venueId     String?
  message     String   @db.Text
  source      String   @default("WIDGET")
  isProcessed Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([isProcessed])
  @@index([createdAt])
}

// 10.5 Photo/Video Gallery

model GalleryItem {
  id           String   @id @default(cuid())
  title        String?
  description  String?  @db.Text
  mediaType    String   @default("PHOTO")
  url          String
  thumbnailUrl String?
  tags         String[] @default([])
  isPublic     Boolean  @default(false)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookingId    String?
  venueId      String?
  uploadedById String

  @@index([bookingId])
  @@index([venueId])
  @@index([isPublic])
}

// 10.6 Menu Tasting Scheduler

enum TastingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model MenuTasting {
  id            String        @id @default(cuid())
  scheduledDate DateTime
  scheduledTime String
  status        TastingStatus @default(SCHEDULED)
  selectedItems Json?
  notes         String?       @db.Text
  feedback      String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  bookingId String
  contactId String
  venueId   String?

  @@index([bookingId])
  @@index([contactId])
  @@index([scheduledDate])
}

// ============================================================
// Phase 11: Competitor Analysis
// ============================================================

model Competitor {
  id          String   @id @default(cuid())
  name        String
  website     String?
  location    String?
  venueTypes  String[]
  priceRange  String?
  rating      Int?
  strengths   String?  @db.Text
  weaknesses  String?  @db.Text
  notes       String?  @db.Text
  lastUpdated DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

// ============================================================
// PHASE 12: SYSTEM INFRASTRUCTURE
// ============================================================

// 12.2 Multi-Venue Coordination
// parentVenueId + childVenues already handled via Venue self-relation below

// 12.3 Multi-Currency
model Currency {
  id           String   @id @default(cuid())
  code         String   @unique // USD, EUR, GBP, AED, INR
  name         String
  symbol       String
  exchangeRate Decimal  @db.Decimal(12, 6) // Rate relative to INR
  lastUpdated  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// 12.4 Emergency Response
model EmergencyProtocol {
  id             String   @id @default(cuid())
  venueId        String?
  name           String
  type           String   // FIRE, MEDICAL, WEATHER, SECURITY, POWER_OUTAGE, OTHER
  procedures     String   @db.Text
  contactNumbers Json?    // Array of { name, phone, role }
  lastReviewedAt DateTime?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  incidents EmergencyIncident[]

  @@index([venueId])
  @@index([type])
}

model EmergencyIncident {
  id          String    @id @default(cuid())
  bookingId   String?
  protocolId  String?
  protocol    EmergencyProtocol? @relation(fields: [protocolId], references: [id])
  type        String    // FIRE, MEDICAL, WEATHER, SECURITY, POWER_OUTAGE, OTHER
  description String    @db.Text
  severity    String    // HIGH, MEDIUM, LOW
  status      String    @default("OPEN") // OPEN, RESPONDING, RESOLVED
  resolvedAt  DateTime?
  notes       String?   @db.Text
  reportedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([bookingId])
  @@index([status])
}

// 12.5 Document / File Management
model Document {
  id          String   @id @default(cuid())
  name        String
  fileName    String
  mimeType    String
  size        Int      // bytes
  category    String   // CONTRACT, INVOICE, PHOTO, LICENSE, PERMIT, INSURANCE, OTHER
  url         String?  @db.Text // External URL or storage path
  isPublic    Boolean  @default(false)
  bookingId   String?
  contactId   String?
  venueId     String?
  uploadedById String?
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([bookingId])
  @@index([contactId])
  @@index([venueId])
  @@index([category])
}

// ============================================================
// 13. EVENT EXECUTION & ACCOUNTABILITY SYSTEM
// ============================================================

// 13.1 SOP Templates (Standard Operating Procedures)

model SOPTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  eventType   String?
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  phases         SOPPhase[]
  executionPlans ExecutionPlan[]

  @@index([eventType])
  @@index([isActive])
}

model SOPPhase {
  id          String        @id @default(cuid())
  name        String
  phase       EventPhaseType
  order       Int           @default(0)
  description String?       @db.Text
  createdAt   DateTime      @default(now())

  templateId String
  template   SOPTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  taskDefinitions SOPTaskDefinition[]

  @@index([templateId])
}

model SOPTaskDefinition {
  id                String       @id @default(cuid())
  title             String
  description       String?      @db.Text
  category          TaskCategory @default(GENERAL)
  priority          TaskPriority @default(MEDIUM)
  estimatedMinutes  Int?
  isMandatory       Boolean      @default(false)
  requiresApproval  Boolean      @default(false)
  requiresProof     Boolean      @default(false)
  order             Int          @default(0)
  checklistItems    Json?
  dependsOnTaskOrder Int?

  phaseId String
  phase   SOPPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@index([phaseId])
}

// 13.2 Execution Plan (instantiated for a booking)

model ExecutionPlan {
  id          String          @id @default(cuid())
  status      OperationStatus @default(PLANNING)
  eventDate   DateTime        @db.Date
  startTime   String?
  endTime     String?
  notes       String?         @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  bookingId     String   @unique
  booking       Booking  @relation(fields: [bookingId], references: [id])
  sopTemplateId String?
  sopTemplate   SOPTemplate? @relation(fields: [sopTemplateId], references: [id])
  createdById   String
  createdBy     User     @relation("ExecutionPlanCreatedBy", fields: [createdById], references: [id])

  phases ExecutionPhase[]

  @@index([status])
  @@index([eventDate])
}

model ExecutionPhase {
  id           String              @id @default(cuid())
  name         String
  phase        EventPhaseType
  order        Int                 @default(0)
  status       ExecutionTaskStatus @default(NOT_STARTED)
  plannedStart DateTime?
  plannedEnd   DateTime?
  actualStart  DateTime?
  actualEnd    DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  planId String
  plan   ExecutionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  tasks ExecutionTask[]

  @@index([planId])
}

model ExecutionTask {
  id                String              @id @default(cuid())
  title             String
  description       String?             @db.Text
  category          TaskCategory        @default(GENERAL)
  priority          TaskPriority        @default(MEDIUM)
  status            ExecutionTaskStatus @default(NOT_STARTED)
  estimatedMinutes  Int?
  slaStartBy        DateTime?
  slaFinishBy       DateTime?
  actualStart       DateTime?
  actualEnd         DateTime?
  isMandatory       Boolean             @default(false)
  requiresApproval  Boolean             @default(false)
  isApproved        Boolean             @default(false)
  approvedById      String?
  approvedBy        User?               @relation("ExecutionTaskApprover", fields: [approvedById], references: [id])
  approvedAt        DateTime?
  requiresProof     Boolean             @default(false)
  delayReason       String?             @db.Text
  order             Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Dependencies
  dependsOnTaskId String?
  dependsOnTask   ExecutionTask?  @relation("TaskDependency", fields: [dependsOnTaskId], references: [id])
  dependentTasks  ExecutionTask[] @relation("TaskDependency")

  // Parent relations
  phaseId    String
  phase      ExecutionPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  assigneeId String?
  assignee   User?          @relation("ExecutionTaskAssignee", fields: [assigneeId], references: [id])
  vendorId   String?
  vendor     Vendor?        @relation(fields: [vendorId], references: [id])

  // Child relations
  checklistItems ExecutionChecklist[]
  proofs         TaskProof[]
  escalations    Escalation[]
  timeLogs       TaskTimeLog[]

  @@index([phaseId])
  @@index([assigneeId])
  @@index([vendorId])
  @@index([status])
  @@index([slaFinishBy])
}

model ExecutionChecklist {
  id            String    @id @default(cuid())
  title         String
  isCompleted   Boolean   @default(false)
  completedAt   DateTime?
  completedById String?
  completedBy   User?     @relation("ChecklistCompletedBy", fields: [completedById], references: [id])
  order         Int       @default(0)
  createdAt     DateTime  @default(now())

  taskId String
  task   ExecutionTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskProof {
  id        String    @id @default(cuid())
  type      ProofType
  content   String    @db.Text
  notes     String?   @db.Text
  createdAt DateTime  @default(now())

  taskId        String
  task          ExecutionTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  submittedById String
  submittedBy   User          @relation("ProofSubmitter", fields: [submittedById], references: [id])

  @@index([taskId])
}

model TaskTimeLog {
  id        String   @id @default(cuid())
  action    String
  timestamp DateTime @default(now())
  notes     String?

  taskId String
  task   ExecutionTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId String
  user   User          @relation("TimeLogUser", fields: [userId], references: [id])

  @@index([taskId])
  @@index([timestamp])
}

// 13.3 Escalation Matrix

model EscalationRule {
  id                    String       @id @default(cuid())
  name                  String
  category              TaskCategory
  priority              TaskPriority
  delayThresholdMinutes Int
  level                 EscalationLevel
  notifyUserIds         String[]
  notifyRoles           String[]
  isActive              Boolean      @default(true)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  escalations Escalation[]

  @@index([category, priority])
  @@index([isActive])
}

model Escalation {
  id               String           @id @default(cuid())
  level            EscalationLevel
  status           EscalationStatus @default(PENDING_ESCALATION)
  reason           String           @db.Text
  delayMinutes     Int
  acknowledgedAt   DateTime?
  acknowledgedById String?
  acknowledgedBy   User?            @relation("EscalationAcknowledger", fields: [acknowledgedById], references: [id])
  resolvedAt       DateTime?
  resolvedById     String?
  resolvedBy       User?            @relation("EscalationResolver", fields: [resolvedById], references: [id])
  resolutionNotes  String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  taskId String
  task   ExecutionTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  ruleId String?
  rule   EscalationRule? @relation(fields: [ruleId], references: [id])

  @@index([taskId])
  @@index([status])
  @@index([level])
  @@index([createdAt])
}

// 13.4 Performance Score & Rewards

model PerformanceScore {
  id                  String   @id @default(cuid())
  period              String
  onTimeRate          Decimal  @db.Decimal(5, 2) @default(0)
  qualityScore        Decimal  @db.Decimal(5, 2) @default(0)
  reworkCount         Int      @default(0)
  escalationCount     Int      @default(0)
  avgResponseMinutes  Int      @default(0)
  totalTasksCompleted Int      @default(0)
  totalTasksAssigned  Int      @default(0)
  overallScore        Decimal  @db.Decimal(5, 2) @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  userId   String?
  user     User?   @relation("UserPerformanceScores", fields: [userId], references: [id])
  vendorId String?
  vendor   Vendor? @relation("VendorPerformanceScores", fields: [vendorId], references: [id])

  @@unique([userId, period])
  @@unique([vendorId, period])
  @@index([period])
  @@index([overallScore])
}

model Badge {
  id          String    @id @default(cuid())
  type        BadgeType
  title       String
  description String?
  earnedAt    DateTime  @default(now())
  period      String?

  userId   String?
  user     User?   @relation("UserBadges", fields: [userId], references: [id])
  vendorId String?
  vendor   Vendor? @relation("VendorBadges", fields: [vendorId], references: [id])

  @@index([userId])
  @@index([vendorId])
  @@index([type])
}

model PerformanceIncentive {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  points      Int       @default(0)
  bonusAmount Decimal?  @db.Decimal(12, 2)
  period      String
  isAwarded   Boolean   @default(false)
  awardedAt   DateTime?
  createdAt   DateTime  @default(now())

  userId   String?
  user     User?   @relation("UserIncentives", fields: [userId], references: [id])
  vendorId String?
  vendor   Vendor? @relation("VendorIncentives", fields: [vendorId], references: [id])

  @@index([userId])
  @@index([vendorId])
  @@index([period])
}

// 13.5 Referral Engine (Enhanced)

model ReferralRewardRule {
  id              String   @id @default(cuid())
  name            String
  description     String?  @db.Text
  triggerEvent    String
  rewardType      String
  rewardValue     Decimal  @db.Decimal(12, 2)
  minBookingValue Decimal? @db.Decimal(12, 2)
  bonusMultiplier Decimal? @db.Decimal(5, 2)
  tierLevel       Int      @default(1)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  rewards ReferralReward[]

  @@index([triggerEvent])
  @@index([isActive])
}

model ReferralReward {
  id          String              @id @default(cuid())
  status      ReferralRewardStatus @default(REWARD_PENDING)
  rewardType  String
