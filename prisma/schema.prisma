  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contracts Contract[]
}

// ============================================================
// PHASE 5: EVENT PACKAGES
// ============================================================

enum PackageTier {
  BASIC
  STANDARD
  PREMIUM
  CUSTOM
}

model EventPackage {
  id          String      @id @default(cuid())
  name        String
  description String?     @db.Text
