generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SALES_EXEC
  EVENT_COORDINATOR
  FINANCE
  STAFF
  VENDOR
  CLIENT
  // BD / Acquisition CRM roles (property acquisition pipeline)
  BD_EXECUTIVE
  BD_HEAD
  OPERATIONS
  LEGAL
}

enum ContactType {
  INDIVIDUAL
  CORPORATE
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum LeadSource {
  WEBSITE
  REFERRAL
  SOCIAL_MEDIA
  WALK_IN
  PHONE_INQUIRY
  EMAIL
  EVENT
  PARTNER
  ADVERTISEMENT
  FACEBOOK_ADS
  GOOGLE_ADS
  INDIAMART
  JUSTDIAL
  WEDMEGOOD
  INSTAGRAM
  WHATSAPP
  OTHER
}

enum CallDisposition {
  COMPLETED
  NO_ANSWER
  BUSY
  VOICEMAIL
  WRONG_NUMBER
  CALLBACK_REQUESTED
}

enum TelephonyProvider {
  EXOTEL
  KNOWLARITY
  MYOPERATOR
}

enum LeadCapturePlatform {
  FACEBOOK
  GOOGLE
  INDIAMART
  JUSTDIAL
  GENERIC
}

enum BookingStatus {
  HOLD
  TENTATIVE
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TimeSlot {
  MORNING
  AFTERNOON
  EVENING
  FULL_DAY
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  BANK_TRANSFER
  CASH
  CHEQUE
  UPI
}

enum NotificationType {
  BOOKING_CREATED
  BOOKING_UPDATED
  BOOKING_CANCELLED
  PAYMENT_RECEIVED
  PAYMENT_OVERDUE
  INVOICE_SENT
  TASK_ASSIGNED
  TASK_OVERDUE
  LEAD_ASSIGNED
  DEAL_WON
  DEAL_LOST
  SYSTEM
  TASK_ESCALATED
  ESCALATION_ACKNOWLEDGED
  REFERRAL_CONVERTED
  REFERRAL_REWARD_APPROVED
  PERFORMANCE_BADGE_EARNED
  SLA_WARNING
  EXECUTION_TASK_BLOCKED
  INVITATION_SENT
  RSVP_RECEIVED
  REMINDER_FAILED
}

// ============================================================
// EVENT EXECUTION & ACCOUNTABILITY ENUMS
// ============================================================

enum EventPhaseType {
  PRE_EVENT
  SETUP
  GUEST_ARRIVAL
  LIVE_EVENT
  WRAP_UP
  HANDOVER
}

enum ExecutionTaskStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  COMPLETED
  DELAYED
}

enum TaskCategory {
  DECOR
  AV
  CATERING
  HOUSEKEEPING
  GUEST_SEATING
  ENTERTAINMENT
  LOGISTICS
  SECURITY
  GENERAL
}

enum ProofType {
  PHOTO
  NOTE
  SIGN_OFF
}

enum EscalationLevel {
  L1_SUPERVISOR
  L2_MANAGER
  L3_LEADERSHIP
}

enum EscalationStatus {
  PENDING_ESCALATION
  ACKNOWLEDGED
  RESOLVED
  EXPIRED_ESCALATION
}

enum BadgeType {
  SPEED_STAR
  QUALITY_CHAMPION
  RELIABILITY_KING
  ZERO_ESCALATION
  TOP_PERFORMER
  MONTHLY_BEST
}

enum ReferralSource {
  GUEST
  PLANNER
  VENDOR_REF
  EMPLOYEE
}

enum ReferralRewardStatus {
  REWARD_PENDING
  ELIGIBLE
  REWARD_APPROVED
  REWARD_PAID
  REWARD_CANCELLED
}

// ============================================================
// INVITATION & REMINDER ENUMS
// ============================================================

enum InvitationStatus {
  NOT_SENT
  SENT
  DELIVERED
  OPENED
  RSVP_ACCEPTED
  RSVP_DECLINED
}

enum ReminderStage {
  SAVE_THE_DATE
  EXCITEMENT_BUILDER
  FINAL_COUNTDOWN
  TOMORROW_REMINDER
  DAY_OF_WELCOME
}

enum ReminderStatus {
  REMINDER_PENDING
  REMINDER_SENT
  REMINDER_FAILED
  REMINDER_SKIPPED
}

// ============================================================
// AUTH MODELS (NextAuth v5 + Prisma Adapter)
// ============================================================

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  phone          String?
  role           UserRole  @default(CLIENT)
  isActive       Boolean   @default(true)
  isVenueOwner   Boolean   @default(false)
  ownedVenueIds  String[]
  // User notification preferences (per-event-type email/SMS toggles).
  // Shape: Array<{ key: string; emailEnabled: boolean; smsEnabled: boolean }>
  // Null = use system defaults.
  notificationPreferences Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  assignedLeads   Lead[]         @relation("AssignedTo")
  createdLeads    Lead[]         @relation("CreatedBy")
  assignedDeals   Deal[]         @relation("DealAssignee")
  createdBookings Booking[]      @relation("BookingCreatedBy")
  assignedTasks   Task[]         @relation("TaskAssignee")
  createdTasks    Task[]         @relation("TaskCreator")
  createdInvoices Invoice[]      @relation("InvoiceCreatedBy")
  notifications   Notification[]
  activityLogs    ActivityLog[]
  createdQuotes       Quote[]           @relation("QuoteCreatedBy")
  createdContracts    Contract[]        @relation("ContractCreatedBy")
  createdOperations   EventOperation[]  @relation("OperationCreatedBy")
  staffAssignments    StaffAssignment[] @relation("StaffAssignments")
  timelineAssignments TimelineItem[]    @relation("TimelineAssignee")
  staffProfile        StaffProfile?     @relation("StaffProfileRelation")

  // Event Execution & Accountability
  executionPlansCreated  ExecutionPlan[]      @relation("ExecutionPlanCreatedBy")
  executionTasksAssigned ExecutionTask[]      @relation("ExecutionTaskAssignee")
  executionTaskApprovals ExecutionTask[]      @relation("ExecutionTaskApprover")
  executionChecklistsDone ExecutionChecklist[] @relation("ChecklistCompletedBy")
  taskProofsSubmitted    TaskProof[]          @relation("ProofSubmitter")
  taskTimeLogs           TaskTimeLog[]        @relation("TimeLogUser")
  escalationsAcknowledged Escalation[]        @relation("EscalationAcknowledger")
  escalationsResolved    Escalation[]         @relation("EscalationResolver")
  performanceScores      PerformanceScore[]   @relation("UserPerformanceScores")
  badges                 Badge[]              @relation("UserBadges")
  performanceIncentives  PerformanceIncentive[] @relation("UserIncentives")
  referralsMade          Referral[]           @relation("UserReferrals")
  savedViews             SavedView[]          @relation("UserSavedViews")
  assignmentRules        AssignmentRule[]      @relation("AssignmentRuleUser")
  macros                 Macro[]              @relation("UserMacros")
  blueprints             Blueprint[]          @relation("UserBlueprints")
  cadences               Cadence[]            @relation("UserCadences")
  webforms               Webform[]            @relation("UserWebforms")
  anomalyAcknowledgements AnomalyAlert[]      @relation("AnomalyAcknowledger")
  deviceTokens            DeviceToken[]       @relation("UserDeviceTokens")
  callLogs                CallLog[]           @relation("AgentCallLogs")
  apiKeys                 ApiKey[]            @relation("UserApiKeys")
  telephonyConfigs        TelephonyConfig[]   @relation("UserTelephonyConfigs")
  whatsappConfigs         WhatsAppConfig[]    @relation("UserWhatsAppConfigs")
  hallOwnersManaged       HallOwner[]         @relation("HallOwnerBD")

  // BD / Acquisition CRM relations
  acqLeads                AcqLead[]            @relation("AcqLeadBdExec")
  acqDeals                AcqDeal[]            @relation("AcqDealBdExec")
  acqDealApprovals        AcqDeal[]            @relation("AcqDealBdHeadApprover")
  acqPropertiesManaged    AcqProperty[]        @relation("AcqPropertyManager")
  acqEvaluations          AcqEvaluation[]      @relation("AcqEvaluationBy")
  acqAttachments          AcqAttachment[]      @relation("AcqAttachmentBy")
  acqDealNotes            AcqDealNote[]        @relation("AcqDealNoteAuthor")
  acqOnboardingTasks      AcqOnboardingTask[]  @relation("AcqOnboardingAssignee")
  acqStageTransitions     AcqStageTransition[] @relation("AcqStageTransitionActor")
  acqProjectionsSubmitted AcqProjection[]      @relation("AcqProjectionSubmittedBy")
  acqProjectionsApproved  AcqProjection[]      @relation("AcqProjectionApprovedBy")
  acqProjectionsSent      AcqProjection[]      @relation("AcqProjectionSentBy")
  acqProjectionTransitions AcqProjectionTransition[] @relation("AcqProjectionTransitionActor")
  salesQuotationsCreated   SalesQuotation[]          @relation("SalesQuotationCreatedBy")
  salesQuotationsSubmitted SalesQuotation[]          @relation("SalesQuotationSubmittedBy")
  salesQuotationsApproved  SalesQuotation[]          @relation("SalesQuotationApprovedBy")
  salesQuotationsSent      SalesQuotation[]          @relation("SalesQuotationSentBy")
  salesQuotationTransitions SalesQuotationTransition[] @relation("SalesQuotationTransitionActor")

  @@index([email])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Per-role permission overrides on top of the static defaults (editable in
// Settings → Roles & Permissions). granted=true adds, granted=false removes.
model RolePermission {
  id         String   @id @default(cuid())
  role       String
  permission String
  granted    Boolean  @default(true)
  updatedById String?
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@unique([role, permission])
  @@index([role])
}

// One-time passcodes for passwordless (WhatsApp) login.
model OtpCode {
  id         String    @id @default(cuid())
  phone      String // normalized digits incl. country code
  codeHash   String // sha256(code + pepper) — never store the plaintext
  purpose    String    @default("LOGIN")
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone])
  @@index([expiresAt])
}

// ============================================================
// CRM: CONTACTS & LEADS
// ============================================================

model Contact {
  id             String      @id @default(cuid())
  firstName      String
  lastName       String
  email          String?
  phone          String?
  alternatePhone String?
  company        String?
  designation    String?
  type           ContactType @default(INDIVIDUAL)
  address        String?     @db.Text
  city           String?
  state          String?
  pincode        String?
  notes          String?     @db.Text
  tags           String[]
  isActive       Boolean     @default(true)
  // Customer 360 (spec §3.2) — vipCustomer/anniversary set by staff;
  // customerType, lifetimeBookings, totalRevenue, lastEventDate are
  // auto-rolled by the daily customer-360 cron.
  customerType     String?   // "New" | "Repeat" | "VIP" | "Lost"
  vipCustomer      Boolean   @default(false)
  anniversary      DateTime?
  lifetimeBookings Int       @default(0)
  totalRevenue     Decimal   @default(0) @db.Decimal(14, 2)
  lastEventDate    DateTime?
  deletedAt      DateTime?   // soft-delete; auto-purged after 30 days by cron
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  leads            Lead[]
  bookings         Booking[]
  invoices         Invoice[]
  quotes           Quote[]
  contracts        Contract[]
  communications   Communication[]
  whatsappMessages WhatsAppMessage[]
  referrals        Referral[]
  loyaltyAccount   LoyaltyAccount?
  reviews          Review[]
  callLogs         CallLog[]
  salesQuotations  SalesQuotation[]

  @@index([email])
  @@index([phone])
  @@index([firstName, lastName])
  @@index([deletedAt, createdAt]) // hot list query: not-deleted, newest first
}

model Lead {
  id             String     @id @default(cuid())
  title          String
  description    String?    @db.Text
  status         LeadStatus @default(NEW)
  source         LeadSource @default(WEBSITE)
  score          Int        @default(0)
  estimatedValue Decimal?   @db.Decimal(12, 2)
  eventDate      DateTime?
  eventType      String?
  guestCount     Int?
  followUpDate   DateTime?
  lostReason     String?
  // Venue-specific inquiry fields (spec §3.1)
  slot           String?    // "Lunch" | "Dinner"
  vegNonVeg      String?    // "Veg Only" | "Non Veg Only" | "Both Veg & Non Veg" | "Jain"
  perPlateBudget Decimal?   @db.Decimal(10, 2)
  aiScore        Int?
  aiScoreReason  String?    @db.Text
  aiScoredAt     DateTime?
  // Speed-to-lead SLA (§ Lever 1)
  firstContactDue  DateTime? // deadline for first response (set on capture)
  firstRespondedAt DateTime? // first outbound contact → stops the SLA clock
  slaEscalatedAt   DateTime? // breach escalated (dedupe so we alert once)
  deletedAt      DateTime?  // soft-delete; auto-purged after 30 days by cron
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  contactId        String
  contact          Contact @relation(fields: [contactId], references: [id])
  preferredVenueId String?
  preferredVenue   Venue?  @relation("LeadPreferredVenue", fields: [preferredVenueId], references: [id])
  assignedToId String?
  assignedTo   User?   @relation("AssignedTo", fields: [assignedToId], references: [id])
  createdById  String
  createdBy    User    @relation("CreatedBy", fields: [createdById], references: [id])
  deal         Deal?
  quotes       Quote[]
  salesQuotations SalesQuotation[]

  @@index([status])
  @@index([assignedToId])
  @@index([source])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([score]) // hot-lead worklist (default sort)
  @@index([status, firstContactDue]) // SLA breach sweep
}

// ============================================================
// SALES PIPELINE
// ============================================================

model PipelineStage {
  id          String   @id @default(cuid())
  name        String
  order       Int      @unique
  color       String   @default("#6366f1")
  probability Int      @default(0) // forecast % carried by this stage (0-100)
  isDefault   Boolean  @default(false)
  isWonStage  Boolean  @default(false)
  isLostStage Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deals Deal[]
}

model Deal {
  id                String    @id @default(cuid())
  title             String
  value             Decimal   @db.Decimal(12, 2)
  probability       Int       @default(50)
  expectedCloseDate DateTime?
  notes             String?   @db.Text
  wonDate           DateTime?
  lostDate          DateTime?
  lostReason        String?
  orderInStage      Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // AI Scoring fields
  aiScore        Int?
  aiScoreReason  String?   @db.Text
  aiScoredAt     DateTime?
  aiFactors      Json?

  stageId      String
  stage        PipelineStage @relation(fields: [stageId], references: [id])
  leadId       String        @unique
  lead         Lead          @relation(fields: [leadId], references: [id])
  assignedToId String?
  assignedTo   User?         @relation("DealAssignee", fields: [assignedToId], references: [id])
  booking      Booking?

  @@index([stageId])
  @@index([assignedToId])
}

// ============================================================
// BOOKINGS & CALENDAR
// ============================================================

model Venue {
  id             String   @id @default(cuid())
  name           String
  description    String?  @db.Text
  capacity       Int
  pricePerSlot   Decimal  @db.Decimal(10, 2)
  amenities      String[]
  isActive       Boolean  @default(true)
  parentVenueId  String?
  parentVenue    Venue?   @relation("VenueHierarchy", fields: [parentVenueId], references: [id])
  childVenues    Venue[]  @relation("VenueHierarchy")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bookings          Booking[]
  blackoutDates     BlackoutDate[]
  pricingRules      PricingRule[]
  ratePlans         RatePlan[]
  insurancePolicies InsurancePolicy[]
  preferredLeads    Lead[]            @relation("LeadPreferredVenue")
  salesQuotations   SalesQuotation[]  @relation("SalesQuotationVenue")
}

model Booking {
  id              String        @id @default(cuid())
  bookingNumber   String        @unique
  eventName       String
  eventType       String
  status          BookingStatus @default(HOLD)
  date            DateTime      @db.Date
  timeSlot        TimeSlot
  startTime       DateTime?
  endTime         DateTime?
  guestCount      Int
  specialRequests String?       @db.Text
  internalNotes   String?       @db.Text
  holdExpiresAt   DateTime?
  totalAmount     Decimal       @db.Decimal(12, 2)
  currency        String        @default("INR")

  // Banquet commercials (mirrors Zoho Bookings/Deals custom fields)
  hallBooked      String?       // specific hall/section within the venue
  perPlatePrice   Decimal?      @db.Decimal(12, 2)
  hallRental      Decimal?      @db.Decimal(12, 2)
  decorCharges    Decimal?      @db.Decimal(12, 2)
  otherServices   Decimal?      @db.Decimal(12, 2)

  venueGroupId    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  venueId     String
  venue       Venue   @relation(fields: [venueId], references: [id])
  contactId   String
  contact     Contact @relation(fields: [contactId], references: [id])
  dealId      String? @unique
  deal        Deal?   @relation(fields: [dealId], references: [id])
  createdById String
  createdBy   User    @relation("BookingCreatedBy", fields: [createdById], references: [id])

  invoices       Invoice[]
  tasks          Task[]
  contracts      Contract[]
  bookingVendors BookingVendor[]
  vendorBids     VendorBid[]
  operation            EventOperation?
  timeline             EventTimeline?
  bookingMenu          BookingMenu?
  guestList            GuestList?
  resourceAllocations  ResourceAllocation[]
  inventoryReservations InventoryReservation[]
  shifts               Shift[]
  seatingChart         SeatingChart?
  rentalBookings       RentalBooking[]
  payouts              Payout[]
  insurancePolicies    InsurancePolicy[]
  reviews              Review[]

  // Event Execution & Accountability
  executionPlan        ExecutionPlan?
  referralRewards      ReferralReward[]

  // Invitations & Reminders
  guestInvitations     GuestInvitation[]
  guestReminders       GuestReminder[]
  reminderTemplates    ReminderTemplate[]

  @@unique([venueId, date, timeSlot])
  @@index([date])
  @@index([status])
  @@index([contactId])
  @@index([eventType]) // dashboard groupBy(eventType)
  @@index([status, date]) // active/upcoming filters by status + date range
}

model BlackoutDate {
  id        String    @id @default(cuid())
  date      DateTime  @db.Date
  timeSlot  TimeSlot?
  reason    String?
  createdAt DateTime  @default(now())

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  @@unique([venueId, date, timeSlot])
}

// ============================================================
// TASKS & CHECKLISTS
// ============================================================

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?      @db.Text
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  escalatedAt DateTime?    // overdue task escalated (dedupe)
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  assigneeId String?
  assignee   User?    @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creatorId  String
  creator    User     @relation("TaskCreator", fields: [creatorId], references: [id])
  bookingId  String?
  booking    Booking? @relation(fields: [bookingId], references: [id])
  parentId   String?
  parent     Task?    @relation("SubTasks", fields: [parentId], references: [id])

  subtasks       Task[]          @relation("SubTasks")
  checklistItems ChecklistItem[]

  @@index([status])
  @@index([assigneeId])
  @@index([bookingId])
  @@index([dueDate])
}

model ChecklistItem {
  id          String    @id @default(cuid())
  title       String
  isCompleted Boolean   @default(false)
  order       Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  items       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// INVOICES & PAYMENTS
// ============================================================

model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique
  status          InvoiceStatus @default(DRAFT)
  issueDate       DateTime      @default(now())
  dueDate         DateTime
  subtotal        Decimal       @db.Decimal(12, 2)
  discountPercent Decimal?      @db.Decimal(5, 2)
  discountAmount  Decimal?      @db.Decimal(12, 2)
  cgstRate        Decimal       @db.Decimal(5, 2) @default(9)
  sgstRate        Decimal       @db.Decimal(5, 2) @default(9)
  igstRate        Decimal       @db.Decimal(5, 2) @default(0)
  cgstAmount      Decimal       @db.Decimal(12, 2) @default(0)
  sgstAmount      Decimal       @db.Decimal(12, 2) @default(0)
  igstAmount      Decimal       @db.Decimal(12, 2) @default(0)
  totalAmount     Decimal       @db.Decimal(12, 2)
  paidAmount      Decimal       @db.Decimal(12, 2) @default(0)
  balanceDue      Decimal       @db.Decimal(12, 2)
  notes           String?       @db.Text
  terms           String?       @db.Text
  gstin           String?
  placeOfSupply   String?
  sacCode         String?       @default("996332")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  contactId   String
  contact     Contact  @relation(fields: [contactId], references: [id])
  bookingId   String?
  booking     Booking? @relation(fields: [bookingId], references: [id])
  createdById String
  createdBy   User     @relation("InvoiceCreatedBy", fields: [createdById], references: [id])

  lineItems          InvoiceLineItem[]
  payments           Payment[]
  installments       Installment[]
  convertedFromQuote Quote? @relation("QuoteToInvoice")

  @@index([status])
  @@index([contactId])
  @@index([dueDate])
  @@index([status, dueDate]) // dashboard overdue: status filter + dueDate sort
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)
  sacCode     String?
  order       Int     @default(0)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Installment {
  id      String        @id @default(cuid())
  label   String
  amount  Decimal       @db.Decimal(12, 2)
  dueDate DateTime
  status  PaymentStatus @default(PENDING)
  paidAt  DateTime?
  order   Int           @default(0)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([dueDate])
}

model Payment {
  id                String        @id @default(cuid())
  amount            Decimal       @db.Decimal(12, 2)
  status            PaymentStatus @default(PENDING)
  method            PaymentMethod @default(RAZORPAY)
  transactionId     String?       @unique
  razorpayOrderId   String?
  razorpaySignature String?
  receiptNumber     String?
  notes             String?       @db.Text
  // Customer/staff-supplied proof of payment (a base64 data-URL of a screenshot
  // or an external link). A PENDING payment with a receipt is awaiting staff
  // verification; verifying it marks COMPLETED and auto-confirms the booking.
  receiptUrl        String?       @db.Text
  receiptUploadedAt DateTime?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  @@index([status])
  @@index([invoiceId])
  @@index([status, paidAt]) // dashboard revenue: completed payments by paid date
}

// ============================================================
// NOTIFICATIONS & ACTIVITY
// ============================================================

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String           @db.Text
  isRead    Boolean          @default(false)
  actionUrl String?
  metadata  Json?
  createdAt DateTime         @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model ActivityLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  changes    Json?
  createdAt  DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

// ============================================================
// PHASE 5: PRICING ENGINE & RATE PLANS
// ============================================================

enum PricingRuleType {
  SEASONAL
  DAY_OF_WEEK
  PEAK_HOUR
  EARLY_BIRD
  LAST_MINUTE
}

model PricingRule {
  id          String          @id @default(cuid())
  name        String
  ruleType    PricingRuleType
  multiplier  Decimal         @db.Decimal(5, 3)
  conditions  Json?
  startDate   DateTime?
  endDate     DateTime?
  dayOfWeek   Int?
  minDaysAhead Int?
  isActive    Boolean         @default(true)
  priority    Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  @@index([venueId])
  @@index([isActive])
}

model RatePlan {
  id           String   @id @default(cuid())
  name         String
  description  String?  @db.Text
  baseRate     Decimal  @db.Decimal(12, 2)
  perGuestRate Decimal  @db.Decimal(10, 2)
  isDefault    Boolean  @default(false)
  isActive     Boolean  @default(true)
