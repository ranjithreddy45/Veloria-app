  packageId String
  package   EventPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
}

// ============================================================
// PHASE 5: VENDOR MARKETPLACE
// ============================================================

enum VendorStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
  PENDING_APPROVAL
}

enum VendorCategory {
  CATERING
  DECORATION
  PHOTOGRAPHY
  VIDEOGRAPHY
  ENTERTAINMENT
  FLORIST
  TRANSPORTATION
  LIGHTING
  SOUND
  SECURITY
  CLEANING
  RENTAL
  OTHER
}

enum VendorAssignmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
}

enum VendorBidStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Vendor {
  id            String         @id @default(cuid())
  name          String
  category      VendorCategory
  status        VendorStatus   @default(ACTIVE)
  email         String?
  phone         String?
  company       String?
  address       String?        @db.Text
  gstin         String?
  website       String?
  rating        Int            @default(0)
  totalBookings Int            @default(0)
  tags          String[]
