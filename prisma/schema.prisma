  REVENUE_SHARE
  FIXED_LEASE
  HYBRID
  MANAGEMENT_FEE
}

enum PropertyType {
  BANQUET_HALL
  CONVENTION_CENTER
  MARRIAGE_GARDEN
  MIXED
}

enum OwnershipStatus {
  SELF_OWNED
  LEASED
  FAMILY_PROPERTY
}

