  updatedAt    DateTime @updatedAt

  venueId String?
  venue   Venue?  @relation(fields: [venueId], references: [id])

  @@index([venueId])
}

// ============================================================
// PHASE 5: QUOTATION BUILDER
// ============================================================

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

model Quote {
  id                 String      @id @default(cuid())
  quoteNumber        String      @unique
  title              String
  status             QuoteStatus @default(DRAFT)
  validUntil         DateTime
  subtotal           Decimal     @db.Decimal(12, 2)
  discountPercent    Decimal?    @db.Decimal(5, 2)
  discountAmount     Decimal?    @db.Decimal(12, 2)
  taxRate            Decimal     @db.Decimal(5, 2) @default(18)
  taxAmount          Decimal     @db.Decimal(12, 2) @default(0)
  totalAmount        Decimal     @db.Decimal(12, 2)
  notes              String?     @db.Text
  terms              String?     @db.Text
  coverLetter        String?     @db.Text
  sentAt             DateTime?
  viewedAt           DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  contactId          String
  contact            Contact         @relation(fields: [contactId], references: [id])
  leadId             String?
  lead               Lead?           @relation(fields: [leadId], references: [id])
  packageId          String?
  package            EventPackage?   @relation(fields: [packageId], references: [id])
  createdById        String
  createdBy          User            @relation("QuoteCreatedBy", fields: [createdById], references: [id])
  convertedInvoiceId String?         @unique
  convertedInvoice   Invoice?        @relation("QuoteToInvoice", fields: [convertedInvoiceId], references: [id])

  lineItems QuoteLineItem[]

  @@index([status])
  @@index([contactId])
  @@index([createdAt])
}

model QuoteLineItem {
  id          String  @id @default(cuid())
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)
  category    String?
  order       Int     @default(0)

  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

// ============================================================
// PHASE 5: CONTRACT GENERATION
// ============================================================

enum ContractStatus {
  DRAFT
  SENT
  VIEWED
  SIGNED
  EXPIRED
  CANCELLED
}

model Contract {
  id              String         @id @default(cuid())
  title           String
  status          ContractStatus @default(DRAFT)
  content         String         @db.Text
  sentAt          DateTime?
  signedAt        DateTime?
  expiresAt       DateTime?
  signerName      String?
  signerEmail     String?
  signatureData   String?        @db.Text
  signedViaEsign  Boolean        @default(false)
  notes           String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  templateId  String?
  template    ContractTemplate? @relation(fields: [templateId], references: [id])
  bookingId   String?
  booking     Booking?          @relation(fields: [bookingId], references: [id])
  contactId   String
  contact     Contact           @relation(fields: [contactId], references: [id])
  createdById String
  createdBy   User              @relation("ContractCreatedBy", fields: [createdById], references: [id])

  @@index([status])
  @@index([contactId])
  @@index([bookingId])
}

model ContractTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  content     String   @db.Text
  variables   String[]
  category    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contracts Contract[]
}

// ============================================================
// PHASE 5: EVENT PACKAGES
// ============================================================

enum PackageTier {
  BASIC
  STANDARD
  PREMIUM
  CUSTOM
}

model EventPackage {
  id          String      @id @default(cuid())
  name        String
  description String?     @db.Text
  eventType   String?
  basePrice   Decimal     @db.Decimal(12, 2)
  tier        PackageTier @default(STANDARD)
  isActive    Boolean     @default(true)
  imageUrl    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items  PackageItem[]
  quotes Quote[]
}

model PackageItem {
  id          String  @id @default(cuid())
  name        String
  description String?
  category    String?
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  isIncluded  Boolean @default(true)
  order       Int     @default(0)

  packageId String
  package   EventPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
}

// ============================================================
// PHASE 5: VENDOR MARKETPLACE
// ============================================================

enum VendorStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
  PENDING_APPROVAL
}

enum VendorCategory {
  CATERING
  DECORATION
  PHOTOGRAPHY
  VIDEOGRAPHY
  ENTERTAINMENT
  FLORIST
  TRANSPORTATION
  LIGHTING
  SOUND
  SECURITY
  CLEANING
  RENTAL
  OTHER
}

enum VendorAssignmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
}

enum VendorBidStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Vendor {
  id            String         @id @default(cuid())
  name          String
  category      VendorCategory
  status        VendorStatus   @default(ACTIVE)
  email         String?
  phone         String?
  company       String?
  address       String?        @db.Text
  gstin         String?
  website       String?
  rating        Int            @default(0)
  totalBookings Int            @default(0)
  tags          String[]
  portfolio     Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  bookingVendors BookingVendor[]
  bids           VendorBid[]
  payouts        Payout[]

  // Event Execution & Accountability
  executionTasks        ExecutionTask[]
  performanceScores     PerformanceScore[]   @relation("VendorPerformanceScores")
  badges                Badge[]              @relation("VendorBadges")
  performanceIncentives PerformanceIncentive[] @relation("VendorIncentives")
  referralsMade         Referral[]           @relation("VendorReferrals")

  @@index([category])
  @@index([status])
}

model BookingVendor {
  id         String                 @id @default(cuid())
  role       String?
  agreedRate Decimal?               @db.Decimal(12, 2)
  status     VendorAssignmentStatus @default(PENDING)
  notes      String?                @db.Text
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])
  vendorId  String
  vendor    Vendor  @relation(fields: [vendorId], references: [id])

  operationAssignments OperationVendorAssignment[]

  @@unique([bookingId, vendorId])
  @@index([bookingId])
  @@index([vendorId])
}

model VendorBid {
  id          String          @id @default(cuid())
  amount      Decimal         @db.Decimal(12, 2)
  message     String?         @db.Text
  status      VendorBidStatus @default(PENDING)
  submittedAt DateTime        @default(now())
  respondedAt DateTime?

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])
  vendorId  String
  vendor    Vendor  @relation(fields: [vendorId], references: [id])

  @@index([bookingId])
  @@index([vendorId])
}

// ============================================================
// PHASE 6: EVENT OPERATIONS
// ============================================================

enum OperationStatus {
  PLANNING
  READY
  LIVE
  COMPLETED
}

enum StaffAssignmentStatus {
  ASSIGNED
  CONFIRMED
  CHECKED_IN
}

enum TimelineStatus {
  PLANNED
  LIVE
  COMPLETED
}

enum TimelineItemStatus {
  PENDING
  IN_PROGRESS
  DONE
  SKIPPED
}

enum RSVPStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum GuestCategory {
  VIP
  FAMILY
  FRIEND
  CORPORATE
  OTHER
}

enum WorkflowTrigger {
  EVENT_CREATED
  BOOKING_CONFIRMED
  PAYMENT_DUE
  EVENT_TOMORROW
  POST_EVENT
  LEAD_CREATED
}

enum WorkflowLogStatus {
  SUCCESS
  FAILED
}

// 6.1 Event-OS Operations System

model EventOperation {
  id            String          @id @default(cuid())
  status        OperationStatus @default(PLANNING)
  runOfShow     Json[]
  internalNotes String?         @db.Text
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  bookingId   String  @unique
  booking     Booking @relation(fields: [bookingId], references: [id])
  createdById String
  createdBy   User    @relation("OperationCreatedBy", fields: [createdById], references: [id])

  staffAssignments  StaffAssignment[]
  vendorAssignments OperationVendorAssignment[]

  @@index([status])
}

model StaffAssignment {
  id         String                @id @default(cuid())
  role       String
  shiftStart DateTime
  shiftEnd   DateTime
  notes      String?
  status     StaffAssignmentStatus @default(ASSIGNED)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  operationId String
  operation   EventOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  userId      String
  user        User           @relation("StaffAssignments", fields: [userId], references: [id])

  @@index([operationId])
  @@index([userId])
}

model OperationVendorAssignment {
  id           String   @id @default(cuid())
  arrivalTime  String?
  setupTime    String?
  teardownTime String?
  notes        String?
  createdAt    DateTime @default(now())

  operationId     String
  operation       EventOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  bookingVendorId String
  bookingVendor   BookingVendor  @relation(fields: [bookingVendorId], references: [id])

  @@index([operationId])
}

// 6.2 Event Day Manager

model EventTimeline {
  id        String         @id @default(cuid())
  status    TimelineStatus @default(PLANNED)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id])

  items TimelineItem[]
}

model TimelineItem {
  id          String             @id @default(cuid())
  time        String
  activity    String
  status      TimelineItemStatus @default(PENDING)
  completedAt DateTime?
  notes       String?
  order       Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  timelineId String
  timeline   EventTimeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  assigneeId String?
  assignee   User?         @relation("TimelineAssignee", fields: [assigneeId], references: [id])

  @@index([timelineId])
}

// 6.3 Catering Menu Management

model MenuItem {
  id           String   @id @default(cuid())
  name         String
  description  String?  @db.Text
  category     String
  cuisine      String?
  dietaryTags  String[]
  pricePerHead Decimal  @db.Decimal(12, 2)
  imageUrl     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  menuSelections BookingMenuSelection[]

  @@index([category])
}

model BookingMenu {
  id                  String   @id @default(cuid())
  guestCount          Int
  pricePerHead        Decimal  @db.Decimal(12, 2)
  totalPrice          Decimal  @db.Decimal(12, 2)
  specialInstructions String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id])

  selections BookingMenuSelection[]
}

model BookingMenuSelection {
  id          String   @id @default(cuid())
  quantity    Int      @default(1)
  customPrice Decimal? @db.Decimal(12, 2)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  menuId     String
  menu       BookingMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem    @relation(fields: [menuItemId], references: [id])

  @@unique([menuId, menuItemId])
  @@index([menuId])
}

// 6.4 Guest Management & Check-In

model GuestList {
  id             String   @id @default(cuid())
  totalInvited   Int      @default(0)
  totalRSVP      Int      @default(0)
  totalCheckedIn Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id])

  guests Guest[]
}

model Guest {
  id                  String        @id @default(cuid())
  name                String
  email               String?
  phone               String?
  category            GuestCategory @default(OTHER)
  tableAssignment     String?
  rsvpStatus          RSVPStatus    @default(PENDING)
  isCheckedIn         Boolean       @default(false)
  checkedInAt         DateTime?
  plusOnes            Int           @default(0)
  dietaryRestrictions String?
  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  guestListId String
  guestList   GuestList @relation(fields: [guestListId], references: [id], onDelete: Cascade)

  // Invitation & Reminders
  invitation GuestInvitation?
  reminders  GuestReminder[]

  @@index([guestListId])
  @@index([rsvpStatus])
}

// 6.5 Automated Workflows & Reminders

model Workflow {
  id           String          @id @default(cuid())
  name         String
  trigger      WorkflowTrigger
  actions      Json[]
  isActive     Boolean         @default(true)
  delayMinutes Int?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  logs WorkflowLog[]
}

model WorkflowLog {
  id         String            @id @default(cuid())
  action     String
  status     WorkflowLogStatus
  executedAt DateTime          @default(now())
  error      String?

  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  bookingId  String?
  contactId  String?

  @@index([workflowId])
  @@index([bookingId])
}

// ============================================================
// PHASE 7: RESOURCES, INVENTORY & STAFFING
// ============================================================

enum ResourceType {
  STAFF
  EQUIPMENT
  VEHICLE
  VENUE_ADDON
  OTHER
}

enum ReservationStatus {
  RESERVED
  IN_USE
  RETURNED
  DAMAGED
}

enum ShiftStatus {
  SCHEDULED
  CHECKED_IN
  COMPLETED
  ABSENT
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

enum TableShape {
  ROUND
  RECTANGULAR
  LONG
}

enum RentalBookingStatus {
  RESERVED
  RENTED
  RETURNED
  OVERDUE
}

// 7.1 Resource Allocation

model Resource {
  id          String       @id @default(cuid())
  name        String
  type        ResourceType
  description String?      @db.Text
  isAvailable Boolean      @default(true)
  hourlyRate  Decimal?     @db.Decimal(12, 2)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  allocations ResourceAllocation[]

  @@index([type])
}

model ResourceAllocation {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  startTime String
  endTime   String
  notes     String?
  createdAt DateTime @default(now())

  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id])

  @@unique([resourceId, date, startTime])
  @@index([resourceId])
  @@index([bookingId])
}

// 7.2 Inventory & Stock

model InventoryItem {
  id            String   @id @default(cuid())
  name          String
  sku           String?  @unique
  category      String
  description   String?  @db.Text
  totalQuantity Int
  availableQty  Int
  reorderLevel  Int      @default(5)
  unitCost      Decimal? @db.Decimal(12, 2)
  location      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reservations InventoryReservation[]

  @@index([category])
}

model InventoryReservation {
  id         String            @id @default(cuid())
  quantity   Int
  date       DateTime          @db.Date
  returnDate DateTime?         @db.Date
  status     ReservationStatus @default(RESERVED)
  notes      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id])
  bookingId String
  booking   Booking       @relation(fields: [bookingId], references: [id])

  @@index([itemId])
  @@index([bookingId])
}

// 7.3 Staff Scheduling & Payroll

model StaffProfile {
  id               String   @id @default(cuid())
  department       String?
  designation      String?
  hourlyRate       Decimal? @db.Decimal(12, 2)
  monthlyRate      Decimal? @db.Decimal(12, 2)
  bankDetails      Json?
  emergencyContact Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  userId String @unique
  user   User   @relation("StaffProfileRelation", fields: [userId], references: [id])

  shifts  Shift[]
  payroll PayrollEntry[]
}

model Shift {
  id            String      @id @default(cuid())
  date          DateTime    @db.Date
  startTime     String
  endTime       String
  role          String
  status        ShiftStatus @default(SCHEDULED)
  hoursWorked   Decimal?    @db.Decimal(6, 2)
  overtimeHours Decimal?    @db.Decimal(6, 2)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  staffId   String
  staff     StaffProfile @relation(fields: [staffId], references: [id])
  bookingId String?
  booking   Booking?     @relation(fields: [bookingId], references: [id])

  @@index([staffId])
  @@index([bookingId])
  @@index([date])
}

model PayrollEntry {
  id          String        @id @default(cuid())
  month       String
  basePay     Decimal       @db.Decimal(12, 2)
  overtimePay Decimal       @db.Decimal(12, 2) @default(0)
  deductions  Decimal       @db.Decimal(12, 2) @default(0)
  netPay      Decimal       @db.Decimal(12, 2)
  status      PayrollStatus @default(DRAFT)
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  staffId String
  staff   StaffProfile @relation(fields: [staffId], references: [id])

  @@unique([staffId, month])
  @@index([staffId])
  @@index([month])
}

// 7.4 Seating Chart

model SeatingChart {
  id      String @id @default(cuid())
  name    String
  rows    Int
  columns Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id])

  tables SeatingTable[]
}

model SeatingTable {
  id       String     @id @default(cuid())
  label    String
  gridRow  Int
  gridCol  Int
  capacity Int
  shape    TableShape @default(ROUND)
  notes    String?

  chartId String
  chart   SeatingChart @relation(fields: [chartId], references: [id], onDelete: Cascade)

  guests SeatingGuest[]

  @@index([chartId])
}

model SeatingGuest {
  id         String  @id @default(cuid())
  name       String
  category   String?
  seatNumber Int?
  notes      String?

  tableId String
  table   SeatingTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId])
}

// 7.5 Equipment Rental

model RentalItem {
  id           String   @id @default(cuid())
  name         String
  category     String
  description  String?  @db.Text
  dailyRate    Decimal  @db.Decimal(12, 2)
  weeklyRate   Decimal? @db.Decimal(12, 2)
  quantity     Int
  availableQty Int
  condition    String?
  imageUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rentals RentalBooking[]

  @@index([category])
}

model RentalBooking {
  id          String              @id @default(cuid())
  quantity    Int
  startDate   DateTime            @db.Date
  endDate     DateTime            @db.Date
  dailyRate   Decimal             @db.Decimal(12, 2)
  totalAmount Decimal             @db.Decimal(12, 2)
  status      RentalBookingStatus @default(RESERVED)
