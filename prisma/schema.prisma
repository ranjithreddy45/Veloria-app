model ApprovalRule {
  id          String   @id @default(cuid())
  name        String
  entityType  String   // QUOTE, DEAL, BOOKING
  description String?  @db.Text
  isActive    Boolean  @default(true)
  priority    Int      @default(0)
  conditions  Json     @default("[]") // [{field, operator, value}]
