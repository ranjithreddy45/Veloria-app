  id         String   @id @default(cuid())
  name       String
  category   String // FIELD_BASED, ACTIVITY_BASED, PROFILE_COMPLETENESS, DECAY
  points     Int // positive=add, negative=deduct
  conditions Json     @default("[]") // [{field, operator, value}]
  isActive   Boolean  @default(true)
